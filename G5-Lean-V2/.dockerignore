# Repository-root build context. Keep source, migrations, fixtures and agent assets.
.git
node_modules
**/node_modules
target
**/target
dist
**/dist
__pycache__
**/__pycache__
.codex
.dev
.tmp
.g5-selfhost-smoke
**/g5-selfhost-smoke.*
.g5/hook_state
**/.g5/hook_state
**/test-results
**/test-results-*
**/playwright-report*
**/.auth
**/.fixtures
.terraform
**/.terraform
**/*.tfstate*
**/*.tfplan
**/tfplan
docs/reference
.DS_Store
*.info
*.out
*.err
ci*.log
outputs/ci-logs/
# Local credentials are never build inputs.
.env
.env.*
**/.env
**/.env.*
**/*.env
# Public pinned VMM/kernel versions are build inputs, not credentials.
!infra/guest/versions.env
**/*.pem
**/*.key
**/*.p12
**/*.jks
**/id_rsa*
**/id_ed25519*
**/.netrc
**/.npmrc
.cargo/credentials*
.aws
.gcloud
.config/gcloud
**/*service-account*.json
**/.g5/auth*

# Public JWT fixtures retained for deterministic unit/startup tests.
!scripts/ci/e2e-ci-jwt-private.pem
!scripts/ci/e2e-ci-jwt-public.pem

# Retained local assets are not product bundle inputs.
.g5/local-assets/

# Current-checkout CI migration executable
.ci-migration-artifacts/
