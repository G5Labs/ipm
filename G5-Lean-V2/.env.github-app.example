# Optional local G5 GitHub App for organization GitHub App bindings.
#
# Copy this file to .env.github-app.local, fill in the real values, and keep
# the copy local. `just dev-up` and `just dev-restart-backend` source that file
# after .env. It is ignored by Git; do not place these values in a tracked file.
#
# The binding feature is unavailable (and not advertised as the `github_app`
# instance feature) unless every required value below is present and valid.
#
# Register one GitHub App with:
#   - Setup URL:     http://localhost:3000/api/v1/github-app/setup
#                    (enable "Redirect on update")
#   - Callback URL:  http://localhost:3000/api/v1/github-app/oauth/callback
#   - "Request user authorization (OAuth) during installation": off; G5 starts
#     OAuth itself after the setup redirect.
#   - Repository permissions: Metadata read, Issues read and write.
#   - Webhooks: inactive (not used yet).

G5_GITHUB_APP_ID=1234567
G5_GITHUB_APP_SLUG=your-github-app-slug
G5_GITHUB_APP_OAUTH_CLIENT_ID=Iv23liREPLACE
G5_GITHUB_APP_OAUTH_CALLBACK_URL=http://localhost:3000/api/v1/github-app/oauth/callback
G5_GITHUB_APP_API_BASE_URL=https://api.github.com
G5_GITHUB_APP_WEB_BASE_URL=https://github.com

# Uncomment and replace locally. The state secret signs connection state and
# the PKCE cookie; use at least 32 random bytes, e.g. `openssl rand -hex 32`.
# G5_GITHUB_APP_OAUTH_CLIENT_SECRET=REPLACE_WITH_LOCAL_OAUTH_CLIENT_SECRET
# G5_GITHUB_APP_CONNECTION_STATE_SECRET=REPLACE_WITH_32_OR_MORE_RANDOM_BYTES

# Paste the complete private key as one Bash ANSI-C-quoted value, preserving
# literal \n escapes. This tracked example uses a non-PEM placeholder so secret
# scanners do not treat it as credential material.
# G5_GITHUB_APP_PRIVATE_KEY=$'REPLACE_WITH_LOCAL_GITHUB_APP_KEY'
