# Keep repo-root Cloud Build uploads close to the actual deploy inputs.

# Git and local metadata
.git
.github
.mypy_cache
.devcontainer
.DS_Store
.env
# Codex per-checkout isolated MCP target build + session rollouts (large,
# never a deploy/build input)
.codex
.codex

# Large local build artifacts
target
.playwright-cache
node_modules
**/node_modules

# CI outputs and coverage artifacts
*.info
*.out
*.err
ci*.log
frontend/test-results/

# Terraform local state and plans
infra/terraform/.terraform
infra/terraform/*.tfplan
infra/terraform/*.tfstate
infra/terraform/*.tfstate.*
infra/terraform/tfplan
infra/terraform/*-outputs.json
infra/terraform/.dev-credentials
infra/terraform/bootstrap

# Local-only content not needed for image builds or deploys
.semlift
demo-workspace
prototype
docs/reference/designs
docs/reference/ARCHITECTURE_DISCUSSION.md
tests/e2e/019*

# Local scratch/output directories
outputs
repos
.g5/*
!.g5/workspace.yaml

# All local dependency caches, outputs and credentials remain outside uploads.
**/node_modules
**/target
**/dist
**/__pycache__
.env*
**/.env*
**/*.env
# Public pinned VMM/kernel versions are build inputs, not credentials.
!infra/guest/versions.env
**/*.pem
**/*.key

# Fixed test-only JWT fixture keys used by the CI harness.
!scripts/ci/e2e-ci-jwt-private.pem
!scripts/ci/e2e-ci-jwt-public.pem
