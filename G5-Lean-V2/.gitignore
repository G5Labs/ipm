# Additional workspace exclusions carried forward during relocation.
# .gitignore
# Supplement to the root .gitignore for Rust specifics.

# Explicitly track the sqlx offline query cache (needed for SQLX_OFFLINE=true).
# `cargo sqlx prepare --workspace` regenerates this from a live DB.
!.sqlx/

# Demo workspace (created by `just demo-up` / `scripts/seed-demo.sh`)
demo-workspace/
demo-repos/

# Local seed workspaces staged by seed-*-workspace scripts
.tmp/

# Mock-only UI prototype (isolated copy of frontend/)
client_mock/

# Env files (may contain secrets). Keep examples only.
.env*
!.env.example
!.env.platform-issue.example
!.env.github-app.example

# E2E test workspace env (created by `just test-seed` / `scripts/seed-test-workspace.sh`)
*.out

# CI build log artifacts
*.err
clippy.log

# Playwright outputs
.playwright-cache/
frontend/test-results/
frontend/playwright-report/
frontend/tsconfig.tsbuildinfo
infra/docker/demo-worker.env
# Per-org worker registration env files (seed-dev-worker-token.sh org
# selection) — contain org-scoped registration tokens.
infra/docker/*-worker.env

# E2E runtime artifacts
tests/e2e/[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*-[0-9a-f]*/
tests/e2e/*/*/storage-separation-*.txt

# Terraform
# Plan files (may contain sensitive values in plaintext)
infra/terraform/tfplan
infra/terraform/*.tfplan
**/*.tfplan

# State files (contain all resource attributes including secrets)
*.tfstate
*.tfstate.backup
infra/terraform/bootstrap/bootstrap.tfstate*

# Provider cache
.terraform/
infra/terraform/.terraform/
infra/terraform/bootstrap/.terraform/

# Auto-generated variable overrides (may contain secrets)
*.auto.tfvars
*.auto.tfvars.json
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Crash logs (may contain sensitive provider state)
crash.log
crash.*.log

# Credentials / output files
infra/terraform/*-outputs.json
infra/terraform/.*-credentials
infra/terraform/bootstrap/bootstrap-outputs.json

# Lock file is tracked (intentional) — do NOT ignore .terraform.lock.hcl

# Local worker host state (native g5d host: staged Linux guest runtime,
# per-task workspaces, OCI/rootfs caches, PID + logs) — see g5/g5d/host D16
.dev/

# Retained local assets are not product bundle inputs.
.g5/local-assets/

# Generated worker identity and durable delivery outboxes (local runtime state).
**/.g5/worker_identity.json
/.g5-teardown-ack-outbox.json
/.g5-workspace-reconciliation-receipt-outbox.json

# Current-checkout CI migration executable
.ci-migration-artifacts/

# Optional G5 Local review interface (per-checkout tooling and records).
/.g5/local/
/.agents/skills/g5-local/

# Standalone review UX prototype build
frontend/review-mock-dist/
