# Codex per-repo runtime home — generated by scripts/codex to isolate CODEX_HOME
# per checkout (generated config.toml, auth.json symlink, skills symlink,
# sessions, history, logs). Never commit; it is machine- and path-specific.
/.codex/

# Root-level seed staging scratch used by scripts/seed-g5-workspace.sh.
/.tmp/

# G5 local worker / microVM runtime state (rootfs extracts, caches, task workspaces)
.dev/
/.dev/

# G5 CLI secrets (auth tokens, worker state) — never commit
**/.g5/auth_state.json
**/.g5/cli_worker_state.json
**/.g5/hook_state/
**/.g5/active_tasks/
**/.g5/task_workspaces/
**/.g5/task_commit/
**/.g5/worker-storage/
**/.g5/experience/_index.keywords.json
**/.g5/experience/**/_index*.md

# Agent-local scratch state; keep the maintained instructions, skills and guidance.
IB/working_area/PROFILE_LOG.toml
.agents/*
!.agents/skills
!.agents/optional-skills/
!.agents/AGENTS.md
!.agents/guidance/

