    just docker-build-common-base
    docker build -f infra/docker/Dockerfile.g5-api -t g5/api:dev .

# Build g5d image only
docker-build-g5d *FLAGS:
    just docker-build-common-base
    just docker-build-base {{FLAGS}}
    docker build {{FLAGS}} -f infra/docker/Dockerfile.g5d -t g5/g5d:dev .

# Build the g5d worker base image (host plane: g5/base:26.04 + toolchains)
# FROMs the common base ([D18]), whose tag is local-only ([D5]) — ensure it
# first so a standalone invocation resolves the base ARG. Idempotent.
docker-build-base *FLAGS:
    bash scripts/ensure-base-images.sh base
    docker build {{FLAGS}} -f infra/docker/Dockerfile.g5d-base -t g5/g5d-base:latest .

# Build the single common base + toolchain tiers ONCE, in dependency order
# (integration-stack/docker_images [D18]/[D5]). Every migrated image FROMs these
# tiers, so building them here means the shared OS + perl-free-git + toolchain
# layers are built a single time and reused across api/edge/ci/terraform/oauth
# instead of each image pulling or rebuilding its own base. Idempotent: each
# tier is skipped when its tag already exists locally.
# Leaves before base: a leaf pulled from the mirror by its key needs no parent
# locally, so a workspace guest never downloads base-rust; `base` comes last
# for the leaf images' runtime stages. Lineage is keyed, not layered, so a
# parent from another same-key build never forces a rebuild. (`ci-docker`
# asks for the whole chain parent-first under strict lineage instead, because
# it runs the single-base oracle.)
docker-build-common-base:
    bash scripts/ensure-base-images.sh base-rust-warm base-node base

# Build edge/client image
docker-build-edge:
    just docker-build-common-base
    docker build --build-arg=VITE_G5_ENABLE_CLOUD_WORKSPACE_WORKFLOWS=true -f infra/docker/Dockerfile.edge -t g5/edge:dev .

# ═══════════════════════════════════════════════
# E2E Stack
# ═══════════════════════════════════════════════

# Start full E2E test stack
e2e-up:
    just ci-docker-prepare

# Stop E2E test stack
e2e-down:
    #!/usr/bin/env bash
    set -euo pipefail
    COMPOSE_PROJECT="${G5_CI_COMPOSE_PROJECT:-g5-test}"
    export COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT"
    export POSTGRES_CONTAINER="${COMPOSE_PROJECT}-postgres"
    docker compose -p "$COMPOSE_PROJECT" -f infra/docker/docker-compose.test.yml down -v --remove-orphans 2>/dev/null || true
    for cid in $(docker ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}"); do
      docker rm -f "$cid" >/dev/null 2>&1 || true
    done

# One-time macOS host NFS bootstrap for optional ci-docker parity runs.
ci-docker-nfs-init:
    ./scripts/ci-docker-host-nfs.sh init-host

# Run E2E tests (stack must be running)
e2e-run *ARGS:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    if [[ -f .env.test ]]; then set -a; source .env.test; set +a; fi
    if [[ -z "${G5_E2E_JWT_PRIVATE_KEY:-}" ]]; then
      source scripts/lib/local-stack-secrets.sh
      g5_load_local_stack_secrets
    fi
    source scripts/resolve-e2e-url.sh
    cargo test -p g5-e2e {{ARGS}} -- --test-threads=1

# Run a live E2E slice with stack lifecycle managed in one command.
e2e-live filter="":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    source scripts/lib/local-stack-secrets.sh
    g5_load_local_stack_secrets
    cleanup() {
      just e2e-down >/dev/null 2>&1 || true
    }
    trap cleanup EXIT
    just e2e-up
    if [[ -f .env.test ]]; then set -a; source .env.test; set +a; fi
    source scripts/resolve-e2e-url.sh
    if [[ -n "{{filter}}" ]]; then
      cargo test -p g5-e2e "{{filter}}" -- --test-threads=1
    else
      cargo test -p g5-e2e -- --test-threads=1
    fi

# Verify retained Ontology Uplift validation against a gate-on E2E API process.
e2e-live-repo-hint-gate:
    #!/usr/bin/env bash
    set -euo pipefail
    cleanup() {
      just e2e-down >/dev/null 2>&1 || true
    }
    trap cleanup EXIT
    export G5_REJECT_LEGACY_REPO_HINTS=true
    just e2e-up
    if [[ -f .env.test ]]; then set -a; source .env.test; set +a; fi
    source scripts/resolve-e2e-url.sh
    cargo test -p g5-e2e e2e_ontology_uplift_preserves_validation_with_repo_hint_gate_enabled -- --ignored --test-threads=1

