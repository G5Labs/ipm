seed-compliance-workspace *ARGS:
  bash ./scripts/seed-compliance-workspace.sh {{ARGS}}

# Seed the local gitignored TimSystem fixture using the shared native publish seed path
seed-timsystem-workspace *ARGS:
  bash ./scripts/seed-timsystem-workspace.sh {{ARGS}}

# Seed only the BankWorkflow v4 ontology into an existing workspace
seed-bankworkflow-new-ontology-workspace *ARGS:
  bash ./scripts/seed-bankworkflow-new-ontology-workspace.sh {{ARGS}}

# Seed local committed HEAD with history into an independent Lean workspace (running dev stack)
seed-lean-workspace *ARGS:
  bash ./scripts/seed-lean-workspace.sh {{ARGS}}

# Prepare a local g5_workspace folder in the same docs/code repo shape
prepare-g5-workspace *ARGS:
  bash ./scripts/prepare-g5-workspace.sh {{ARGS}}

# Seed the prepared G5 workspace using the shared native publish seed path
seed-g5-workspace *ARGS:
  bash ./scripts/seed-g5-workspace.sh {{ARGS}}

# ═══════════════════════════════════════════════
# Local Worker Host (Linux/KVM or explicit local process mode)
# ═══════════════════════════════════════════════
# Linux uses Cloud Hypervisor with a staged read-only guest runtime.
# macOS development requires acknowledged process mode; there is no VM fallback.
# One-time bootstrap: platform checks, host g5d build and runtime staging.
worker-host-setup org="":
    #!/usr/bin/env bash
    set -euo pipefail
    # Org comes ONLY from the positional argument (G5_WORKER_ORGS is the sole
    # env knob, consumed by dev-up); export the internal plumbing var and source
    # the env helper NOW so the runtime staging below lands in the org's host
    # dir, not the default one.
    export G5_WORKER_ORG={{quote(org)}}
    source scripts/worker-host-env.sh
    fail() { echo "✗ $*" >&2; exit 1; }
    # Process mode (g5.runtime.boot.backend.process-local) uses no VMM
    # or Docker-staged Linux guest bundle: build the
    # host g5d and stage the host-native runtime directory from this
    # machine's own tools.
    if [[ "$G5D_ISOLATION_MODE" == "process" ]]; then
      command -v cargo >/dev/null || fail "cargo required"
      g5_worker_host_check_state_ownership || fail "a root microvm host's state blocks an unprivileged process host"
      g5_worker_host_build
      g5_worker_host_stage_process_runtime
      echo ""
      echo "✓ worker-host setup complete (process isolation, localhost only). Start the stack with:"
      echo "  G5D_ISOLATION_MODE=process G5D_ALLOW_PROCESS_ISOLATION=1 just dev-up"
      exit 0
    fi
    [[ "$(uname -s)" == Linux && "$(uname -m)" == x86_64 ]] || fail "Cloud Hypervisor requires Linux x86_64/KVM"
    [[ -r /dev/kvm && -w /dev/kvm ]] || fail "Read/write access to /dev/kvm is required"
    command -v cargo >/dev/null || fail "cargo required"
    # A microvm host needs a reflink-capable host directory; inside a workspace
    # VM the preview mounts one (scripts/dev-host-reflink-root.sh).
    g5_worker_host_check_reflink_root || fail "G5_DEV_HOST_DIR=$G5_DEV_HOST_DIR must support reflinks"
    g5_worker_host_build
    g5_worker_host_check_host_vm_exec || fail "Install the platform VMM/kernel/initramfs with scripts/build-cloud-hypervisor-runtime.sh first (a workspace VM's runtime disk supplies it under /opt/g5/platform)"
    # --- Linux guest runtime (Docker-staged) ---
    echo "=== Staging Linux guest runtime ==="
    ./scripts/stage-local-worker-runtime.sh
    # Record the guest-runtime source-hash stamp now that the runtime is freshly
    # staged. Without it, the FIRST `worker-host-start`/`dev-up` sees a missing
    # stamp as false "source drift" (g5_worker_host_ensure_runtime) and restages
    # the whole guest runtime. Mirrors ensure_runtime's own stage-then-stamp on
    # a redeploy.
    source scripts/worker-host-env.sh
    g5_worker_host_write_runtime_source_hash
    echo ""
    echo "✓ worker-host setup complete. Start the stack with: just dev-up (or just demo-up)"

# Run the native worker host in the FOREGROUND (debugging; Ctrl-C to drain).
worker-host org="":
    #!/usr/bin/env bash
    set -euo pipefail
    # The host joins the stack the caller selected (review R29): the identity,
    # the API port included, is resolved like every stack recipe and kept ahead
    # of the dotenv sourced for this recipe's own knobs.
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    g5_restore_stack_identity
    # Org comes ONLY from the positional argument — always override ambient env.
    export G5_WORKER_ORG={{quote(org)}}
    source scripts/worker-host-env.sh
    g5_worker_host_build
    g5_worker_host_prepare_runtime
    g5_worker_host_seed_token "$G5D_API_URL"
    # A Linux microvm host runs as root (passt/VMM identity drops, nft); the
    # helper adds sudo only then and preserves this recipe's environment.
    g5_worker_host_exec_as_root "$G5_WORKER_HOST_G5D" host

# Build the native host binary for the configured isolation mode without
# starting it (dev-up builds it before the containers come up).
worker-host-build org="":
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    g5_restore_stack_identity
    export G5_WORKER_ORG={{quote(org)}}
    # The default instance's directory as this caller selected it, kept
    # before the helper replaces G5_DEV_HOST_DIR with a per-org directory.
    DEFAULT_HOST_DIR_OVERRIDE="${G5_DEV_HOST_DIR:-}"
    source scripts/worker-host-env.sh
    # Instances using this binary path share it across modes. A live host of
    # another mode keeps spawning
    # from it (a microvm host runs `g5d vm-exec` from its own path), so every
    # tracked instance is inspected, whichever one this build is for, and an
    # incompatible live host is stopped, with the instances that share the
    # path, before the build replaces what they would spawn.
    INCOMPATIBLE_LIVE_HOST=""
    for instance_dir in "${DEFAULT_HOST_DIR_OVERRIDE:-${GEN_ROOT}/.dev/g5d-host}" "${GEN_ROOT}/.dev"/g5d-host-*; do
      [[ -f "$instance_dir/host.pid" ]] || continue
      running_command="$(ps -o command= -p "$(cat "$instance_dir/host.pid")" 2>/dev/null || true)"
      case "$running_command" in
        "$G5_WORKER_HOST_G5D host"|"$G5_WORKER_HOST_G5D host "*) ;;
        *) continue ;;
      esac
      running_mode="$(cat "$instance_dir/host.mode" 2>/dev/null || echo unknown)"
      if [[ "$running_mode" != "$G5D_ISOLATION_MODE" ]]; then
        INCOMPATIBLE_LIVE_HOST="${instance_dir##*/} (${running_mode})"
        break
      fi
    done
    if [[ -n "$INCOMPATIBLE_LIVE_HOST" ]]; then
      echo "↻ worker host ${INCOMPATIBLE_LIVE_HOST} is live but config is now '${G5D_ISOLATION_MODE}' — stopping every instance before the shared binary is replaced" >&2
      # The slug-less stop addresses the default instance and sweeps the
      # per-org ones; it must see the caller's default directory, not the
      # per-org directory the helper exported for this build.
      if [[ -n "$DEFAULT_HOST_DIR_OVERRIDE" ]]; then
        G5_DEV_HOST_DIR="$DEFAULT_HOST_DIR_OVERRIDE" just worker-host-stop
      else
        env -u G5_DEV_HOST_DIR just worker-host-stop
      fi
    fi
    g5_worker_host_build

# Start the native worker host in the BACKGROUND (used by dev-up/demo-up).
worker-host-start org="":
    #!/usr/bin/env bash
    set -euo pipefail
    # The host joins the stack the caller selected (review R29): the identity,
    # the API port included, is resolved like every stack recipe and kept ahead
    # of the dotenv sourced for this recipe's own knobs.
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    g5_restore_stack_identity
    # Org comes ONLY from the positional argument — always override ambient env.
    export G5_WORKER_ORG={{quote(org)}}
    source scripts/worker-host-env.sh
    HOST_BINARY_CURRENT=0
    if [[ -f "$G5_WORKER_HOST_PID_FILE" ]] \
       && ps -o command= -p "$(cat "$G5_WORKER_HOST_PID_FILE")" 2>/dev/null | grep -q "g5d host"; then
      HOST_PID="$(cat "$G5_WORKER_HOST_PID_FILE")"
      RUNNING_MODE="$(cat "$G5_WORKER_HOST_MODE_FILE" 2>/dev/null || true)"
      if [[ "$RUNNING_MODE" != "$G5D_ISOLATION_MODE" ]]; then
        # A host from a different isolation mode is live (e.g. a pre-flip
        # microvm-agent supervisor after switching to microvm). Reporting "running"
        # here would leave the OLD mode serving tasks; fall through to reap + relaunch
        # so the flip actually applies (Codex PR review).
        echo "↻ worker host is running in '${RUNNING_MODE:-unknown}' mode but config is now '${G5D_ISOLATION_MODE}' — restarting" >&2
      else
        # A live pid file is not enough: a previous dev-up may have launched a
        # stale host binary that can register but cannot spawn
        # `g5d vm-exec`. Prove the current replacement is good before touching the
        # running host, then compare the recorded launch fingerprint.
        g5_worker_host_build
        HOST_BINARY_CURRENT=1
        if [[ "$G5D_ISOLATION_MODE" == "microvm" ]]; then
          g5_worker_host_check_host_vm_exec
        fi
        CURRENT_FINGERPRINT="$(g5_worker_host_launch_fingerprint)"
        RECORDED_FINGERPRINT="$(cat "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE" 2>/dev/null || true)"
        if [[ -n "$RECORDED_FINGERPRINT" && "$RECORDED_FINGERPRINT" == "$CURRENT_FINGERPRINT" ]]; then
          echo "✓ native worker host already running (pid $HOST_PID, ${G5D_ISOLATION_MODE})"
          exit 0
        fi
        echo "→ native worker host is stale or predates launch fingerprinting — restarting (pid $HOST_PID)" >&2
      fi
      g5_worker_host_kill -TERM "$HOST_PID" 2>/dev/null || true
      for _ in $(seq 1 60); do
        g5_worker_host_alive "$HOST_PID" || break
        sleep 1
      done
      if g5_worker_host_alive "$HOST_PID"; then
        echo "⚠  drain did not finish in 60s — SIGKILL" >&2
        g5_worker_host_kill -KILL "$HOST_PID" 2>/dev/null || true
      fi
      rm -f "$G5_WORKER_HOST_PID_FILE" "$G5_WORKER_HOST_MODE_FILE" "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE"
      g5_worker_host_reap_strays "$HOST_PID"
    fi
    rm -f "$G5_WORKER_HOST_PID_FILE" "$G5_WORKER_HOST_MODE_FILE" "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE"
    # Starting fresh: the recorded host is dead/absent, so any leftover host
    # or VM for THIS repo is an orphan that would contend on the control plane.
    # Reap before launch so exactly one host comes up (prevents the duplicate
    # worker-registration that routes chat turns to a stale/pre-fix host).
    g5_worker_host_reap_strays
    if [[ "$HOST_BINARY_CURRENT" != "1" ]]; then
      g5_worker_host_build
    fi
    g5_worker_host_prepare_runtime
    HOST_LAUNCH_FINGERPRINT="$(g5_worker_host_launch_fingerprint)"
    g5_worker_host_seed_token "$G5D_API_URL"
    # Rotate the log so the registration gate below can only match THIS run —
    # an appended log let a stale "Host registered" line mask an instant crash.
    if [[ -f "$G5_WORKER_HOST_LOG_FILE" ]]; then
      mv "$G5_WORKER_HOST_LOG_FILE" "${G5_WORKER_HOST_LOG_FILE}.1"
    fi
    # The recipe shell exits as soon as the control-plane session connects.
    # Ask the host to ignore SIGHUP so it survives that shell/session closing; do not
    # inherit a terminal controlling session.
    export G5D_HOST_IGNORE_SIGHUP=1
    # The exec helper leaves the host (under sudo on a Linux microvm host,
    # directly otherwise), not a wrapper subshell, at $!; the log is opened by
    # this unprivileged shell, so it stays the caller's file.
    g5_worker_host_exec_as_root "$G5_WORKER_HOST_G5D" host </dev/null >> "$G5_WORKER_HOST_LOG_FILE" 2>&1 &
    LAUNCH_PID=$!
    disown "$LAUNCH_PID" 2>/dev/null || true
    # Under sudo the launch pid is sudo's supervisor; record the host itself
    # so a forced stop cannot orphan it.
    HOST_PID="$(g5_worker_host_resolve_launched_pid "$LAUNCH_PID")"
    echo "$HOST_PID" > "$G5_WORKER_HOST_PID_FILE"
    # Record the mode this host was launched with so a later `worker-host-start`
    # after a config flip restarts instead of falsely reporting the new mode.
    echo "$G5D_ISOLATION_MODE" > "$G5_WORKER_HOST_MODE_FILE"
    # Allow the 600s image-preparation budget plus 60s to start the carrier.
    for _ in $(seq 1 660); do
      if ! g5_worker_host_alive "$HOST_PID"; then
        echo "✗ worker host exited during startup — last log lines:" >&2
        tail -n 25 "$G5_WORKER_HOST_LOG_FILE" >&2 || true
        rm -f "$G5_WORKER_HOST_PID_FILE" "$G5_WORKER_HOST_MODE_FILE" "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE"
        exit 1
      fi
      if grep -q "workspace VM host started" "$G5_WORKER_HOST_LOG_FILE" 2>/dev/null; then
        g5_worker_host_write_launch_fingerprint "$HOST_LAUNCH_FINGERPRINT"
        if [[ "$G5D_ISOLATION_MODE" == "process" ]]; then
          echo "✓ native process-isolation worker host running (pid $HOST_PID, $G5D_HOST_MAX_MICROVMS slot(s); workspaces are unisolated host processes — localhost only)"
        else
          echo "✓ native microVM worker host running (pid $HOST_PID, $G5D_HOST_MAX_MICROVMS VM slots)"
        fi
        echo "  log: $G5_WORKER_HOST_LOG_FILE"
        exit 0
      fi
      sleep 1
    done
    echo "✗ worker host did not register within 660s — killing it; last log lines:" >&2
    tail -n 25 "$G5_WORKER_HOST_LOG_FILE" >&2 || true
    g5_worker_host_kill -TERM "$HOST_PID" 2>/dev/null || true
    sleep 2
    g5_worker_host_kill -KILL "$HOST_PID" 2>/dev/null || true
    rm -f "$G5_WORKER_HOST_PID_FILE" "$G5_WORKER_HOST_MODE_FILE" "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE"
    exit 1

# Stop the native worker host (SIGTERM drain, bounded wait). Idempotent.
worker-host-stop org="":
    #!/usr/bin/env bash
    set -euo pipefail
    # The host joins the stack the caller selected (review R29): the identity,
    # the API port included, is resolved like every stack recipe and kept ahead
    # of the dotenv sourced for this recipe's own knobs.
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    g5_restore_stack_identity
    # Org comes ONLY from the positional argument — always override ambient env.
    export G5_WORKER_ORG={{quote(org)}}
    source scripts/worker-host-env.sh
    # A slug-less stop also sweeps every per-org host instance
    # (.dev/g5d-host-<slug>) so dev-down cannot strand an org host polling a
    # reset control plane whose reseeded org ids no longer match its token.
    # Children re-enter this recipe with the slug set and never sweep, so the
    # recursion is bounded at one level.
    stop_per_org_instances() {
      [[ -n "${G5_WORKER_ORG:-}" ]] && return 0
      local d slug failed=0
      for d in "${GEN_ROOT}/.dev"/g5d-host-*; do
        [[ -d "$d" ]] || continue
        slug="${d##*/g5d-host-}"
        [[ -n "$slug" ]] || continue
        echo "→ stopping per-org worker host '${slug}'"
        # One failing instance must not abort the sweep — attempt every
        # discovered host, then report collected failures (PR #1530 review).
        if ! just worker-host-stop "$slug"; then
          echo "⚠  failed to stop per-org worker host '${slug}' — continuing sweep" >&2
          failed=$((failed + 1))
        fi
      done
      if (( failed > 0 )); then
        echo "⚠  ${failed} per-org worker host(s) failed to stop" >&2
        return 1
      fi
    }
    if [[ ! -f "$G5_WORKER_HOST_PID_FILE" ]]; then
      echo "native worker host not running (no PID file)"
      # The PID file only ever tracked ONE host; orphaned VMs or an extra
      # host from a prior dev-up can still be alive (and still polling the
      # control plane). Reap this repo's strays even with no PID file.
      g5_worker_host_reap_strays
      stop_per_org_instances
      exit 0
    fi
    HOST_PID="$(cat "$G5_WORKER_HOST_PID_FILE")"
    # Never signal a recycled PID: require the command to actually be
    # g5d host, same guard as worker-host-start (codex PR review P2).
    if ! ps -o command= -p "$HOST_PID" 2>/dev/null | grep -q "g5d host"; then
      echo "native worker host not running (stale PID file removed)"
      rm -f "$G5_WORKER_HOST_PID_FILE" "$G5_WORKER_HOST_MODE_FILE" "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE"
      g5_worker_host_reap_strays
      stop_per_org_instances
      exit 0
    fi
    # The process can exit between the liveness check and this signal; a
    # failed TERM must not abort the stop path under set -e (PR #1530 review).
    # A Linux microvm host is root: the signal helper adds sudo when the
    # recorded host belongs to another user, whatever mode is selected now.
    g5_worker_host_kill -TERM "$HOST_PID" 2>/dev/null || true
    for _ in $(seq 1 60); do
      g5_worker_host_alive "$HOST_PID" || break
      sleep 1
    done
    if g5_worker_host_alive "$HOST_PID"; then
      echo "⚠  drain did not finish in 60s — SIGKILL" >&2
      g5_worker_host_kill -KILL "$HOST_PID" 2>/dev/null || true
    fi
    rm -f "$G5_WORKER_HOST_PID_FILE" "$G5_WORKER_HOST_MODE_FILE" "$G5_WORKER_HOST_LAUNCH_FINGERPRINT_FILE"
    # A wedged in-VM task can make the graceful drain time out → the host is
    # SIGKILLed above and its child VMs reparent to init and keep running. Reap
    # them (and any orphan host) so dev-down truly closes this repo's VMs.
    g5_worker_host_reap_strays "$HOST_PID"
    stop_per_org_instances
    echo "✓ native worker host stopped"

