# Run ALL cross-component tests (integration + E2E + smoke + Playwright)
# Requires: just e2e-up  (the full test stack must be running)
test-cross:
    #!/usr/bin/env bash
    set -euo pipefail
    source scripts/resolve-e2e-url.sh
    # Integration tests use sqlx::query! macros not in the .sqlx cache,
    # so they need the live database. Run inside Docker network.
    echo "=== Phase 1: Integration tests (g5-api + g5d cross-crate) ==="
    bash scripts/ensure-base-images.sh base-rust
    docker run --rm \
      -v "$(pwd):/build" \
      -v g5-ci-cargo-registry:/usr/local/cargo/registry \
      -v g5-ci-cargo-git:/usr/local/cargo/git \
      -v g5-ci-target:/build/target \
      -w /build \
      -e SQLX_OFFLINE=false \
      -e DATABASE_URL="postgres://g5:g5_test@postgres:5432/g5_test" \
      --network "${TEST_COMPOSE_PROJECT}_g5-test" \
      g5/base-rust:26.04 \
      sh -c "apt-get update -qq && apt-get install -y -qq pkg-config libssl-dev cmake >/dev/null 2>&1 && \
             cargo test -p g5-api --test '*' -- --test-threads=1 && \
             cargo test -p g5d-dispatch -p g5d --test '*' -- --test-threads=1"
    echo "=== Phase 2: Rust E2E scenarios ==="
    ./scripts/run-rust-e2e-lanes.sh
    echo "=== Phase 3: API smoke tests (Zod schema validation) ==="
    cd frontend && npx vitest run -c vitest.config.smoke.ts && cd ..
    echo "=== Phase 4: Playwright browser E2E ==="
    cd frontend && npx playwright test
    echo "=== All cross-component tests passed ==="

