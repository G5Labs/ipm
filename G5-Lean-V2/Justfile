# G5 Development Task Runner
# Run `just` to see all available recipes.
# Run `just <recipe>` to execute a recipe.

set dotenv-load := false
set shell := ["bash", "-euo", "pipefail", "-c"]

# SQLx offline mode — use cached .sqlx/ query data instead of live database
export SQLX_OFFLINE := "true"

# Requested spelling; retain ci-docker and its arguments for existing callers.
alias docker-ci := ci-docker

# Default: list all recipes
default:
    @just --list

# Verify relocated source, embedded asset, and Docker build paths without starting services.
layout-check:
    python3 scripts/check-layout.py

# Validate every recipe's shell syntax, script entry points and Rust test targets.
commands-check:
    python3 scripts/check-just-commands.py

# ═══════════════════════════════════════════════
# Setup
# ═══════════════════════════════════════════════

# Initialize dev environment (run after container creation)
setup:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Installing client dependencies ==="
    cd frontend && npm ci
    echo "=== Installing Playwright browsers ==="
    if [ -d /opt/ms-playwright ]; then
        # g5d-g5dev guest: only Chromium's system libraries and the pinned
        # Chromium are baked (infra/docker/Dockerfile.g5d-g5dev), so install
        # Chromium alone and run browser tests with --project=chromium there;
        # Firefox/WebKit would download but fail to launch without their
        # libraries. The 1.58 line refuses Ubuntu 26.04 without the same
        # platform override the image build uses; the installer skips a
        # revision already present. --with-deps is omitted because it would
        # re-run apt against a distro map that has no 26.04 entry.
        case "$(uname -m)" in aarch64|arm64) pw_arch=arm64 ;; *) pw_arch=x64 ;; esac
        PLAYWRIGHT_HOST_PLATFORM_OVERRIDE="ubuntu24.04-${pw_arch}" npx playwright install chromium
    else
        npx playwright install --with-deps
    fi
    cd ..
    echo "=== Setup complete ==="

# ═══════════════════════════════════════════════
# Development
# ═══════════════════════════════════════════════

# Start the compose dev stack only (Postgres + g5-api + Edge client)
# and seed the G5 Labs org. No native workspace-VM host: this is the part of
# `dev-up` that can run anywhere docker runs, including inside a workspace
# preview microVM: the `full-stack-no-worker` profile
# (.g5/preview_profiles/full-stack-no-worker.yaml) runs exactly this, and the
# `full-stack` profile runs `dev-up`, whose worker is a process-mode host
# because a microVM has no nested virtualization.
dev-stack-up *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail
    # A stack identity exported by the caller (the preview profile beside the
    # developer's stack) survives every dotenv sourced below (review R22).
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    # Source .env so LLM keys are available to docker compose interpolation
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    # One stack identity for every Compose consumer (ontology
    # g5.runtime.boot.backend.process-local): the project, the container
    # names, the volume names, the image tag and the published ports all
    # follow G5_COMPOSE_PROJECT / G5_COMPOSE_VOLUMES / G5_IMAGE_TAG /
    # G5_PORT_*, so a preview of this stack beside the developer's own stack
    # never reuses or deletes the developer's containers and database.
    export G5_COMPOSE_PROJECT="${G5_COMPOSE_PROJECT:-g5-dev}"
    # The local API admits a process-isolation host only while this developer
    # selected process mode for the host (ontology
    # g5.runtime.boot.backend.process-local): the same two flags that start
    # such a host open the admission, and nothing else sets it. An ambient or
    # dotenv value is never honoured.
    export G5_ALLOW_PROCESS_ISOLATION_HOSTS=false
    if [[ "${G5D_ISOLATION_MODE:-microvm}" == "process" ]]; then
      case "${G5D_ALLOW_PROCESS_ISOLATION:-}" in
        1|true) export G5_ALLOW_PROCESS_ISOLATION_HOSTS=true ;;
      esac
    fi
    # Cache door profile (ontology g5.runtime.cache.door): inside a workspace
    # VM whose host published one, G5_BASE_IMAGE_REGISTRY names the door's
    # pull-through of the tiers delivery already built, so
    # docker-build-common-base pulls them instead of building them here.
    # Explicit values in the environment or .env win over the profile.
    source scripts/lib/dev-cache-profile.sh
    g5_load_dev_cache_profile
    # Optional local-only GitHub App settings for platform issue reporting.
    # Source after .env so its real secret values override any empty examples.
    platform_issue_env_file="${G5_DEV_PLATFORM_ISSUE_ENV_FILE:-.env.platform-issue.local}"
    if [[ -f "$platform_issue_env_file" ]]; then
      set -a; source "$platform_issue_env_file"; set +a
    fi
    # Optional local-only G5 GitHub App settings for organization bindings.
    github_app_env_file="${G5_DEV_GITHUB_APP_ENV_FILE:-.env.github-app.local}"
    if [[ -f "$github_app_env_file" ]]; then
      set -a; source "$github_app_env_file"; set +a
    fi
    g5_restore_stack_identity
    # Inside a full-stack preview the browser reaches this stack from the
    # preview's isolated origin, which g5d exports as G5D_PREVIEW_ORIGIN
    # (ontology g5.workspace.preview-origin-security). The API trusts it for
    # the cookie refresh that org switching uses, beside the Vite default,
    # and names that cookie outside `g5_`, which the preview relay reserves
    # for the platform and never relays.
    if [[ -n "${G5D_PREVIEW_ORIGIN:-}" ]]; then
      export G5_CORS_ALLOWED_ORIGINS="${G5_CORS_ALLOWED_ORIGINS:-http://localhost:5173},${G5D_PREVIEW_ORIGIN}"
      export G5_REFRESH_COOKIE_NAME="${G5_REFRESH_COOKIE_NAME:-preview_refresh}"
    fi
    # G5_DEV_WITHDRAW_EDGE=1 removes a published edge and nothing else, under
    # the same identity, before dev-up stops or replaces what stands behind
    # it. It needs no secrets or image settings, so it runs before they are
    # loaded: a secrets failure must not leave the edge published.
    if [[ "${G5_DEV_WITHDRAW_EDGE:-0}" == "1" ]]; then
      docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml rm -sf edge
      exit 0
    fi
    source scripts/lib/local-stack-secrets.sh
    g5_load_local_stack_secrets
    source scripts/dev-workspace-image-env.sh
    EXTRA=""
    for flag in {{FLAGS}}; do
      case "$flag" in
        --no-cache) EXTRA="--no-cache" ;;
      esac
    done
    # G5_DEV_EDGE_ONLY=1 is the second half of a deferred start (dev-up): the
    # edge alone, under the same identity, overlays and secrets as the first
    # half, with --no-deps so this phase can never recreate the API beneath
    # it with a differently configured environment. Forwarding runs again so
    # a devcontainer gets the UI port it could not forward before.
    if [[ "${G5_DEV_EDGE_ONLY:-0}" == "1" ]]; then
      docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml up -d --no-build --no-deps edge
      # The edge publishes its port the moment it starts; an edge that never
      # becomes healthy must not stay published and hold the port.
      if ! ./scripts/wait-for-healthy.sh infra/docker/docker-compose.dev.yml 90; then
        docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml rm -sf edge || true
        exit 1
      fi
      if [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" || -f /.dockerenv ]]; then
        command -v socat >/dev/null 2>&1 && ./scripts/forward-ports.sh || true
      fi
      echo "Edge published: http://localhost:${G5_PORT_EDGE:-3000}"
      exit 0
    fi
    just docker-build-common-base
    if [[ "${COMPOSE_PARALLEL_LIMIT:-}" == "1" ]]; then
      # One image at a time (a workspace VM sets this above): compose v2 builds
      # the services through BuildKit concurrently otherwise, and the Rust
      # compile plus the vite build would compete for the guest's memory.
      for service in oauth-stub g5-api edge; do
        docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml build $EXTRA "$service"
      done
    else
      docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml build $EXTRA oauth-stub g5-api edge
    fi
    # Startup-only up phase: --no-build keeps the build set owned by the two
    # build commands above. No global --pull never here — the local-only
    # g5/api:dev services already pin pull_policy:never in the compose file,
    # and the image-only infra service (postgres) needs compose's
    # default missing-image pull on fresh daemons (preview VMs) — see D5.
    # --remove-orphans retires containers of services the file no longer
    # defines (the redis container of stacks started before 2026-10-09).
    # G5_DEV_DEFER_EDGE=1 leaves the edge (the published UI port) for the
    # caller to start once a workspace host is attached (dev-up).
    DEV_STACK_SERVICES="postgres oauth-stub g5-api g5-daemon edge"
    if [[ "${G5_DEV_DEFER_EDGE:-0}" == "1" ]]; then
      DEV_STACK_SERVICES="postgres oauth-stub g5-api g5-daemon"
      # A rerun must not keep publishing the previous edge while the API is
      # replaced and the host restarts: remove it now, the caller republishes.
      # An absent edge is fine (rm reports nothing to remove); a removal that
      # fails stops the start here rather than leaving the UI published.
      docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml rm -sf edge
    fi
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml up -d --no-build --remove-orphans $DEV_STACK_SERVICES
    ./scripts/wait-for-healthy.sh infra/docker/docker-compose.dev.yml 90
    # In devcontainers (Docker-outside-of-Docker), container port bindings
    # land on the host, not inside the devcontainer.  Proxy them so VS Code
    # can auto-forward the ports to the user's browser.
    if [[ -n "${REMOTE_CONTAINERS:-}" || -n "${CODESPACES:-}" || -f /.dockerenv ]]; then
      command -v socat >/dev/null 2>&1 && ./scripts/forward-ports.sh || true
    fi
    # Seed the G5 Labs org so the UI is functional out of the box
    SEED_WS_ID=$(./scripts/seed-dev-org.sh auto)
    echo ""
    echo "Dev stack (containers only) ready."
    echo "  App:      http://localhost:${G5_PORT_EDGE:-3000}  (login via OAuth)"
    echo "  API:      http://localhost:${G5_PORT_API:-7500}"

# Tear down the containers of one stack identity and nothing else: the
# counterpart of dev-stack-up, what the `full-stack-no-worker` profile's Close
# runs and the last step of `dev-down` (the `full-stack` profile's Close), so a preview on a process-isolation host never reaches the developer's
# own worker host (ontology g5.runtime.boot.backend.process-local).
dev-stack-down:
    #!/usr/bin/env bash
    set -euo pipefail
    # Teardown addresses the stack startup selected (review R24): the exported
    # identity first, then the identity `.env` names, then the defaults, so a
    # developer stack started from a custom dotenv is the one torn down and a
    # preview's Close keeps its own exports.
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    g5_restore_stack_identity
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml --profile demo down -v --remove-orphans

# Start dev stack (Postgres + g5-api + workspace host + Edge client)
# Reads LLM API keys from .env and forwards them to containers.
# Seeds the G5 Labs org and starts one workspace host. Login via OAuth at :3000.
# "Up" means a workspace can be opened: the host binary is built first, the
# containers come up without the edge, the host starts and registers, and the
# edge (the published UI) is started last, so the port answers only with a
# worker behind it (ontology g5.runtime.boot.backend.process-local; the
# `full-stack` preview profile relies on this).
dev-up *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail
    # .env still feeds this recipe's own knobs (G5_WORKER_ORGS,
    # G5D_HOST_MAX_MICROVMS); the compose stack sources it again itself. An
    # exported stack identity stays ahead of it (review R22/R24).
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    g5_restore_stack_identity
    # Withdraw a previously published UI before anything below can stop its
    # worker (a mode switch stops the old host before the build) or replace
    # its API: the port answers again only once a host is attached.
    G5_DEV_WITHDRAW_EDGE=1 just dev-stack-up
    just worker-host-build
    G5_DEV_DEFER_EDGE=1 just dev-stack-up {{FLAGS}}
    # The recipe derives its org solely from its positional argument
    # (empty ⇒ default org), so ambient env can never redirect the
    # default host; G5_WORKER_ORGS below is the only dev-up knob for
    # extra org hosts.
    just worker-host-start
    # The host log's "started" line precedes its registration: prove through
    # the selected API that the host just started or reused (its id is in the
    # env file worker-host-start wrote) is ready and live before publishing
    # the UI. A host stopped moments ago still reads as live and must not
    # stand in for it.
    STARTED_HOST_ID="$(sed -n 's/^G5D_HOST_ID=//p' infra/docker/demo-worker.env 2>/dev/null | head -1 || true)"
    ./scripts/wait-for-worker-host.sh "${G5_WORKER_HOST_API_URL:-http://localhost:${G5_PORT_API:-7500}}" 120 "${STARTED_HOST_ID}"
    G5_DEV_EDGE_ONLY=1 just dev-stack-up
    # Process isolation (g5.runtime.boot.backend.process-local) is a
    # localhost-only developer choice: G5D_ISOLATION_MODE=process
    # G5D_ALLOW_PROCESS_ISOLATION=1 just dev-up runs workspaces as host
    # processes; the default is unchanged.
    if [[ "${G5D_ISOLATION_MODE:-microvm}" == "process" ]]; then
      WORKER_LINE="native process-isolation host (unisolated host processes, ${G5D_HOST_MAX_MICROVMS:-1} slot)"
    else
      WORKER_LINE="native workspace-VM host (${G5D_HOST_MAX_MICROVMS:-2} VM slots)"
    fi
    # Opt-in per-org host instances (justfile spec D5): G5_WORKER_ORGS
    # lists extra org slugs (comma/space separated, typically set in .env) to
    # start a native host for after the default worker. A slug missing from
    # the current DB generation is skipped with a warning (a fresh
    # `dev-down -v` DB only has the seeded G5 Labs org until others are
    # recreated); secondary start failures warn-and-continue — only the
    # default host start above is fatal to dev-up.
    if [[ -n "${G5_WORKER_ORGS:-}" ]]; then
        # Discovery must fail LOUDLY, never as "org not found": an API/auth
        # outage yielding an empty org list would silently skip every host
        # while dev-up reports ready (PR #1530 review). Bounded fail-on-error
        # curl; on discovery failure skip the whole roster with an explicit
        # message instead of misreporting orgs as absent.
        DISCOVERY_OK=1
        # The roster comes from the selected stack's API, the same address the
        # worker recipes register with (review R33): the dedicated override,
        # otherwise the selected API port.
        DISCOVERY_API_URL="${G5_WORKER_HOST_API_URL:-http://localhost:${G5_PORT_API:-7500}}"
        SLUG_JWT=$(curl -fsS --retry 3 --retry-all-errors --connect-timeout 5 --max-time 30 \
          -X POST "${DISCOVERY_API_URL}/api/v1/auth/test-token" \
          -H 'content-type: application/json' -d '{"email":"demo@g5.dev"}' 2>/dev/null \
          | jq -r '.data.jwt // empty' 2>/dev/null) || DISCOVERY_OK=0
        [[ -n "${SLUG_JWT:-}" ]] || DISCOVERY_OK=0
        AVAILABLE_SLUGS=""
        if [[ "$DISCOVERY_OK" == "1" ]]; then
          AVAILABLE_SLUGS=$(curl -fsS --retry 3 --retry-all-errors --connect-timeout 5 --max-time 30 \
            -H "Authorization: Bearer ${SLUG_JWT}" "${DISCOVERY_API_URL}/api/v1/orgs" 2>/dev/null \
            | jq -r '.data[].orgSlug' 2>/dev/null) || DISCOVERY_OK=0
        fi
        if [[ "$DISCOVERY_OK" != "1" ]]; then
          echo "⚠  org discovery failed (API/auth error) — NOT starting G5_WORKER_ORGS hosts; start manually once the API is reachable: just worker-host-start <org>"
        else
          # The slug-less default host above already serves the seeded default
          # org (g5labs when present, else the first org) — starting a
          # roster host for the same org would double-host it (spec D7:
          # one instance per org identity).
          if grep -qx "g5labs" <<<"$AVAILABLE_SLUGS"; then
            DEFAULT_ORG_SLUG="g5labs"
          else
            DEFAULT_ORG_SLUG=$(head -1 <<<"$AVAILABLE_SLUGS")
          fi
          # read -a splits without pathname expansion (a literal '*' in the
          # list must never glob into filenames — PR #1530 review).
          IFS=', ' read -r -a ORG_ROSTER <<< "${G5_WORKER_ORGS}"
          for slug in "${ORG_ROSTER[@]}"; do
            [[ -n "$slug" ]] || continue
            if [[ ! "$slug" =~ ^[a-z0-9][a-z0-9-]*$ ]]; then
              echo "⚠  invalid org slug '$slug' in G5_WORKER_ORGS — skipping"
              continue
            fi
            if [[ "$slug" == "$DEFAULT_ORG_SLUG" ]]; then
              echo "⚠  org '$slug' is already served by the default worker host — skipping duplicate"
              continue
            fi
            if ! grep -qx "$slug" <<<"$AVAILABLE_SLUGS"; then
              echo "⚠  org '$slug' not in this DB generation — skipping its worker host (recreate the org, then: just worker-host-start $slug)"
              continue
            fi
            echo "→ starting per-org worker host '$slug'"
            if just worker-host-start "$slug"; then
              WORKER_LINE="${WORKER_LINE} + org host '$slug'"
            else
              echo "⚠  per-org worker host '$slug' failed to start — continuing (retry: just worker-host-start $slug)"
            fi
          done
        fi
    fi
    echo ""
    echo "Dev stack ready."
    echo "  App:      http://localhost:${G5_PORT_EDGE:-3000}  (login via OAuth)"
    echo "  API:      http://localhost:${G5_PORT_API:-7500}"
    echo "  Host:     ${WORKER_LINE}"

# Stop dev stack (including workers — native host first, then containers)
dev-down:
    #!/usr/bin/env bash
    set -euo pipefail
    # The stack identity is resolved once by each recipe below, so the host
    # stopped and the containers torn down belong to the same stack.
    just worker-host-stop || echo "⚠  worker host stop reported failures — continuing container teardown"
    just dev-stack-down

# Fully reset and re-seed the dev stack for a fresh manual end-user eval.
eval-end-user-fresh *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail
    just dev-down 2>/dev/null || true
    just dev-up {{FLAGS}}
    echo ""
    echo "Fresh end-user eval stack ready."
    echo "Use a private/incognito browser window (or clear site data for localhost:3000 and localhost:7500)."
    echo "Use a clean managed workspace checkout directory for any local CLI/manual workflow."

# Start dev stack with clean Docker build (no layer cache)
dev-rebuild: (dev-up "--no-cache")

# Start dev stack (alias kept for muscle-memory — same as dev-up)
dev: dev-up

# Rebuild/recreate API services from current Rust source without resetting dev volumes. Supports --no-cache.
dev-restart-backend *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail
    # The restart addresses the stack startup selected: an exported identity
    # stays ahead of every dotenv sourced here (review R24).
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    # Keep backend recreates on the same optional local platform-issue overlay
    # as `dev-up`, including its multiline GitHub App PEM value.
    platform_issue_env_file="${G5_DEV_PLATFORM_ISSUE_ENV_FILE:-.env.platform-issue.local}"
    if [[ -f "$platform_issue_env_file" ]]; then
      set -a; source "$platform_issue_env_file"; set +a
    fi
    # Optional local-only G5 GitHub App settings for organization bindings.
    github_app_env_file="${G5_DEV_GITHUB_APP_ENV_FILE:-.env.github-app.local}"
    if [[ -f "$github_app_env_file" ]]; then
      set -a; source "$github_app_env_file"; set +a
    fi
    g5_restore_stack_identity
    source scripts/lib/local-stack-secrets.sh
    g5_load_local_stack_secrets
    source scripts/dev-workspace-image-env.sh
    EXTRA=""
    for flag in {{FLAGS}}; do
      case "$flag" in
        --no-cache) EXTRA="--no-cache" ;;
        *) echo "Unknown flag for dev-restart-backend: $flag" >&2; exit 2 ;;
      esac
    done
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml up -d --no-build --remove-orphans postgres oauth-stub
    just docker-build-common-base
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml build $EXTRA g5-api
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml run --rm --no-deps db-migrate
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml up -d --no-build --no-deps --force-recreate --remove-orphans g5-api g5-daemon
    ./scripts/wait-for-healthy.sh infra/docker/docker-compose.dev.yml 90
    echo "Backend restarted from rebuilt g5-api image."

# Rebuild/recreate Docker edge from current client source without resetting dev volumes. Supports --no-cache.
dev-restart-frontend *FLAGS:
    #!/usr/bin/env bash
    set -euo pipefail
    # The restart addresses the stack startup selected (review R24).
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    g5_restore_stack_identity
    EXTRA=""
    for flag in {{FLAGS}}; do
      case "$flag" in
        --no-cache) EXTRA="--no-cache" ;;
        *) echo "Unknown flag for dev-restart-frontend: $flag" >&2; exit 2 ;;
      esac
    done
    just docker-build-common-base
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml build $EXTRA edge
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml up -d --no-build --no-deps --force-recreate edge
    ./scripts/wait-for-healthy.sh infra/docker/docker-compose.dev.yml 90
    echo "Frontend edge restarted from rebuilt client image."

# Rebuild/recreate backend and Docker frontend without resetting dev volumes.
dev-restart *FLAGS:
    just dev-restart-backend {{FLAGS}}
    just dev-restart-frontend {{FLAGS}}

