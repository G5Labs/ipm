# ═══════════════════════════════════════════════
# Demo Workspace
# ═══════════════════════════════════════════════

# Start dev stack + seed a self-referential demo workspace for E2E demos
# Everything runs in containers — open http://localhost:3000 when done.
demo-up:
    #!/usr/bin/env bash
    set -euo pipefail
    # Always tear down first for idempotent runs (stale DB data causes 409s)
    echo "=== Cleaning up previous demo (if any) ==="
    just demo-down 2>/dev/null || true
    echo ""
    echo "=== Bringing up dev stack ==="
    just dev-up
    echo ""
    echo "=== Seeding demo workspace ==="
    ./scripts/seed-demo.sh auto "$(pwd)/demo-workspace"
    echo ""
    echo "=== Starting 1 managed Provided-Agent worker ==="
    # Source .env so LLM keys are available to the worker recipes
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    just worker-host-start
    # Process isolation (g5.runtime.boot.backend.process-local) is a
    # localhost-only developer choice: G5D_ISOLATION_MODE=process
    # G5D_ALLOW_PROCESS_ISOLATION=1 just dev-up runs workspaces as host
    # processes; the default is unchanged.
    if [[ "${G5D_ISOLATION_MODE:-microvm}" == "process" ]]; then
      WORKER_LINE="native process-isolation host (unisolated host processes, ${G5D_HOST_MAX_MICROVMS:-1} slot)"
    else
      WORKER_LINE="native workspace-VM host (${G5D_HOST_MAX_MICROVMS:-2} VM slots)"
    fi
    echo ""
    echo "=== Demo ready ==="
    echo "  App:       http://localhost:3000"
    echo "  API:       http://localhost:7500"
    echo "  Host:      ${WORKER_LINE}"
    echo "  Workspace: demo-workspace/"
    echo "  Tear down: just demo-down"

# Alias for demo-up (full reset + seed + workers)
demo-start: demo-up

# Tear down demo workspace + dev stack (native host first, then containers)
demo-down:
    #!/usr/bin/env bash
    set -uo pipefail
    # Same stack selection as dev-down (review R24).
    source scripts/lib/stack-identity.sh
    g5_pin_stack_identity
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    g5_restore_stack_identity
    just worker-host-stop 2>/dev/null || true
    docker compose -p "${G5_COMPOSE_PROJECT:-g5-dev}" -f infra/docker/docker-compose.dev.yml --profile demo down -v --remove-orphans 2>/dev/null || true
    rm -rf demo-workspace demo-repos
    just dev-down 2>/dev/null || true
    echo "Demo workspace removed and dev stack stopped."

# Re-seed demo workspace (dev stack must be running)
demo-seed:
    ./scripts/seed-demo.sh auto "$(pwd)/demo-workspace"

