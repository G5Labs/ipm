# ═══════════════════════════════════════════════
# Full CI (Docker Compose)
# ═══════════════════════════════════════════════

# Run the full CI pipeline: build Docker images → start stack → run all tests → tear down
# Requires: docker compose
#
# start_phase: run this phase and its prerequisites (default: "0" = run everything).
#   Valid values: 0, 0b, 1, 1b, 2, 3, 4, 4a, 4b, 4c, 5, 5b, 5c, 6, 6b, 7
#   Dependencies are resolved automatically — e.g. requesting phase 6
#   will also run phases 0, 3, 4, 4a, 4b, 4c.
#   Shorthand: if this is not a known phase, ci-docker treats it as a
#   targeted Rust/Playwright selector and infers the phase automatically.
# e2e_filter: optional Rust test selector.
#   Phase 5: nextest expression applied to integration tests.
#   Phase 6: cargo test filter applied to Rust E2E tests.
# playwright_filter: optional selector args applied to Phase 7 Chromium
#   Playwright tests, e.g. `e2e/flows/login.spec.ts` or
#   `--grep "Login Flow" e2e/flows/login.spec.ts`.
# reuse_stack: `auto` (default) reuses an already-running seeded stack for
#   targeted Phase 5/6/7 slices, `true` forces reuse, `false` always rebuilds.
[positional-arguments]
ci-docker start_phase="0" live_llm="false" e2e_filter="" playwright_filter="" reuse_stack="auto":
    #!/usr/bin/env bash
    set -euo pipefail
    exec python3 scripts/local_validation.py run "$@"

# Run source-only checks before building images or starting services.
validation-preflight:
    python3 scripts/local_validation.py preflight

# Build and seed a candidate stack, prepare browser dependencies, and retain it.
ci-docker-prepare:
    python3 scripts/local_validation.py prepare

# Remove this worktree's validation services, disposable volumes and image tags.
ci-docker-down:
    python3 scripts/local_validation.py down

# Preview image tags left by deleted worktrees; pass true to remove them.
[positional-arguments]
ci-docker-gc prune="false":
    #!/usr/bin/env bash
    exec python3 scripts/local_validation.py gc "$@"

# Recommend focused checks for committed, staged, unstaged and untracked changes.
[positional-arguments]
validation-recommend base="main":
    #!/usr/bin/env bash
    exec python3 scripts/local_validation.py recommend "$@"

[private]
[positional-arguments]
_ci-docker start_phase="0" live_llm="false" e2e_filter="" playwright_filter="" reuse_stack="auto":
    #!/usr/bin/env bash
    set -euo pipefail

    START_PHASE="$1"
    : "${G5_CI_VALIDATION_MANAGED:?Use just ci-docker to run preflight and acquire the validation lock}"
    # ci-docker intentionally runs deterministic E2E only. Full LLM execution
    # belongs to `test-live-e2e` / `e2e-live`, not blocking Docker CI.
    LIVE_LLM_MODE="$2"
    E2E_FILTER="$3"
    PLAYWRIGHT_FILTER="$4"
    REUSE_STACK_MODE="$5"
    CI_DOCKER_STARTED_AT="$(date +%s)"

    ci_section() {
      printf '\n=== %s ===\n' "$*"
    }

    ci_info() {
      printf '  %s\n' "$*"
    }

    ci_kv() {
      printf '  %-20s %s\n' "$1:" "$2"
    }

    ci_warn() {
      printf 'WARN: %s\n' "$*" >&2
    }

    ci_error() {
      printf 'ERROR: %s\n' "$*" >&2
    }

    format_duration() {
      local seconds="$1"
      printf '%02d:%02d:%02d' "$((seconds / 3600))" "$(((seconds % 3600) / 60))" "$((seconds % 60))"
    }

    is_known_phase() {
      case "$1" in
        0|0b|1|1b|2|3|4|4a|4b|4c|5|5b|5c|6|6b|7) return 0 ;;
        *) return 1 ;;
      esac
    }

    infer_selector_phase() {
      case "$1" in
        *.spec.ts|e2e/*|frontend/e2e/*|--grep*|*--grep*|*playwright*)
          echo "7"
          ;;
        *binary\(*|*package\(*|*kind\(*|*platform\(*|*test\(*|*::*)
          echo "5"
          ;;
        *)
          echo "6"
          ;;
      esac
    }

    apply_selector_shorthand() {
      local selector="$1"
      local target_phase="$2"
      case "$target_phase" in
        5)
          E2E_FILTER="$selector"
          ;;
        6)
          E2E_FILTER="$selector"
          ;;
        7)
          PLAYWRIGHT_FILTER="$selector"
          ;;
        *)
          echo "ERROR: selector shorthand only supports phases 5, 6, and 7 (got '$target_phase')." >&2
          exit 1
          ;;
      esac
      START_PHASE="$target_phase"
      LIVE_LLM_MODE="false"
    }

    normalize_ci_docker_args() {
      if is_known_phase "$START_PHASE"; then
        if [[ -z "$E2E_FILTER" && -z "$PLAYWRIGHT_FILTER" && "$LIVE_LLM_MODE" != "true" && "$LIVE_LLM_MODE" != "false" ]]; then
          case "$START_PHASE" in
            5|6|7)
              ci_section "ci-docker shorthand"
              ci_info "treating second argument as Phase ${START_PHASE} selector"
              apply_selector_shorthand "$LIVE_LLM_MODE" "$START_PHASE"
              ;;
            *)
              ci_error "phase '$START_PHASE' does not support selector shorthand in the second positional argument."
              echo 'Hint: use `just ci-docker 5 false "<nextest expr>"`, `just ci-docker 6 false "<rust filter>"`, or `just ci-docker 7 false "" "<playwright filter>"`.' >&2
              exit 1
              ;;
          esac
        fi
        return
      fi

      if [[ -n "$E2E_FILTER" || -n "$PLAYWRIGHT_FILTER" || "$LIVE_LLM_MODE" != "false" ]]; then
        ci_error "selector shorthand only supports \`just ci-docker <selector>\` when the other positional args are omitted."
        echo 'Hint: use `just ci-docker 5 false "<nextest expr>"`, `just ci-docker 6 false "<rust filter>"`, or `just ci-docker 7 false "" "<playwright filter>"` for the explicit form.' >&2
        exit 1
      fi

      local selector="$START_PHASE"
      local inferred_phase
      inferred_phase="$(infer_selector_phase "$selector")"
      ci_section "ci-docker shorthand"
      ci_info "inferred Phase ${inferred_phase} for selector '$selector'"
      apply_selector_shorthand "$selector" "$inferred_phase"
    }

    normalize_ci_docker_args
    if [[ "$LIVE_LLM_MODE" == "true" ]]; then
      ci_error "ci-docker does not run live-LLM/full execution tests. Use 'just test-live-e2e' or 'just e2e-live' instead."
      exit 1
    fi

    # ── Phase dependency graph & resolution ──
    # Each phase declares its direct dependencies.  When a specific phase
    # is requested, we compute the transitive closure and run only those
    # phases.  Phase "0" (the default) means "run everything".
    #
    # Dependency map (direct prerequisites):
    #   0:  (none)          0b: 0
    #   1:  0               1b: 0
    #   2:  (none)          3:  (none)
    #   4:  3               4a: 4
    #   4b: 4a              4c: 4b
    #   5:  0 4a            5b: 0
    #   5c: 1 5             6:  0 4b 4c
    #   6b: 4               7:  4c
    phase_deps() {
      case "$1" in
        0)  echo ""        ;; 0b) echo "0"       ;;
        1)  echo "0"       ;; 1b) echo "0"       ;;
        2)  echo ""        ;; 3)  echo ""        ;;
        4)  echo "3"       ;; 4a) echo "4"       ;;
        4b) echo "4a"      ;; 4c) echo "4b"      ;;
        5)  echo "0 4a"    ;; 5b) echo "0"       ;;
        5c) echo "1 5"     ;; 6)  echo "0 4b 4c" ;;
        6b) echo "4"       ;; 7)  echo "4c"       ;;
        *)  echo "ERROR: unknown phase '$1'" >&2; exit 1 ;;
      esac
    }

    ALL_PHASES="0 0b 1 1b 2 3 4 4a 4b 4c 5 5b 5c 6 6b 7"
    # Space-delimited set of phases to run (bash 3.x compatible — no assoc arrays).
    _RUN_PHASES=" "

    _has_phase() { [[ "$_RUN_PHASES" == *" $1 "* ]]; }

    resolve_deps() {
      local phase="$1"
      _has_phase "$phase" && return
      _RUN_PHASES="${_RUN_PHASES}${phase} "
      local dep
      for dep in $(phase_deps "$phase"); do
        resolve_deps "$dep"
      done
    }

    if [[ "$START_PHASE" == "0" ]]; then
      # Default: run every phase
      for p in $ALL_PHASES; do _RUN_PHASES="${_RUN_PHASES}${p} "; done
    else
      resolve_deps "$START_PHASE"
    fi

    should_run() {
      _has_phase "$1"
    }

    remove_phase() {
      local phase="$1"
      _RUN_PHASES="${_RUN_PHASES// $phase / }"
    }

    resolved_phase_list() {
      local resolved=""
      local p
      for p in $ALL_PHASES; do
        if _has_phase "$p"; then
          if [[ -z "$resolved" ]]; then
            resolved="$p"
          else
            resolved="$resolved $p"
          fi
        fi
      done
      printf '%s' "$resolved"
    }

    print_ci_docker_plan() {
      local resolved
      resolved="$(resolved_phase_list)"
      ci_section "ci-docker run plan"
      ci_kv "requested phase" "$START_PHASE"
      ci_kv "resolved phases" "$resolved"
      ci_kv "reuse stack" "$REUSE_STACK_MODE"
      ci_kv "repo volume" "$REPOS_VOLUME_BACKEND"
      ci_kv "target volume" "$CI_TARGET_VOLUME"
      ci_kv "coverage" "$CI_DOCKER_COVERAGE_LABEL"
      ci_kv "log dir" "$CI_DOCKER_LOG_DIR"
      if [[ -n "$E2E_FILTER" ]]; then
        ci_kv "rust filter" "$E2E_FILTER"
      fi
      if [[ -n "$PLAYWRIGHT_FILTER" ]]; then
        ci_kv "playwright filter" "$PLAYWRIGHT_FILTER"
      fi
      return 0
    }

    # Source .env for LLM API keys (if present)
    if [[ -f .env ]]; then
      set -a; source .env; set +a
    fi
    source scripts/lib/local-stack-secrets.sh
    g5_load_local_stack_secrets

    COMPOSE_FILE="infra/docker/docker-compose.test.yml"
    COMPOSE_PROJECT="${G5_CI_COMPOSE_PROJECT:?}"
    export COMPOSE_PROJECT_NAME="$COMPOSE_PROJECT"
    export POSTGRES_CONTAINER="${COMPOSE_PROJECT}-postgres"
    export API_CONTAINER="${COMPOSE_PROJECT}-api"
    export G5_TEST_API_IMAGE="${COMPOSE_PROJECT}/api:test"
    REPOS_VOLUME="${COMPOSE_PROJECT}_repos_data"
    REPOS_VOLUME_BACKEND="${G5_CI_DOCKER_REPOS_BACKEND:-local}"
    CI_TARGET_VOLUME="${G5_CI_TARGET_VOLUME:-g5-ci-target}"
    CI_DOCKER_COVERAGE_MODE="${G5_CI_DOCKER_COVERAGE:-false}"
    case "$CI_DOCKER_COVERAGE_MODE" in
      true|1|yes|on)
        CI_DOCKER_COVERAGE_ENABLED=1
        CI_DOCKER_COVERAGE_LABEL="enabled"
        ;;
      false|0|no|off)
        CI_DOCKER_COVERAGE_ENABLED=0
        CI_DOCKER_COVERAGE_LABEL="disabled"
        ;;
      *)
        ci_warn "unknown G5_CI_DOCKER_COVERAGE='$CI_DOCKER_COVERAGE_MODE' — disabling coverage for local ci-docker"
        CI_DOCKER_COVERAGE_ENABLED=0
        CI_DOCKER_COVERAGE_LABEL="disabled"
        ;;
    esac
    # docker-compose.test.yml defines a `g5-test` network key under the
    # `g5-test` compose project. Docker Compose materializes that as the
    # concrete network name `g5-test_g5-test`.
    COMPOSE_NETWORK="${COMPOSE_PROJECT}_g5-test"
    CI_IMAGE="${G5_CI_IMAGE:-g5-ci-runner}"
    # The source mount and cache volumes follow Dockerfile.ci-builder's
    # workspace and baked dependency paths. Every phase uses these variables.
    CI_CONTAINER_WORKSPACE="/workspace"
    CI_CONTAINER_CARGO_HOME="/opt/g5-cargo-home"
    CI_CONTAINER_TARGET="/opt/g5-rust-target-cache/target"
    CI_CACHE_LAYOUT_VERSION="ci-builder-lean-paths-v3"
    CI_CACHE_LAYOUT_MARKER=".g5-local-cache-layout"
    CI_DOCKER_LOG_DIR="${G5_CI_DOCKER_LOG_DIR:-outputs/ci-logs}"

    existing_published_port() {
      local container_name="$1"
      local container_port="$2"
      docker port "$container_name" "${container_port}/tcp" 2>/dev/null | awk -F: 'NR==1 {print $NF}'
    }

    choose_free_host_port() {
      local preferred="$1"
      local python_bin=""
      if command -v python3 >/dev/null 2>&1; then
        python_bin="python3"
      elif command -v python >/dev/null 2>&1; then
        python_bin="python"
      else
        echo "ERROR: python3 or python is required to resolve a free ci-docker host port" >&2
        exit 1
      fi

      "$python_bin" -c $'import socket\nimport sys\n\n\ndef bind_candidate(port):\n    sock = socket.socket(socket.AF_INET, socket.SOCK_STREAM)\n    try:\n        sock.bind(("0.0.0.0", port))\n        return sock.getsockname()[1]\n    finally:\n        sock.close()\n\n\npreferred = int(sys.argv[1])\ntry:\n    print(bind_candidate(preferred))\nexcept OSError:\n    print(bind_candidate(0))\n' "$preferred"
    }

    hash_stdin() {
      local python_bin=""
      if command -v python3 >/dev/null 2>&1; then
        python_bin="python3"
      elif command -v python >/dev/null 2>&1; then
        python_bin="python"
      else
        echo "ERROR: python3 or python is required to hash ci-docker cache stamps" >&2
        exit 1
      fi

      "$python_bin" -c 'import hashlib, sys; print(hashlib.sha256(sys.stdin.buffer.read()).hexdigest())'
    }

    pick_ci_host_port() {
      local env_name="$1"
      local preferred="$2"
      local selected="${!env_name:-}"
      if [[ -z "$selected" ]]; then
        selected="$(choose_free_host_port "$preferred")"
      fi
      printf -v "$env_name" '%s' "$selected"
      export "$env_name"
    }

    # Use distinct host ports so the test stack doesn't conflict with a
    # running dev stack (which defaults to 5433/6381/7500/3000). If the
    # preferred test ports are already occupied, pick free replacements.
    select_ci_host_ports() {
      pick_ci_host_port G5_TEST_PORT_POSTGRES 5434
      pick_ci_host_port G5_TEST_PORT_API 7501
      pick_ci_host_port G5_TEST_PORT_EDGE 3001
      CI_HOST_API_URL="http://localhost:${G5_TEST_PORT_API}"
      echo "Selected ci-docker host ports: postgres=${G5_TEST_PORT_POSTGRES} api=${G5_TEST_PORT_API} edge=${G5_TEST_PORT_EDGE}"
    }

    refresh_ci_host_ports_from_running_stack() {
      local postgres_port api_port edge_port
      postgres_port="$(existing_published_port "${COMPOSE_PROJECT}-postgres" 5432)"
      api_port="$(existing_published_port "${COMPOSE_PROJECT}-api" 7500)"
      edge_port="$(existing_published_port "${COMPOSE_PROJECT}-client" 80)"

      [[ -n "$postgres_port" ]] && export G5_TEST_PORT_POSTGRES="$postgres_port"
      [[ -n "$api_port" ]] && export G5_TEST_PORT_API="$api_port"
      [[ -n "$edge_port" ]] && export G5_TEST_PORT_EDGE="$edge_port"

      CI_HOST_API_URL="http://localhost:${G5_TEST_PORT_API}"
      export G5_TEST_PORT_POSTGRES G5_TEST_PORT_API G5_TEST_PORT_EDGE
      ci_section "ci-docker host ports"
      ci_kv "postgres" "$G5_TEST_PORT_POSTGRES"
      ci_kv "api" "$G5_TEST_PORT_API"
      ci_kv "edge" "$G5_TEST_PORT_EDGE"
    }

    # ── Host path resolution for devcontainer environments ──
    # When running inside a devcontainer (Docker-outside-of-Docker),
    # $(pwd) returns a container-internal path that the Docker daemon
    # on the host cannot mount.  Resolve to the host-side equivalent.
    resolve_host_path() {
      local container_path="$1"
      # Detect devcontainer: /.dockerenv exists AND /proc/1/mountinfo has
      # a /workspaces bind mount.  This works under sudo (env vars like
      # REMOTE_CONTAINERS are stripped by sudo).
      if [[ ! -f /.dockerenv ]]; then
        echo "$container_path"
        return
      fi
      # Parse /proc/1/mountinfo for the workspace bind mount.
      # Format: ... <root> <mount_point> ... - <fstype> <source> ...
      local ws_root="/workspaces/g5"
      local mount_line
      mount_line=$(awk -v mp="$ws_root" '$5 == mp { print; exit }' /proc/1/mountinfo 2>/dev/null || true)
      if [[ -z "$mount_line" ]]; then
        echo "$container_path"
        return
      fi
      # Extract the mount source prefix and sub-path
      local mount_source sub_path
      mount_source=$(echo "$mount_line" | awk '{for(i=1;i<=NF;i++){if($i=="-"){print $(i+2); exit}}}')
      sub_path=$(echo "$mount_line" | awk '{print $4}')
      # mount_source is e.g. /run/host_mark/Users, sub_path is e.g. /lumost/workspace/g5
      # The actual host path is the basename of mount_source + sub_path
      local host_prefix
      host_prefix="/$(basename "$mount_source")"  # e.g. /Users
      local host_ws="${host_prefix}${sub_path}"    # e.g. /Users/lumost/workspace/g5
      # Replace the workspace root prefix with the host equivalent
      echo "${container_path/#$ws_root/$host_ws}"
    }

    HOST_SRC="$(resolve_host_path "$(pwd)")"
    ci_section "ci-docker workspace"
    ci_kv "container path" "$(pwd)"
    ci_kv "host mount" "$HOST_SRC"
    if [[ ! -d "$HOST_SRC/tests/fixtures/security" ]]; then
      ci_error "expected tests/fixtures/security in the repository for route auth static tests"
      exit 1
    fi

    # Remove orphaned containers only when Compose labels prove ownership.
    _force_remove_project_containers() {
      local stale
      stale="$(docker ps -aq --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}" 2>/dev/null || true)"
      if [[ -n "$stale" ]]; then
        ci_info "removing stale containers: $stale"
        docker rm -f $stale 2>/dev/null || true
      fi
    }

    dump_ci_docker_diagnostics() {
      local status="$1"
      local ts outdir
      ts="$(date +%Y%m%d%H%M%S)"
      outdir="$CI_DOCKER_LOG_DIR"
      mkdir -p "$outdir" 2>/dev/null || true

      ci_section "ci-docker failure diagnostics"
      ci_kv "exit code" "$status"
      ci_kv "compose logs" "${outdir}/ci-docker-${ts}-compose.log"
      ci_kv "container ps" "${outdir}/ci-docker-${ts}-ps.txt"

      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=400 --no-color \
        >"${outdir}/ci-docker-${ts}-compose.log" 2>&1 || true
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" ps -a \
        >"${outdir}/ci-docker-${ts}-ps.txt" 2>&1 || true
      docker ps -a --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}" \
        --format 'table {{"{{"}}.Names{{"}}"}}\t{{"{{"}}.Status{{"}}"}}\t{{"{{"}}.Image{{"}}"}}' \
        >>"${outdir}/ci-docker-${ts}-ps.txt" 2>&1 || true
    }

    cleanup() {
      local status="${1:-$?}"
      if [[ "$status" -ne 0 ]]; then
        dump_ci_docker_diagnostics "$status"
      fi
      ci_section "ci-docker cleanup"
      if [[ "${G5_CI_KEEP_STACK:-on-failure}" == "always" || ( "$status" -ne 0 && "${G5_CI_KEEP_STACK:-on-failure}" == "on-failure" ) ]]; then
        ci_info "retaining project ${COMPOSE_PROJECT}; stop it with just ci-docker-down"
        return "$status"
      fi
      python3 scripts/local_validation.py invalidate-stack
      ci_info "tearing down test stack"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" down -v --remove-orphans 2>/dev/null || true
      cleanup_named_test_containers
      _force_remove_project_containers
      cleanup_repos_volume
      return "$status"
    }

    cleanup_named_test_containers() {
      # Labels are the ownership boundary; never remove a sibling project's containers.
      _force_remove_project_containers
    }

    container_ip() {
      docker inspect "$1" 2>/dev/null | jq -r '.[0].NetworkSettings.Networks[]?.IPAddress' | head -n1
    }

    list_g5d_host_containers() {
      docker ps --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}" --filter "label=com.docker.compose.service=g5d-host" --format "{{"{{"}}.Names{{"}}"}}"
    }

    refresh_ci_e2e_urls() {
      # Use stable compose service/container hostnames on the shared network
      # instead of raw container IPs. Docker's embedded DNS resolves these
      # consistently across the ephemeral test-runner containers, and it avoids
      # failures when a specific service inspect shape omits an IP temporarily.
      CI_E2E_API_URL="http://g5-api:7500"
      CI_E2E_CLIENT_URL="http://client"
      # Phase 7 browser auth must stay on the same origin that the API uses
      # for OAuth callback redirects, otherwise the saved cookie/localStorage
      # state is captured for one origin and the browser tests later navigate
      # to another. That origin is the edge's HTTPS alias (compose `client`),
      # so previews run on isolated https://<task>.preview.g5-e2e.test/ hosts;
      # Chromium maps that wildcard to the edge (Docker DNS cannot).
      CI_E2E_BROWSER_URL="https://app.g5-e2e.test"
      CI_E2E_PREVIEW_HOST_RESOLVER="MAP *.preview.g5-e2e.test client"
      # Use the compose service alias here as well. Standalone `docker run`
      # containers attached to the compose network reliably resolve service
      # names, while the explicit container name is not guaranteed to be
      # present in embedded DNS.
      CI_E2E_OAUTH_URL="http://oauth-stub:9876"
      CI_E2E_DATABASE_URL="postgres://g5:g5_test@postgres:5432/g5_test"

      export CI_E2E_API_URL CI_E2E_CLIENT_URL CI_E2E_BROWSER_URL CI_E2E_PREVIEW_HOST_RESOLVER CI_E2E_OAUTH_URL CI_E2E_DATABASE_URL
      echo "Resolved CI E2E URLs: API=$CI_E2E_API_URL Client=$CI_E2E_CLIENT_URL Browser=$CI_E2E_BROWSER_URL OAuth=$CI_E2E_OAUTH_URL DB=$CI_E2E_DATABASE_URL"
    }

    prepare_playwright_image() {
    PLAYWRIGHT_RUNNER_IMAGE="${G5_CI_PLAYWRIGHT_IMAGE:-${COMPOSE_PROJECT}-playwright:ci}"
    if [[ "${CI_STACK_REUSED:-0}" == "1" ]]; then
      docker image inspect "$PLAYWRIGHT_RUNNER_IMAGE" >/dev/null
      return 0
    fi
    docker build \
      --label "io.g5.validation.worktree=${G5_LOCAL_VALIDATION_WORKTREE:-}" \
      --label "io.g5.validation.project=${G5_CI_COMPOSE_PROJECT:-}" \
      --build-arg "PLAYWRIGHT_BASE_IMAGE=${G5_CI_PLAYWRIGHT_BASE_IMAGE:-mcr.microsoft.com/playwright:v1.58.2-noble@sha256:6446946a1d9fd62d9ae501312a2d76a43ee688542b21622056a372959b65d63d}" \
      -f infra/docker/Dockerfile.playwright-runner \
      -t "$PLAYWRIGHT_RUNNER_IMAGE" .

    }

    use_host_nfs_repos_volume() {
      case "$REPOS_VOLUME_BACKEND" in
        host-nfs)
          return 0
          ;;
        local)
          return 1
          ;;
        auto|"")
          return 1
          ;;
        *)
          echo "WARN: unknown G5_CI_DOCKER_REPOS_BACKEND='$REPOS_VOLUME_BACKEND' — falling back to local"
          return 1
          ;;
      esac
    }

    prepare_repos_volume() {
      if use_host_nfs_repos_volume; then
        echo "=== Preparing host-backed NFS repos volume (${REPOS_VOLUME}) ==="
        ./scripts/ci-docker-host-nfs.sh prepare-volume "$REPOS_VOLUME"
        return
      fi

      docker volume rm "$REPOS_VOLUME" >/dev/null 2>&1 || true
    }

    finish_ci_docker_success() {
      local elapsed
      elapsed="$(($(date +%s) - CI_DOCKER_STARTED_AT))"
      ci_section "ci-docker complete"
      ci_kv "elapsed" "$(format_duration "$elapsed")"
      ci_kv "log dir" "$CI_DOCKER_LOG_DIR"
    }

    cleanup_repos_volume() {
      if use_host_nfs_repos_volume; then
        ./scripts/ci-docker-host-nfs.sh cleanup-volume "$REPOS_VOLUME" >/dev/null 2>&1 || true
        return
      fi

      docker volume rm "$REPOS_VOLUME" >/dev/null 2>&1 || true
    }

    should_attempt_stack_reuse() {
      case "$REUSE_STACK_MODE" in
        true|1|yes|always)
          return 0
          ;;
        false|0|no|never)
          return 1
          ;;
        auto|"")
          case "$START_PHASE" in
            5) [[ -n "$E2E_FILTER" ]] ;;
            6) [[ -n "$E2E_FILTER" ]] ;;
            7) [[ -n "$PLAYWRIGHT_FILTER" ]] ;;
            *) return 1 ;;
          esac
          ;;
        *)
          echo "WARN: unknown reuse_stack mode '$REUSE_STACK_MODE' — falling back to auto"
          case "$START_PHASE" in
            5) [[ -n "$E2E_FILTER" ]] ;;
            6) [[ -n "$E2E_FILTER" ]] ;;
            7) [[ -n "$PLAYWRIGHT_FILTER" ]] ;;
            *) return 1 ;;
          esac
          ;;
      esac
    }

    load_seeded_fixture_env() {
      # seed-test-workspace.sh owns the fixture identities. Keep its complete
      # environment instead of guessing a repo among several main branches.
      [[ -f .env.test ]] || return 1
      set -a
      source .env.test
      set +a
      : "${G5_E2E_TEST_WORKSPACE_ID:?seeded workspace is missing}"
      : "${G5_E2E_TEST_REPO_ID:?seeded repository is missing}"
      : "${G5_E2E_TEST_ORG_ID:?seeded organization is missing}"
      export G5D_ORG_ID="$G5_E2E_TEST_ORG_ID"
      echo "    loaded fixture env: org=${G5_E2E_TEST_ORG_ID} workspace=${G5_E2E_TEST_WORKSPACE_ID}"
    }

    running_stack_is_ready() {
      ./scripts/wait-for-healthy.sh "$COMPOSE_FILE" 5 "$COMPOSE_PROJECT" >/dev/null 2>&1 || return 1

      case "$START_PHASE" in
        5)
          true
          ;;
        6)
          docker ps --filter "label=com.docker.compose.project=${COMPOSE_PROJECT}" --filter "label=com.docker.compose.service=g5d-host" --format "{{"{{"}}.Names{{"}}"}}" 2>/dev/null | grep -q .
          ;;
        7)
          true
          ;;
      esac
    }

    activate_stack_reuse() {
      ci_section "ci-docker stack reuse"
      ci_info "reusing running test stack for targeted Phase ${START_PHASE} slice"
      ci_info "fast path: skipping image rebuild and reseed; use reuse_stack=false for a fresh stack"
      refresh_ci_host_ports_from_running_stack
      refresh_ci_e2e_urls
      if [[ "$START_PHASE" == "5" ]]; then
        CI_STACK_REUSED=1
        remove_phase 0; remove_phase 3; remove_phase 4; remove_phase 4a
        return 0
      fi
      load_seeded_fixture_env || return 1
      CI_STACK_REUSED=1
      remove_phase 0
      remove_phase 3
      remove_phase 4
      remove_phase 4a
      remove_phase 4b
      remove_phase 4c
    }

    if should_attempt_stack_reuse; then
      if python3 scripts/local_validation.py check-stack "$START_PHASE" && running_stack_is_ready && activate_stack_reuse; then
        :
      elif [[ "$REUSE_STACK_MODE" == "true" || "$REUSE_STACK_MODE" == "1" || "$REUSE_STACK_MODE" == "yes" || "$REUSE_STACK_MODE" == "always" ]]; then
        ci_error "reuse_stack requested, but the ci-docker stack is not healthy/seeded."
        echo "Hint: run 'just ci-docker-prepare' first, or rerun with reuse_stack=false."
        exit 1
      else
        ci_section "ci-docker stack setup"
        ci_info "running fresh stack setup (reuse conditions not met)"
      fi
    fi

    print_ci_docker_plan
    # Only set the cleanup trap and pre-cleanup when Phase 4 (start stack)
    # will run — otherwise we'd tear down a stack we didn't start.
    if should_run 4; then
      trap cleanup EXIT

      python3 scripts/local_validation.py invalidate-stack
      # Pre-cleanup: tear down any stale stack from a previous run that
      # wasn't cleaned up properly (e.g. killed CI, trap didn't fire).
      ci_section "ci-docker pre-cleanup"
      ci_info "removing stale containers"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" down -v --remove-orphans 2>/dev/null || true
      cleanup_named_test_containers
      _force_remove_project_containers
      prepare_repos_volume
    else
      if [[ "${CI_STACK_REUSED:-0}" == "1" ]]; then
        # An explicitly prepared stack stays warm across successful reruns too.
        if [[ "${G5_CI_KEEP_STACK:-on-failure}" != "never" ]]; then G5_CI_KEEP_STACK=always; fi
        trap 'cleanup "$?"' EXIT
      else
        trap 'status=$?; if [[ "$status" -ne 0 ]]; then dump_ci_docker_diagnostics "$status"; fi' EXIT
      fi
    fi

    ci_section "G5 Docker CI"

    # Pinned third-party downloads (operations
    # g5.quality.delivery.pinned-third-party-tools, G5Labs/G5-Lean#527): no
    # recipe or privileged install script pipes a download into a shell or
    # archive extractor. Runs once, before Phase 0 builds the CI image or any
    # phase prepares a base tier, so a piped download can never execute
    # before the guard reports it; scripts/test_verify_pinned_downloads.py
    # covers the guard itself.
    bash scripts/verify-pinned-downloads.sh

    # Phase 0: Build a lightweight CI image (cached)
    # Uses infra/docker/Dockerfile.ci-builder — single source of truth shared with Cloud Build
    prepare_ci_image() {
      # Dockerfile.ci-builder is FROM g5/base-rust-warm:26.04 (integration-stack/
      # docker_images [D20]); ensure the chain parent-first (idempotent, [D5]) so
      # the CI image layers onto the same base every other migrated image uses
      # and the Phase 3 single-base oracle holds for it (a leaf pulled without
      # its parents is keyed, not layered).
      G5_BASE_IMAGE_STRICT_LINEAGE=1 bash scripts/ensure-base-images.sh base base-rust base-rust-warm
      # Reuse only when every Dockerfile COPY input, ignore file, parent image
      # identity and local warmup option matches. The Dockerfile owns the input
      # inventory; adding a tool manifest or build.rs cannot bypass this key.
      CI_IMAGE_INPUTS_SHA="$(python3 scripts/local_validation.py builder-key "$CI_DOCKER_COVERAGE_ENABLED" "${G5_CI_DOCKER_RELEASE_WARMUP:-0}")"
      CI_IMAGE_PREV_INPUTS_SHA=""
      if docker image inspect "$CI_IMAGE" >/dev/null 2>&1; then
        CI_IMAGE_PREV_INPUTS_SHA="$(docker image inspect "$CI_IMAGE" 2>/dev/null | jq -r '.[0].Config.Labels["g5.ci.inputs_sha"] // ""' 2>/dev/null || true)"
      fi
      if [[ "${G5_CI_REBUILD_IMAGE:-0}" != "1" && -n "$CI_IMAGE_PREV_INPUTS_SHA" && "$CI_IMAGE_PREV_INPUTS_SHA" == "$CI_IMAGE_INPUTS_SHA" ]]; then
        echo "CI image up to date (inputs unchanged) — reusing $CI_IMAGE (set G5_CI_REBUILD_IMAGE=1 to force a rebuild)"
      else
        echo "CI image inputs changed or image missing — building $CI_IMAGE"
        docker build --label "g5.ci.inputs_sha=${CI_IMAGE_INPUTS_SHA}" --build-arg "G5_CI_BUILDER_COVERAGE=${CI_DOCKER_COVERAGE_ENABLED}" --build-arg "G5_CI_BUILDER_RELEASE_WARMUP=${G5_CI_DOCKER_RELEASE_WARMUP:-0}" -t "$CI_IMAGE" -f infra/docker/Dockerfile.ci-builder .
      fi

      # Detect if the CI image changed without treating every warm-layer change
      # as a reason to cold-compile Rust again. The OCI index digest (`.Id`) can
      # change across cached rebuilds even when the unpacked image content is
      # identical, and the RootFS layer list changes whenever Dockerfile warm
      # layers churn. Cargo can invalidate source/dependency artifacts itself;
      # the named target volume only needs to be cleared when the build
      # environment changes (toolchain, cargo subcommands, system-library paths).
      CI_IMAGE_ID="$(docker image inspect "$CI_IMAGE" --format '{{"{{"}}.Id{{"}}"}}' 2>/dev/null || echo unknown)"
      CI_IMAGE_CONTENT_FINGERPRINT="$(
        docker image inspect "$CI_IMAGE" 2>/dev/null \
          | jq -rc '
              .[0]
              | "content-v2|" + ({
                  rootfs: (.RootFS.Layers // []),
                  env: (.Config.Env // []),
                  cmd: (.Config.Cmd // []),
                  workdir: (.Config.WorkingDir // ""),
                  arch: (.Architecture // ""),
                  os: (.Os // "")
                } | tostring)
            ' \
          | hash_stdin \
          || echo unknown
      )"
      CI_IMAGE_BUILD_ENV_RAW="$(
        docker run --rm "$CI_IMAGE" sh -lc '
          set +e
          printf "build-env-v1\n"
          rustc -Vv
          cargo -V
          cargo nextest --version
          cargo llvm-cov --version
          printf "G5_CI_BUILDER_COVERAGE=%s\n" "${G5_CI_BUILDER_COVERAGE:-}"
          cargo deny --version
          sqlx --version
          printf "PKG_CONFIG_PATH=%s\n" "${PKG_CONFIG_PATH:-}"
          printf "LIBRARY_PATH=%s\n" "${LIBRARY_PATH:-}"
          printf "LD_LIBRARY_PATH=%s\n" "${LD_LIBRARY_PATH:-}"
          printf "CARGO_HOME=%s\n" "${CARGO_HOME:-}"
          printf "CARGO_TARGET_DIR=%s\n" "${CARGO_TARGET_DIR:-}"
        ' 2>/dev/null || true
      )"
      if [[ -n "$CI_IMAGE_BUILD_ENV_RAW" ]]; then
        CI_IMAGE_BUILD_ENV_FINGERPRINT="$(printf '%s' "$CI_IMAGE_BUILD_ENV_RAW" | hash_stdin)"
      else
        CI_IMAGE_BUILD_ENV_FINGERPRINT="unknown"
      fi

      CI_IMAGE_STAMP_KEY="$(printf '%s\n%s\n' "$CI_IMAGE" "$CI_TARGET_VOLUME" | hash_stdin)"
      CI_IMAGE_CONTENT_STAMP_FILE="/tmp/.g5-ci-image-content-stamp-${CI_IMAGE_STAMP_KEY}"
      CI_IMAGE_BUILD_ENV_STAMP_FILE="/tmp/.g5-ci-image-build-env-stamp-${CI_IMAGE_STAMP_KEY}"
      CI_IMAGE_BUILD_ENV_CHANGED="false"

      if [[ -f "$CI_IMAGE_BUILD_ENV_STAMP_FILE" ]]; then
        PREV_BUILD_ENV_STAMP="$(cat "$CI_IMAGE_BUILD_ENV_STAMP_FILE")"
        if [[ "$CI_IMAGE_BUILD_ENV_FINGERPRINT" != "$PREV_BUILD_ENV_STAMP" ]]; then
          if [[ "$CI_IMAGE_BUILD_ENV_FINGERPRINT" == "unknown" ]]; then
            echo "CI image build environment fingerprint unavailable — preserving target cache"
          else
            echo "CI image build environment changed — clearing stale target cache"
            docker volume rm "$CI_TARGET_VOLUME" 2>/dev/null || true
            CI_IMAGE_BUILD_ENV_CHANGED="true"
          fi
        fi
      else
        echo "CI image build environment stamp initialized — preserving target cache"
      fi
      if [[ "$CI_IMAGE_BUILD_ENV_FINGERPRINT" != "unknown" ]]; then
        echo "$CI_IMAGE_BUILD_ENV_FINGERPRINT" > "$CI_IMAGE_BUILD_ENV_STAMP_FILE"
      fi

      if [[ -f "$CI_IMAGE_CONTENT_STAMP_FILE" ]]; then
        PREV_CONTENT_STAMP="$(cat "$CI_IMAGE_CONTENT_STAMP_FILE")"
        if [[ "$CI_IMAGE_CONTENT_FINGERPRINT" != "$PREV_CONTENT_STAMP" ]]; then
          if [[ "$CI_IMAGE_BUILD_ENV_CHANGED" == "true" ]]; then
            echo "CI image content changed with build environment change"
          else
            echo "CI image content changed; build environment stable — preserving target cache"
          fi
        fi
      elif [[ -f /tmp/.g5-ci-image-stamp ]]; then
        echo "CI image stamp upgraded — preserving target cache"
      fi
      if [[ "$CI_IMAGE_CONTENT_FINGERPRINT" == "unknown" ]]; then
        echo "$CI_IMAGE_ID" > "$CI_IMAGE_CONTENT_STAMP_FILE"
      else
        echo "$CI_IMAGE_CONTENT_FINGERPRINT" > "$CI_IMAGE_CONTENT_STAMP_FILE"
      fi
    }

    prepare_local_ci_cache_layout() {
      local current_layout=""
      if docker volume inspect "$CI_TARGET_VOLUME" >/dev/null 2>&1; then
        current_layout="$(
          docker run --rm \
            -v "${CI_TARGET_VOLUME}:/cache:ro" \
            -e G5_CI_LOCAL_CACHE_MARKER="$CI_CACHE_LAYOUT_MARKER" \
            "$CI_IMAGE" \
            sh -c 'cat "/cache/${G5_CI_LOCAL_CACHE_MARKER}" 2>/dev/null || true'
        )"
        if [[ "$current_layout" != "$CI_CACHE_LAYOUT_VERSION" ]]; then
          echo "CI target cache layout changed — replacing stale volume"
          docker volume rm "$CI_TARGET_VOLUME"
        fi
      fi

      # Mounting a new volume over the image's populated target path copies the
      # baked dependency baseline into the volume before this marker is written.
      # -e CARGO_TARGET_DIR is REQUIRED: the ci-builder image overrides its
      # inherited env to the cloud-canonical /opt/g5-rust-target-cache path, so
      # writing through the image env would miss the volume mounted at
      # $CI_CONTAINER_TARGET and every next run would judge the cache stale.
      docker run --rm \
        -v "${CI_TARGET_VOLUME}:${CI_CONTAINER_TARGET}" \
        -e CARGO_TARGET_DIR="$CI_CONTAINER_TARGET" \
        -e G5_CI_LOCAL_CACHE_LAYOUT="$CI_CACHE_LAYOUT_VERSION" \
        -e G5_CI_LOCAL_CACHE_MARKER="$CI_CACHE_LAYOUT_MARKER" \
        "$CI_IMAGE" \
        sh -c 'printf "%s\n" "$G5_CI_LOCAL_CACHE_LAYOUT" > "${CARGO_TARGET_DIR}/${G5_CI_LOCAL_CACHE_MARKER}"'
    }

    if should_run 0; then
    echo "=== Phase 0: Preparing CI image ==="
    prepare_ci_image
    elif should_run 6; then
    # Targeted Phase 6 reuse intentionally skips Phase 0; lazily ensure the
    # shared CI runner image exists so we can mount the live workspace onto
    # the compose network instead of rebuilding a source-copying test image.
    if docker image inspect "$CI_IMAGE" >/dev/null 2>&1; then
      echo "=== Phase 6 prerequisite: reusing existing CI image ==="
    else
      echo "=== Phase 6 prerequisite: preparing missing CI image ==="
      prepare_ci_image
    fi
    fi  # Phase 0 / Phase 6 prerequisite

    if should_run 0 || should_run 0b || should_run 1 || should_run 1b || \
       should_run 5 || should_run 5b || should_run 5c || should_run 6; then
      prepare_local_ci_cache_layout
    fi

    # CI_RUN: volume-mounts the host source so tests see real files.
    # A named volume caches the cargo registry + target dir between CI runs.
    # CARGO_BUILD_JOBS=2 limits compiler parallelism to prevent OOM in Docker.
    # g5-api is the heaviest crate — it gets -j1 to avoid dual-linker OOM.
    # Conditionally pass --device /dev/kvm so microvm integration tests can
    # execute real VMs when the host has KVM support (GitHub runners do).
    KVM_FLAG=""
    SCCACHE_VOL=""
    SCCACHE_ENV=""
    CI_VOLS=""
    CI_ENV_BASE=""
    CI_RUN=":"
    CI_RUN_LOW=":"
    if should_run 0 || should_run 0b || should_run 1 || should_run 1b || should_run 5 || should_run 5b || should_run 5c || should_run 6; then
      if [[ -r /dev/kvm ]]; then
        KVM_FLAG="--device /dev/kvm"
        echo "KVM detected — microvm tests will execute real VMs"
      else
        echo "KVM not available — microvm tests will skip at runtime"
      fi

      # ── sccache flags ──
      # Local `just ci-docker` runs execute cargo inside short-lived `docker run`
      # containers. Keep the compiled object cache on a shared volume, but pin
      # the sccache control socket inside each container's `/tmp` so ephemeral
      # runs do not inherit stale daemon state from previous containers.
      # sccache is ON by default for the gate phases so they reuse the dependency
      # objects baked into base-rust-warm's /opt/g5-sccache (now incl. dev-deps
      # via the `--all-targets --all-features` cook) — a cold target volume no
      # longer rebuilds the whole dependency graph. Safe by construction: sccache
      # is content-addressed, so a source change changes the key and forces a
      # recompile — it cannot mask a source-shape change
      # (integration-stack/docker_images#D14: build-cache is an acceleration
      # contract, never a correctness one). The former opt-out cited "stale
      # rmeta", but that is the reused target-dir VOLUME's cargo fingerprints —
      # orthogonal to (content-addressed) sccache and present with or without it.
      # Force off with G5_CI_USE_SCCACHE=false.
      SCCACHE_MODE="${G5_CI_USE_SCCACHE:-true}"
      if docker run --rm "$CI_IMAGE" which sccache >/dev/null 2>&1; then
        if [[ "$SCCACHE_MODE" == "false" || "$SCCACHE_MODE" == "0" || "$SCCACHE_MODE" == "off" ]]; then
          echo "sccache: disabled for this ci-docker run (G5_CI_USE_SCCACHE=$SCCACHE_MODE)"
          SCCACHE_ENV="-e RUSTC_WRAPPER="
        else
          # Point at the warm baked cache inherited from base-rust-warm so gate
          # compiles hit the cooked dependency objects; per-container /tmp socket
          # so ephemeral runs don't inherit stale daemon state.
          echo "sccache: enabled → warm /opt/g5-sccache (set G5_CI_USE_SCCACHE=false to disable)"
          SCCACHE_ENV="-e RUSTC_WRAPPER=sccache -e SCCACHE_DIR=/opt/g5-sccache -e SCCACHE_SERVER_UDS=/tmp/sccache.sock -e SCCACHE_IGNORE_SERVER_IO_ERROR=1"
          if [[ -n "${SCCACHE_GCS_BUCKET:-}" ]]; then
            SCCACHE_ENV="$SCCACHE_ENV -e SCCACHE_GCS_BUCKET=${SCCACHE_GCS_BUCKET}"
            SCCACHE_ENV="$SCCACHE_ENV -e SCCACHE_GCS_RW_MODE=${SCCACHE_GCS_RW_MODE:-READ_WRITE}"
            [[ -n "${SCCACHE_GCS_KEY_PREFIX:-}" ]] && SCCACHE_ENV="$SCCACHE_ENV -e SCCACHE_GCS_KEY_PREFIX=${SCCACHE_GCS_KEY_PREFIX}"
            [[ -n "${GOOGLE_APPLICATION_CREDENTIALS:-}" ]] && SCCACHE_ENV="$SCCACHE_ENV -e GOOGLE_APPLICATION_CREDENTIALS=/gcp/sa.json -v ${GOOGLE_APPLICATION_CREDENTIALS}:/gcp/sa.json:ro"
            echo "sccache: GCS backend → ${SCCACHE_GCS_BUCKET} (per-container socket)"
          else
            echo "sccache: local volume via per-container socket (set SCCACHE_GCS_BUCKET in .env for cloud cache)"
          fi
        fi
      else
        echo "sccache: not found in CI image — skipping (rebuild image to enable)"
      fi

      # One root mount includes crates, shipped profiles, fixtures, .github,
      # scripts and tools at the same relative paths used on the host.
      if should_run 0b || should_run 6; then
        for gh_asset in \
          "$HOST_SRC/.github/workflows/self-hosted-install.yml" \
          "$HOST_SRC/.github/actions/setup-just/action.yml"; do
          if [[ ! -f "$gh_asset" ]]; then
            ci_error "ci-docker Phase 0b/6 require repo-root .github asset '$gh_asset' for the g5-e2e supply-chain guard"
            exit 1
          fi
        done
      fi
      CI_VOLS="-v $HOST_SRC:$CI_CONTAINER_WORKSPACE -v g5-ci-cargo-registry:$CI_CONTAINER_CARGO_HOME/registry -v g5-ci-cargo-git:$CI_CONTAINER_CARGO_HOME/git -v ${CI_TARGET_VOLUME}:$CI_CONTAINER_TARGET $SCCACHE_VOL"
      CI_ENV_BASE="$SCCACHE_ENV -e SQLX_OFFLINE=true -e CARGO_HOME=$CI_CONTAINER_CARGO_HOME -e CARGO_TARGET_DIR=$CI_CONTAINER_TARGET -e CARGO_INCREMENTAL=${CARGO_INCREMENTAL:-0}"
      # Default cargo job count to the runner's core count. Was hardcoded 2 (a
      # small-container OOM guard); CI/build hosts have ample RAM and on 8-32
      # core Cloud Build runners jobs=2 wasted most cores. Override with
      # G5_CI_CARGO_JOBS on a memory-starved runner. jobs is not part of the
      # sccache key, so this does not affect cross-context cache hits. The
      # heaviest-link phases still drop to CI_RUN_LOW (jobs=1) explicitly.
      # `nproc` is GNU coreutils and is absent on a stock macOS host, where
      # ci-docker is a supported parity lane (see ci-docker-nfs-init); fall back
      # to the BSD equivalent rather than aborting under `set -e`.
      CI_CARGO_JOBS="${G5_CI_CARGO_JOBS:-$(nproc 2>/dev/null || sysctl -n hw.ncpu)}"
      CI_RUN="docker run --rm --init --cgroupns=host -v /sys/fs/cgroup:/sys/fs/cgroup:ro $KVM_FLAG $CI_VOLS -w $CI_CONTAINER_WORKSPACE $CI_ENV_BASE -e CARGO_BUILD_JOBS=${CI_CARGO_JOBS} $CI_IMAGE"
      CI_RUN_LOW="docker run --rm --init --cgroupns=host -v /sys/fs/cgroup:/sys/fs/cgroup:ro $KVM_FLAG $CI_VOLS -w $CI_CONTAINER_WORKSPACE $CI_ENV_BASE -e CARGO_BUILD_JOBS=1 $CI_IMAGE"
      G5D_CI_FEATURES="${G5_CI_G5D_FEATURES:-test-helpers,microvm-e2e}"
      echo "g5d ci features: ${G5D_CI_FEATURES} (set G5_CI_G5D_FEATURES to override)"
    fi

    # Phase 0b: Format check + Clippy lint + frontend lint + Dependency audit
    if should_run 0b; then
    echo "=== Phase 0b: fmt + clippy + frontend lint + npm audit + guards + deny ==="
    python3 scripts/run-ci-script-tests.py
    $CI_RUN cargo fmt --all -- --check
    $CI_RUN_LOW cargo clippy --workspace --all-targets -- -D warnings
    $CI_RUN cargo test -p g5-api-routes --lib "guards::tests"
    # Plain Node task (eslint + npm audit), so it runs on the shared Node tier rather than a
    # separate `node:22-alpine` external base ([D18]). base-node is already
    # built for the other phases, so the marginal cost here is zero layers,
    # whereas alpine is a whole extra image to pull. Phase 0b does not depend on
    # Phase 3, so ensure the tier here — idempotent ([D5]).
    bash scripts/ensure-base-images.sh base-node
    # npm audit is the client-side counterpart of `cargo deny check` below: it
    # reads package-lock.json against the GitHub Advisory Database and fails on
    # high/critical findings in shipped (non-dev) dependencies. It runs in the
    # same container as lint so the `npm ci` tree is reused.
    docker run --rm \
      -v "$HOST_SRC/frontend:/app" \
      -v /app/node_modules \
      -w /app \
      g5/base-node:26.04 \
      sh -c "npm ci --ignore-scripts && npm run lint && npm audit --omit=dev --audit-level=high" || {
      echo "FAIL: Phase 0b — client lint or npm audit failed"
      exit 1
    }
    $CI_RUN cargo deny check
    fi  # Phase 0b

    # Phase 1: Unit + bin + doc tests (offline, no live DB needed)
    # g5d uses an explicit CI-safe feature set instead of --all-features:
    # workspace-integration is a hard reflink/XFS assertion and should only be
    # opt-in on local ci-docker hosts that provide a reflink-capable temp root.
    # The shared crates and g5-api still use --all-features.
    # The CI image supplies the pinned Cloud Hypervisor platform binaries.
    # In CI, /dev/kvm is passed through when available so microvm tests can
    # execute real VMs; tests needing hardware/keys skip gracefully at runtime.
    # Build crates sequentially to avoid OOM from parallel linker invocations.
    # The E2E crate is excluded here — it runs in Phase 6 against the live stack.
    if should_run 1; then
    if [[ "$CI_DOCKER_COVERAGE_ENABLED" == "1" ]]; then
      echo "=== Phase 1: Unit, bin & doc tests (with coverage) ==="
    else
      echo "=== Phase 1: Unit, bin & doc tests (coverage disabled) ==="
    fi
    # The real dispatcher process suite needs no DB and gates Phase 1.
    # Other integration tests in tests/ run later against the Phase 5 stack.
    # Nextest flags (-j, --no-fail-fast) go before the "--" separator.
    # Use --no-report to accumulate profdata; merged LCOV reports are generated
    # in Phase 5c after integration tests add their profdata too.
    #
    # Clear the instrumented coverage target, not just profraw/profdata. The
    # shared ci-docker target volume can retain stale rmeta after branch-shape
    # changes; correctness is more important than reusing those artifacts.
    if [[ "$CI_DOCKER_COVERAGE_ENABLED" == "1" ]]; then
      $CI_RUN sh -c "rm -rf target/llvm-cov-target; find target -name '*.profraw' -delete 2>/dev/null; find target -name '*.profdata' -delete 2>/dev/null" || true
      $CI_RUN sh -c "cargo llvm-cov nextest --no-report -p g5-contracts -p g5-auth -p g5-authz -p g5-storage -p g5-semantic -p g5-scm -p g5-internal-api -p fake-provider-cli --lib --bins --all-features -j2 --no-fail-fast"
      $CI_RUN_LOW sh -c "cargo llvm-cov nextest --no-report -p g5-api-foundation -p g5-api-data -p g5-api-core -p g5-api-routes -p g5-api --lib --bins --all-features -j1 --no-fail-fast"
      $CI_RUN_LOW sh -c "cargo llvm-cov nextest --no-report -p g5d-foundation -p g5d-isolation -p g5d-agent -p g5d-host -p g5d-dispatch --lib --bins --all-features -j1 --no-fail-fast"
      $CI_RUN_LOW sh -c "cargo llvm-cov nextest --no-report -p g5d --lib --bins --test dispatch --features ${G5D_CI_FEATURES} -j1 --no-fail-fast"
    else
      $CI_RUN sh -c "cargo nextest run -p g5-contracts -p g5-auth -p g5-authz -p g5-storage -p g5-semantic -p g5-scm -p g5-internal-api -p fake-provider-cli --lib --bins --all-features -j2 --no-fail-fast"
      $CI_RUN_LOW sh -c "cargo nextest run -p g5-api-foundation -p g5-api-data -p g5-api-core -p g5-api-routes -p g5-api --lib --bins --all-features -j1 --no-fail-fast"
      $CI_RUN_LOW sh -c "cargo nextest run -p g5d-foundation -p g5d-isolation -p g5d-agent -p g5d-host -p g5d-dispatch --lib --bins --all-features -j1 --no-fail-fast"
      $CI_RUN_LOW sh -c "cargo nextest run -p g5d --lib --bins --test dispatch --features ${G5D_CI_FEATURES} -j1 --no-fail-fast"
    fi
    $CI_RUN cargo test -j2 -p g5-contracts -p g5-auth -p g5-authz -p g5-storage -p g5-semantic -p g5-scm -p g5-internal-api -p fake-provider-cli --all-features --doc
    $CI_RUN_LOW cargo test -j1 -p g5-api-foundation -p g5-api-data -p g5-api-core -p g5-api-routes -p g5-api --all-features --doc -- --test-threads=1
    $CI_RUN_LOW cargo test -j1 -p g5d-foundation -p g5d-isolation -p g5d-agent -p g5d-host -p g5d-dispatch --all-features --doc -- --test-threads=1
    $CI_RUN sh -c "cargo test -j2 -p g5d --features ${G5D_CI_FEATURES} --doc"
    fi  # Phase 1

    # Phase 1b: Isolation backend tests (offline, no live DB needed)
    # Runs the full isolation_backends integration test suite.  Process backend
    # tests execute real child processes. The strict Cloud Hypervisor gate
    # separately owns real KVM boots with explicit platform/OCI fixtures.
    # Separated from Phase 1 to make isolation coverage visible in CI output when enabled.
    if should_run 1b; then
    echo "=== Phase 1b: Isolation backend tests ==="
    if [[ "$CI_DOCKER_COVERAGE_ENABLED" == "1" ]]; then
      ISOLATION_NEXTEST="cargo llvm-cov nextest --no-report"
    else
      ISOLATION_NEXTEST="cargo nextest run"
    fi
    $CI_RUN sh -c "$ISOLATION_NEXTEST -p g5d --test isolation_backends --features ${G5D_CI_FEATURES} -j2 --no-fail-fast" || {
      echo "FAIL: Phase 1b — isolation backend tests had failures"
      exit 1
    }
    # Also run the in-crate isolation unit tests explicitly (config, serde,
    # error paths, IsolationManager delegation, probe fallback logic).
    $CI_RUN sh -c "$ISOLATION_NEXTEST -p g5d-isolation --lib --all-features -j2 --no-fail-fast" || {
      echo "FAIL: Phase 1b — isolation unit tests had failures"
      exit 1
    }
    fi  # Phase 1b

    # Phase 2: Client unit + contract tests (offline, no stack needed)
    # Runs inside the Node builder stage of the client image — reuses
    # package-lock.json cache.  Includes Zod contract tests, route-contract
    # tests, and all 500+ vitest suites.
    if should_run 2; then
    echo "=== Phase 2: Client unit & contract tests ==="
    if [[ ! -f "$HOST_SRC/Justfile" ]]; then
      ci_error "expected root Justfile at $HOST_SRC/Justfile for client guide tests"
      exit 1
    fi
    CLIENT_VITEST_CMD="npx vitest run --reporter=default"
    if [[ "$CI_DOCKER_COVERAGE_ENABLED" == "1" ]]; then
      CLIENT_VITEST_CMD="$CLIENT_VITEST_CMD --coverage --coverage.provider=v8 --coverage.reporter=text-summary"
    fi
    # Plain Node task (vitest, no browsers), so it runs on the shared Node tier
    # instead of a separate `node:22-bookworm` external base ([D18]). Same Node
    # major (base-node pins NODE_MAJOR=22 and gates on it). Phase 2 has no
    # dependency on Phase 3, so ensure the tier here — it is idempotent ([D5]).
    bash scripts/ensure-base-images.sh base-node
    # The client vitest suite raw-imports a crate fixture via
    # ../../../backend/g5-semantic/tests/fixtures/... which resolves to /backend/g5-semantic/...
    # inside the container. main moved this fixture into g5-semantic during the
    # crate split, so mount the path the tests actually reference. NOTE: keep
    # comments OUT of the `docker run \` continuation below — a `#` line there
    # terminates the continuation and docker loses its arguments.
    docker run --rm \
      -v "$HOST_SRC/frontend:/app" \
      -v "$HOST_SRC/infra/docker:/g5-generation/infra/docker:ro" \
      -v "$HOST_SRC/Justfile:/g5-generation/Justfile:ro" \
      -v "$HOST_SRC/backend/g5-semantic/tests/fixtures:/backend/g5-semantic/tests/fixtures:ro" \
      -v /app/node_modules \
      -w /app \
      -e G5_GENERATION_DIR=/g5-generation \
      g5/base-node:26.04 \
      sh -c "npm ci --prefer-offline && ${CLIENT_VITEST_CMD}" || {
      echo "FAIL: Phase 2 — client vitest tests failed"
      exit 1
    }
    fi  # Phase 2

    # Phase 3: Build service Docker images
    if should_run 3; then
    echo "=== Phase 3: Building service images ==="
    # backend/g5-api/edge are FROM the shared 26.04 tiers ([D18]); ensure the
    # whole chain, parent-first, so every tier layers on the local base and the
    # single-base oracle below holds (a leaf pulled without its parent is
    # keyed, not layered); idempotent ([D5]) regardless of start_phase.
    G5_BASE_IMAGE_STRICT_LINEAGE=1 bash scripts/ensure-base-images.sh base base-rust base-rust-warm base-node
    docker build -f infra/docker/Dockerfile.g5d-base -t g5/g5d-base:latest .
    if [[ "${G5_CI_COMPOSE_BUILD_PARALLEL:-false}" == "true" || "${G5_CI_COMPOSE_BUILD_PARALLEL:-false}" == "1" || "${G5_CI_COMPOSE_BUILD_PARALLEL:-false}" == "on" ]]; then
      echo "compose build: parallel enabled via G5_CI_COMPOSE_BUILD_PARALLEL"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" build --parallel
    else
      echo "compose build: sequential for local Docker Desktop stability (set G5_CI_COMPOSE_BUILD_PARALLEL=true to opt in)"
      for service in oauth-stub client g5-api g5d-host; do
        docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" build "$service"
      done
    fi
    # Single-external-base oracle (test_contract/base_image_consolidation [D2]):
    # every image this phase just built must carry the current g5/base tier's
    # RootFS layers as an exact prefix. This is the fleet-ancestry digest check
    # the contract names; the exclusion list (postgres, the public
    # customer default, the Playwright runner, the tungsten maven builder
    # stage) is simply not passed in ([D18]).
    bash scripts/verify-base-digest-identity.sh --static-scan infra/docker
    BUILT_IMAGES=(g5/g5d-base:latest "$G5_TEST_API_IMAGE" "${COMPOSE_PROJECT}-oauth-stub" "${COMPOSE_PROJECT}-client" "${COMPOSE_PROJECT}-g5d-host" g5/base-rust:26.04 g5/base-rust-warm:26.04 g5/base-node:26.04)
    if should_run 0; then BUILT_IMAGES+=("$CI_IMAGE"); fi
    bash scripts/verify-base-digest-identity.sh "${BUILT_IMAGES[@]}"
    fi  # Phase 3

    # Keep build layers across iterations. Explicit disk recovery is available
    # with G5_CI_INTERPHASE_PRUNE=1 and only runs after fresh service builds.
    if [[ "${G5_CI_INTERPHASE_PRUNE:-0}" == "1" ]] && should_run 3; then
      echo "=== inter-phase cleanup: reclaiming build cache before the stack/integration phases ==="
      docker builder prune -f >/dev/null 2>&1 || true
      docker image prune -f >/dev/null 2>&1 || true
      df -h /var/lib/docker | awk 'NR==2{print "  /var/lib/docker: "$4" free ("$5" used)"}' || true
    fi

    # Phase 4: Start test stack
    # Start the control plane first, seed the org and its bound workspace host,
    # then start that host with the returned host JWT.
    if should_run 4; then
    echo "=== Phase 4: Starting test stack ==="
    # ci-docker is the DETERMINISTIC lane (see the live_llm guard at the top:
    # full LLM execution belongs to `test-live-e2e`). Default the provided-agent
    # fake on so the @long Claude Code / Codex specs exercise the real carrier
    # and isolation path with no credential and no LLM call, instead of
    # attempting a device-code login and timing out on "userCode". The Cloud
    # Build e2e lane sets the same variable on its worker/host container.
    # Explicitly exported values still win.
    export G5_CLAUDE_CODE_FAKE="${G5_CLAUDE_CODE_FAKE:-1}"
    export G5_CODEX_FAKE="${G5_CODEX_FAKE:-1}"
    ci_kv "claude code agent" "fake=${G5_CLAUDE_CODE_FAKE} (deterministic lane)"
    ci_kv "codex agent" "fake=${G5_CODEX_FAKE} (deterministic lane)"
    select_ci_host_ports
    docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" down --remove-orphans 2>/dev/null || true
    _force_remove_project_containers
    docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" up -d --force-recreate postgres oauth-stub db-migrate g5-api
    ./scripts/wait-for-healthy.sh "$COMPOSE_FILE" 120 "$COMPOSE_PROJECT"
    if ! docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=80 --no-color g5-api 2>&1 | grep -F '[g5-api] storage initialized (Filestore { mount_point: "/mnt/g5-repos", tenant_prefix: "repos", worktree_dir: "/tmp/g5-api-storage-worktrees" })' >/dev/null; then
      echo "FAIL: Phase 4 — g5-api did not boot with the filestore-style storage configuration"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=120 --no-color g5-api 2>&1 || true
      exit 1
    fi
    if ! docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" exec -T g5-api curl -sf http://localhost:7500/api/v1/instance/health \
      | grep -E '"database"[[:space:]]*:[[:space:]]*"healthy"' >/dev/null; then
      echo "FAIL: Phase 4 — g5-api database health check did not pass"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=120 --no-color g5-api 2>&1 || true
      exit 1
    fi
    docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" up -d --force-recreate --no-deps client
    ./scripts/wait-for-healthy.sh "$COMPOSE_FILE" 120 "$COMPOSE_PROJECT"
    refresh_ci_host_ports_from_running_stack
    refresh_ci_e2e_urls
    fi  # Phase 4

    # Phase 4a: Seed the CI org and provision its bound workspace host.
    if should_run 4a; then
    echo "=== Phase 4a: Seeding CI org ==="
    seed_env="$(G5_E2E_API_URL="${CI_HOST_API_URL}" G5_E2E_PROVISION_WORKER_HOST=1 ./scripts/seed-ci-org.sh)"
    eval "$seed_env"
    : "${G5D_ORG_ID:?seed-ci-org.sh did not export G5D_ORG_ID}"
    : "${G5D_REPO_ID:?seed-ci-org.sh did not export G5D_REPO_ID}"
    : "${G5D_HOST_ID:?seed-ci-org.sh did not export G5D_HOST_ID}"
    : "${G5_HOST_JWT:?seed-ci-org.sh did not export G5_HOST_JWT}"
    echo "  G5D_ORG_ID=$G5D_ORG_ID"
    echo "  G5D_REPO_ID=$G5D_REPO_ID"
    echo "  G5D_HOST_ID=$G5D_HOST_ID"
    if should_run 0 && ! should_run 4c; then
      python3 scripts/local_validation.py record-stack 5
    fi
    fi  # Phase 4a

    # Phase 4b: Start the bound workspace host on the real KVM substrate.
    if should_run 4b; then
    echo "=== Phase 4b: Starting workspace host ==="
    # Re-seed when Phase 4a was skipped because host JWTs are deliberately not
    # recoverable from the database.
    if [[ -z "${G5D_ORG_ID:-}" || -z "${G5D_HOST_ID:-}" || -z "${G5_HOST_JWT:-}" ]]; then
      seed_env="$(G5_E2E_API_URL="${CI_HOST_API_URL}" G5_E2E_PROVISION_WORKER_HOST=1 ./scripts/seed-ci-org.sh)"
      eval "$seed_env"
      : "${G5D_ORG_ID:?seed-ci-org.sh did not export G5D_ORG_ID}"
      : "${G5D_REPO_ID:?seed-ci-org.sh did not export G5D_REPO_ID}"
      : "${G5D_HOST_ID:?seed-ci-org.sh did not export G5D_HOST_ID}"
      : "${G5_HOST_JWT:?seed-ci-org.sh did not export G5_HOST_JWT}"
      echo "  Seeded G5D_ORG_ID=$G5D_ORG_ID for host startup"
    fi
    export G5D_ORG_ID G5D_REPO_ID G5D_HOST_ID G5_HOST_JWT
    if ! docker run --rm --device /dev/kvm "${COMPOSE_PROJECT}-g5d-host" test -c /dev/kvm; then
      echo "FAIL: Phase 4b requires /dev/kvm; workspace-VM validation has no process fallback"
      exit 1
    fi
    G5D_HOST_BASE_IMAGE="${G5D_HOST_BASE_IMAGE:-mirror.gcr.io/library/buildpack-deps:resolute}"
    export G5D_HOST_BASE_IMAGE
    ./scripts/verify-worker-base-image.sh "$G5D_HOST_BASE_IMAGE"
    RUNTIME_ARCH="$(docker image inspect "${COMPOSE_PROJECT}-g5d-host" --format '{{"{{"}}.Architecture{{"}}"}}')"
    case "$RUNTIME_ARCH" in
      amd64) RUNTIME_ARCH=x64 ;;
      arm64) ;;
      *) echo "FAIL: unsupported workspace-host image architecture: $RUNTIME_ARCH"; exit 1 ;;
    esac
    RUNTIME_STAGE="$(mktemp -d "${TMPDIR:-/tmp}/g5-ci-host-runtime.XXXXXX")"
    RUNTIME_STAGING_IMAGE=g5/g5d-base:latest \
    RUNTIME_STAGING_PACKAGES_PREINSTALLED=1 \
      ./scripts/stage-local-worker-runtime.sh \
        --arch "$RUNTIME_ARCH" \
        --out "$RUNTIME_STAGE" \
        --g5d-from-image "${COMPOSE_PROJECT}-g5d-host"
    HOST_RUNTIME_VOLUME="${COMPOSE_PROJECT}_host_runtime"
    docker volume rm -f "$HOST_RUNTIME_VOLUME" >/dev/null 2>&1 || true
    docker volume create \
      --label "com.docker.compose.project=${COMPOSE_PROJECT}" \
      --label "com.docker.compose.volume=host_runtime" \
      "$HOST_RUNTIME_VOLUME" >/dev/null
    RUNTIME_COPY_CID="$(docker create -v "${HOST_RUNTIME_VOLUME}:/runtime" ubuntu:24.04 true)"
    docker cp "$RUNTIME_STAGE/runtime/." "$RUNTIME_COPY_CID:/runtime/"
    docker rm "$RUNTIME_COPY_CID" >/dev/null
    rm -rf "$RUNTIME_STAGE"
    docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" up -d --force-recreate --no-deps g5d-host
    HOST_READY=0
    # Image preparation happens before registration (600s plus 60s margin).
    for _ in $(seq 1 330); do
      HOST_CONTAINER_STATE="$(docker inspect --format '{{"{{"}}.State.Status{{"}}"}}' "${COMPOSE_PROJECT}-host-1" 2>/dev/null || echo missing)"
      case "$HOST_CONTAINER_STATE" in
        exited|dead|missing)
          echo "FAIL: workspace host container is $HOST_CONTAINER_STATE during preparation"
          break
          ;;
      esac
      HOST_COUNT="$(docker exec "${COMPOSE_PROJECT}-postgres" psql -U g5 -d g5_test -tAc \
        "SELECT COUNT(*) FROM worker_hosts WHERE org_id = '${G5D_ORG_ID}' AND host_id = '${G5D_HOST_ID}' AND status = 'ready' AND last_heartbeat IS NOT NULL" | tr -d '[:space:]')"
      if [[ "${HOST_COUNT:-0}" == "1" ]]; then
        HOST_READY=1
        break
      fi
      sleep 2
    done
    if [[ "$HOST_READY" != "1" ]]; then
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5d-host 2>&1 || true
      echo "FAIL: bound workspace host did not become ready"
      exit 1
    fi
    fi  # Phase 4b

    # Phase 4c: Seed the durable browser/E2E fixture workspace. Workspace VMs
    # materialize their own roots from the API; no host-container filesystem
    # seeding is permitted.
    if should_run 4c; then
    echo "=== Phase 4c: Seeding browser workspace ==="
    REPOS_VOLUME="${REPOS_VOLUME}" \
    PG_CONTAINER="${COMPOSE_PROJECT}-postgres" \
    DB_NAME="g5_test" \
    G5_E2E_TEST_EMAIL="e2e-test@g5.dev" \
    ./scripts/seed-test-workspace.sh "${CI_HOST_API_URL}"
    load_seeded_fixture_env
    if [[ "${G5_CI_PREPARE_ONLY:-0}" == "1" ]]; then
      prepare_playwright_image
    fi
    if should_run 0; then
      python3 scripts/local_validation.py record-stack 6
    fi
    if [[ "${G5_CI_PREPARE_ONLY:-0}" == "1" ]]; then
      finish_ci_docker_success
      exit 0
    fi
    fi  # Phase 4c

    # Phase 5: Integration tests (need live DB — connect via compose network).
    # When coverage is enabled, instrument with cargo llvm-cov --no-report so
    # profdata merges with Phase 1 lib/bin coverage. Merged LCOV reports are
    # generated in Phase 5c.
    if should_run 5; then
    echo "=== Phase 5: Integration tests ==="
    if [[ -n "$E2E_FILTER" ]]; then
      echo "    nextest filter: $E2E_FILTER"
    fi
    if [[ "$CI_DOCKER_COVERAGE_ENABLED" == "1" ]]; then
      INTEGRATION_NEXTEST="cargo llvm-cov nextest --no-report"
    else
      INTEGRATION_NEXTEST="cargo nextest run"
    fi
    echo "=== Phase 5 execution ready ==="
    docker run --rm --init \
      $KVM_FLAG $CI_VOLS \
      -w "$CI_CONTAINER_WORKSPACE" \
      $SCCACHE_ENV \
      -e E2E_FILTER="$E2E_FILTER" \
      -e G5_CI_INTEGRATION_ARGS="${G5_CI_INTEGRATION_ARGS:-[]}" \
      -e INTEGRATION_NEXTEST="$INTEGRATION_NEXTEST" \
      -e SQLX_OFFLINE=false \
      -e CARGO_HOME="$CI_CONTAINER_CARGO_HOME" \
      -e CARGO_TARGET_DIR="$CI_CONTAINER_TARGET" \
      -e CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}" \
      -e CARGO_BUILD_JOBS=1 \
      -e DATABASE_URL="postgres://g5:g5_test@postgres:5432/g5_test" \
      -e TEST_DATABASE_URL="postgres://g5:g5_test@postgres:5432/g5_test" \
      -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
      -e OPENAI_API_KEY="${OPENAI_API_KEY:-}" \
      -e OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}" \
      -e G5D_LLM_PROVIDER="${G5D_LLM_PROVIDER:-}" \
      --network "${COMPOSE_NETWORK}" \
      "$CI_IMAGE" \
      bash -c 'set -euo pipefail; \
             status=0; \
             FILTER_ARGS=(); \
             if [[ -n "$E2E_FILTER" ]]; then FILTER_ARGS=(--no-tests warn -E "$E2E_FILTER"); fi; \
             node -e "for (const arg of JSON.parse(process.env.G5_CI_INTEGRATION_ARGS)) process.stdout.write(arg + String.fromCharCode(0));" > /tmp/g5-integration-args; \
             mapfile -d "" -t TARGET_ARGS < /tmp/g5-integration-args; \
             if (( ${#TARGET_ARGS[@]} )); then \
               ${INTEGRATION_NEXTEST} "${TARGET_ARGS[@]}" --all-features -j1 --no-fail-fast "${FILTER_ARGS[@]}" || status=$?; \
             else \
             ${INTEGRATION_NEXTEST} -p g5-contracts -p g5-semantic -p g5-scm -p fake-provider-cli -p g5d-agent -p g5-api --test "*" --all-features -j1 --no-fail-fast "${FILTER_ARGS[@]}" 2>&1 || status=$?; \
             ${INTEGRATION_NEXTEST} -p g5d-dispatch -p g5d --test "*" --all-features -j1 --no-fail-fast "${FILTER_ARGS[@]}" || status=$?; \
             fi; \
             exit $status' || {
      echo "=== Integration failures detected — dumping g5-api & workspace-host logs ==="
      echo "--- g5-api logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5-api 2>&1 || true
      echo "--- g5d-host logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5d-host 2>&1 || true
      echo "--- container status ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" ps -a 2>&1 || true
      echo "FAIL: Phase 5 — integration tests failed"
      exit 1
    }
    fi  # Phase 5

    # Phase 5b: Claude/Codex provider protocol, parsing, and lifecycle tests.
    if should_run 5b; then
      echo "=== Phase 5b: LLM provider replay tests (no live provider calls) ==="
      $CI_RUN sh -c "cargo test -j2 -p g5d-agent --lib" || {
        echo "FAIL: Phase 5b — LLM provider replay tests failed"
        exit 1
      }
      echo "Live Claude/Codex execution is available through just test-live-e2e"
    fi  # Phase 5b

    # Phase 5c: Generate merged LCOV coverage reports
    # Merges profdata from Phase 1 (lib/bin) + Phase 5 (integration) into single
    # per-crate LCOV files.  The shared target volume ensures all .profraw files
    # are visible to the report command.
    if should_run 5c; then
    if [[ "$CI_DOCKER_COVERAGE_ENABLED" == "1" ]]; then
      echo "=== Phase 5c: Generating merged LCOV coverage reports ==="
      $CI_RUN sh -c "cargo llvm-cov report -p g5-contracts -p g5-auth -p g5-authz -p g5-storage -p g5-semantic -p g5-scm -p g5-internal-api -p fake-provider-cli --lcov --output-path $CI_CONTAINER_WORKSPACE/lcov-g5-shared.info"
      $CI_RUN sh -c "cargo llvm-cov report -p g5-api-foundation -p g5-api-data -p g5-api-core -p g5-api-routes -p g5-api --lcov --output-path $CI_CONTAINER_WORKSPACE/lcov-g5-api.info"
      $CI_RUN sh -c "cargo llvm-cov report -p g5d-foundation -p g5d-isolation -p g5d-agent -p g5d-host -p g5d-dispatch -p g5d --lcov --output-path $CI_CONTAINER_WORKSPACE/lcov-g5d.info"
    else
      echo "=== Phase 5c: Skipping LCOV coverage reports (G5_CI_DOCKER_COVERAGE=false) ==="
    fi
    fi  # Phase 5c

    # Phase 6: Rust E2E scenarios (mounted workspace runner on compose network).
    # Runs deterministic system tests only; live-LLM/full execution is excluded
    # from ci-docker and should use `test-live-e2e` / `e2e-live`.
    # Use the shared CI image + mounted source/target volumes so targeted reruns
    # reuse the live stack and cargo caches without rebuilding test-runner.
    if should_run 6; then
    echo "=== Phase 6: Rust E2E tests ==="
    if [[ -n "$E2E_FILTER" ]]; then
      echo "    cargo test filter: $E2E_FILTER"
    fi
    # Some live-host scenarios inspect the stack through Docker. The workspace
    # host remains running throughout Phase 6; there is no legacy worker race
    # to suppress.
    PHASE6_DOCKER_SOCKET_FLAG="-v /var/run/docker.sock:/var/run/docker.sock -e DOCKER_API_VERSION=1.44"
    PHASE6_HOST_CONTAINERS="$(list_g5d_host_containers)"
    if [[ -z "$PHASE6_HOST_CONTAINERS" ]]; then
      echo "FAIL: Phase 6 requires this test stack's workspace host"
      exit 1
    fi
    if [[ -n "$E2E_FILTER" ]]; then
      if [[ "$E2E_FILTER" == *"view_sync_wiring"* || "$E2E_FILTER" == *"tc_vsw_"* ]]; then
        echo "    targeted filter matches a retired view-sync slice" >&2
        exit 1
      elif [[ "$E2E_FILTER" == *"live_host_budget_resume"* || "$E2E_FILTER" == *"live_host_chat"* || "$E2E_FILTER" == *"approval_review_live"* ]]; then
        PHASE6_DOCKER_SOCKET_FLAG="-v /var/run/docker.sock:/var/run/docker.sock -e DOCKER_API_VERSION=1.44"
        echo "    targeted filter requires the candidate workspace-host Docker harness"
      fi
    fi

    run_phase6_container() {
      local command="$1"
      echo "=== Phase 6 execution ready ==="
      set +x
      docker run --rm --init \
        $KVM_FLAG \
        $PHASE6_DOCKER_SOCKET_FLAG \
        $CI_VOLS \
        -w "$CI_CONTAINER_WORKSPACE" \
        $SCCACHE_ENV \
        -e SQLX_OFFLINE=true \
        -e CARGO_HOME="$CI_CONTAINER_CARGO_HOME" \
        -e CARGO_TARGET_DIR="$CI_CONTAINER_TARGET" \
        -e CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}" \
        -e DATABASE_URL="${CI_E2E_DATABASE_URL}" \
        -e E2E_FILTER="${E2E_FILTER}" \
        -e G5_CI_RUST_ARGS="${G5_CI_RUST_ARGS}" \
        -e G5_E2E_JWT_PRIVATE_KEY \
        -e G5_E2E_HOST_CONTAINERS="$PHASE6_HOST_CONTAINERS" \
        -e G5_E2E_API_URL="${CI_E2E_API_URL}" \
        -e E2E_API_CONTAINER="${COMPOSE_PROJECT}-api" \
        -e G5_E2E_DATABASE_URL="${CI_E2E_DATABASE_URL}" \
        -e G5_E2E_AUTH_MODE=oauth \
        -e G5_E2E_OAUTH_STUB_URL="${CI_E2E_OAUTH_URL}" \
        -e G5_E2E_REQUIRE_LIVE_PROVIDED_AGENT="${G5_E2E_REQUIRE_LIVE_PROVIDED_AGENT:-}" \
        -e G5_E2E_REQUIRE_LIVE_APPROVAL_REVIEW="${G5_E2E_REQUIRE_LIVE_APPROVAL_REVIEW:-}" \
        -e G5D_ORG_ID="${G5D_ORG_ID:-}" \
        -e ANTHROPIC_API_KEY="${ANTHROPIC_API_KEY:-}" \
        -e OPENROUTER_API_KEY="${OPENROUTER_API_KEY:-}" \
        -e OPENAI_API_KEY="${OPENAI_API_KEY:-}" \
        --network "${COMPOSE_NETWORK}" \
        "$CI_IMAGE" \
        bash -c "$command"
    }

    dump_phase6_logs() {
      echo "=== E2E failures detected — dumping g5-api & workspace-host logs ==="
      echo "--- g5-api logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5-api 2>&1 || true
      echo "--- g5d-host logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5d-host 2>&1 || true
      echo "--- container status ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" ps -a 2>&1 || true
    }

    if true; then
      # The platform VM backend is enabled by g5d's default features.
      # The fake provider CLIs build beside g5d so the deterministic chat-turn
      # scenarios can run `fake-claude` / `fake-codex` (plan P3.2).
      run_phase6_container 'set -euo pipefail; cargo build -j2 -p g5d -p fake-provider-cli --bins' || {
        dump_phase6_logs
        echo "FAIL: Phase 6 — Rust E2E tests failed"
        exit 1
      }

      if [[ -z "$E2E_FILTER" ]]; then
        echo "--- Phase 6 step 1: deterministic workspace-VM E2E tests ---"
        run_phase6_container 'set -euo pipefail; G5_E2E_NO_COMPILE=true G5_E2E_CARGO_JOBS=2 ./scripts/run-rust-e2e-lanes.sh' || {
          dump_phase6_logs
          echo "FAIL: Phase 6 — Rust E2E tests failed"
          exit 1
        }
      else
        PHASE6_PRIMARY_STATUS=0
        run_phase6_container 'set -euo pipefail; \
            FILTER_ARGS=(); \
            node -e "for (const arg of JSON.parse(process.env.G5_CI_RUST_ARGS)) process.stdout.write(arg + String.fromCharCode(0));" > /tmp/g5-rust-args; \
            mapfile -d "" -t FILTER_ARGS < /tmp/g5-rust-args; \
            cargo test -j2 -p g5-e2e "${FILTER_ARGS[@]}" -- --test-threads=1' || PHASE6_PRIMARY_STATUS=$?
        if (( PHASE6_PRIMARY_STATUS != 0 )); then
          dump_phase6_logs
          echo "FAIL: Phase 6 — Rust E2E tests failed"
          exit 1
        fi
      fi
    fi

    fi  # Phase 6

    # Phase 6b: API smoke tests — validate live API responses against Zod schemas
    # Runs from the host (needs localhost:7500 exposed by the test stack).
    if should_run 6b; then
    echo "=== Phase 6b: API smoke tests ==="
    docker run --rm --init \
      -v "$HOST_SRC/frontend:/app" \
      -v /app/node_modules \
      -w /app \
      -e E2E_API_URL="${CI_E2E_API_URL}" \
      --network "${COMPOSE_NETWORK}" \
      g5/base-node:26.04 \
      sh -c "npm ci --ignore-scripts && npx vitest run -c vitest.config.smoke.ts --reporter=verbose" || {
      echo "FAIL: Phase 6b — API smoke tests had failures"
      exit 1
    }
    fi  # Phase 6b

    # Phase 7: Playwright browser E2E
    # Run inside a Node container on the compose network so Playwright can
    # reach the client and API over the compose network without needing host
    # port mappings. Use the compose service hostname (client) instead of
    # the raw client container IP so OAuth callback redirects, cookies, and
    # localStorage all stay on the same origin across setup + test phases.
    if should_run 7; then
    echo "=== Phase 7: Playwright E2E ==="
    if [[ -n "$PLAYWRIGHT_FILTER" ]]; then
      echo "    playwright filter: $PLAYWRIGHT_FILTER"
    fi
    CANDIDATE_G5D_DIR="$(mktemp -d "${TMPDIR:-/tmp}/g5-value-loop-g5d.XXXXXX")"
    CANDIDATE_G5D="$CANDIDATE_G5D_DIR/g5d"
    docker cp "${COMPOSE_PROJECT}-api:/usr/local/bin/g5d" "$CANDIDATE_G5D"
    chmod 0555 "$CANDIDATE_G5D"
    # Workspace-VM provider adapters resolve `fake-claude` / `fake-codex`
    # beside g5d and fail closed without them (plan P3.2). The API image ships
    # no fakes, so stage them from the workspace-host image (built on the same
    # rust-warm builder) next to the candidate and mount the directory whole.
    CANDIDATE_FAKES=(fake-claude fake-codex fake-g5-tools)
    FAKE_SOURCE_CID="$(docker create --entrypoint /usr/local/bin/g5d "${COMPOSE_PROJECT}-g5d-host")"
    for fake in "${CANDIDATE_FAKES[@]}"; do
      docker cp "$FAKE_SOURCE_CID:/usr/local/bin/$fake" "$CANDIDATE_G5D_DIR/$fake"
      chmod 0555 "$CANDIDATE_G5D_DIR/$fake"
    done
    docker rm "$FAKE_SOURCE_CID" >/dev/null
    # Keep the runner on the compose network and resolve services through
    # Docker's embedded DNS. Pinning service names to container IPs can leave
    # setup pointed at stale addresses after force-recreate or restart cycles.
    # Run the browser suite in OUR runner image, not a bare `node:22-bookworm`.
    # That image was a third external base nobody tracked, and it lacks the
    # docker CLI the remote-tracking git fixture needs
    # (e2e/fixtures/remote-repo-server.ts drives `docker exec <api> git …`),
    # which is why coordinated-repo-sync failed locally with `spawn docker
    # ENOENT` while passing in Cloud Build. Dockerfile.playwright-runner already
    # bakes the docker CLI, the browsers, and a package-lock-keyed node_modules,
    # and it is the same image the Cloud Build browser lane uses — so this also
    # gives local/remote parity and skips the per-run `npm ci` + browser
    # download. It stays on the Playwright vendor base rather than moving to
    # g5/base-node:26.04: infra/docker_images [I19] records that the locked
    # Playwright 1.58.x refuses Ubuntu 26.04 outright (no 26.04 browser builds
    # published), so migrating it is gated on raising Playwright to >= 1.61.
    prepare_playwright_image
    python3 scripts/local_validation.py record-stack 7

    mkdir -p "$CI_DOCKER_LOG_DIR/playwright"
    PLAYWRIGHT_STATUS=0
    echo "=== Phase 7 execution ready ==="
    docker run --rm --init \
      -v "$HOST_SRC/frontend:/app" \
      -v "$(resolve_host_path "$CI_DOCKER_LOG_DIR/playwright"):/artifacts" \
      -v /app/node_modules \
      -v "$CANDIDATE_G5D_DIR:/opt/g5-candidate:ro" \
      -v /var/run/docker.sock:/var/run/docker.sock \
      -w /app \
      -e E2E_API_CONTAINER="${COMPOSE_PROJECT}-api" \
      -e E2E_BASE_URL="${CI_E2E_BROWSER_URL}" \
      -e E2E_PREVIEW_HOST_RESOLVER="${CI_E2E_PREVIEW_HOST_RESOLVER}" \
      -e E2E_API_URL="${CI_E2E_API_URL}" \
      -e E2E_OAUTH_STUB_URL="${CI_E2E_OAUTH_URL}" \
      -e E2E_DATABASE_URL="postgres://g5:g5_test@postgres:5432/g5_test" \
      -e E2E_USE_OAUTH=true \
      -e G5_E2E_COMPLIANCE_ORG="g5labs" \
      -e G5_E2E_COMPLIANCE_WORKSPACE="e2e-test" \
      -e G5_E2E_CLAUDE_CODE_V1_ENABLED=true \
      -e G5_E2E_CODEX_V1_ENABLED=true \
      -e G5_E2E_CODEX_ROUTING_ENABLED=true \
      -e G5_E2E_CODEX_FAKE=true \
      -e G5_E2E_CODEX_SETTINGS=true \
      -e G5_GUIDED_JOURNEY_ENABLED=true \
      -e G5_E2E_VALUE_LOOP_LIVE_MICROVM="${G5_E2E_VALUE_LOOP_LIVE_MICROVM:-false}" \
      -e G5D_UNDER_TEST=/opt/g5-candidate/g5d \
      -e PLAYWRIGHT_WORKERS=1 \
      -e G5_CI_PLAYWRIGHT_ARGS="${G5_CI_PLAYWRIGHT_ARGS}" \
      -e CI=true \
      --network "${COMPOSE_NETWORK}" \
      "$PLAYWRIGHT_RUNNER_IMAGE" \
      bash -lc 'set -euo pipefail; \
        RUN_DIR=/tmp/g5-playwright-client; \
        trap "cp -a /tmp/g5-playwright-client/test-results /artifacts/ 2>/dev/null || true" EXIT; \
        rm -rf "$RUN_DIR"; mkdir -p "$RUN_DIR"; \
        tar -C /app \
          --exclude=./node_modules --exclude=./coverage --exclude=./dist \
          --exclude=./playwright-report --exclude=./test-results \
          -cf - . | tar -C "$RUN_DIR" -xf -; \
        cd "$RUN_DIR"; \
        ln -s /opt/g5-playwright-client/node_modules node_modules; \
        mkdir -p tests/e2e/.auth; \
        rm -rf tests/e2e/.auth; \
        mkdir -p tests/e2e/.auth; \
        ./node_modules/.bin/playwright test --project=setup --reporter=list e2e/auth.setup.ts; \
        test -s e2e/.auth/user.json; \
        node -e "for (const arg of JSON.parse(process.env.G5_CI_PLAYWRIGHT_ARGS)) process.stdout.write(arg + String.fromCharCode(0));" > /tmp/g5-playwright-args; \
        mapfile -d "" -t FILTER_ARGS < /tmp/g5-playwright-args; \
        echo "=== Chromium tests ==="; \
        ./node_modules/.bin/playwright test --project=chromium --no-deps --reporter=list "${FILTER_ARGS[@]}"; \
        test -s e2e/.auth/user.json' || PLAYWRIGHT_STATUS=$?
    rm -f "$CANDIDATE_G5D"
    for fake in "${CANDIDATE_FAKES[@]}"; do rm -f "$CANDIDATE_G5D_DIR/$fake"; done
    rmdir "$CANDIDATE_G5D_DIR"
    if (( PLAYWRIGHT_STATUS != 0 )); then
      echo "=== Playwright failures detected — dumping browser stack logs ==="
      echo "--- g5-api logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5-api 2>&1 || true
      echo "--- client logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color client 2>&1 || true
      echo "--- g5d-host logs (last 200 lines) ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" logs --tail=200 --no-color g5d-host 2>&1 || true
      echo "--- container status ---"
      docker compose -p "$COMPOSE_PROJECT" -f "$COMPOSE_FILE" ps -a 2>&1 || true
      echo "FAIL: Phase 7 — Playwright E2E tests failed"
      exit 1
    fi
    fi  # Phase 7

    # Print sccache stats so cache hit rates are visible in CI output.
    if [[ -n "$SCCACHE_ENV" ]]; then
      $CI_RUN sccache --show-stats 2>/dev/null || true
    fi

    finish_ci_docker_success


# Print manual Provided Agents/Fake-provider E2E command blocks and checklist.
provided-agents-manual-e2e mode="single-api":
    ./scripts/provided-agents-manual-e2e.sh --mode "{{mode}}"

