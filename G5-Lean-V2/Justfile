# Run database migrations
db-migrate:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    export DATABASE_URL="${DATABASE_URL:-postgres://g5:g5_dev@localhost:${G5_PORT_POSTGRES:-5432}/g5_dev}"
    G5_MIGRATION_SOURCE=backend/g5-api/src/db/migrations \
      cargo run --locked --package g5-api --bin g5-db-migrate

# Generate SQLx offline query data for the full workspace, including tests/bins/examples
db-prepare:
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ -f .env ]]; then set -a; source .env; set +a; fi
    export DATABASE_URL="${DATABASE_URL:-postgres://g5:g5_dev@localhost:${G5_PORT_POSTGRES:-5432}/g5_dev}"
    SQLX_OFFLINE=false cargo sqlx prepare --workspace -- --all-targets

# Run just the Phase 5 integration step, optionally filtered to a specific test.
[positional-arguments]
ci-docker-5 integration_filter="" reuse_stack="auto":
    #!/usr/bin/env bash
    exec just ci-docker 5 false "$1" "" "$2"

# Run just the Phase 6 deterministic Rust E2E step, optionally filtered to a specific test.
# The live_llm argument is kept for backwards compatibility but true is rejected.
[positional-arguments]
ci-docker-6 e2e_filter="" live_llm="false" reuse_stack="auto":
    #!/usr/bin/env bash
    exec just ci-docker 6 "$2" "$1" "" "$3"

# Run just the Phase 7 Playwright browser step, optionally filtered to a file
# or grep selector for faster UI debugging.
[positional-arguments]
ci-docker-7 playwright_filter="" reuse_stack="auto":
    #!/usr/bin/env bash
    exec just ci-docker 7 false "" "$1" "$2"

# Execute all issue-1329 selectors through their explicit Docker profiles and
# validate the exact-candidate machine-readable receipt.
value-loop-matrix reuse_stack="auto":
    ./scripts/run-value-loop-matrix.sh "{{reuse_stack}}"

# ═══════════════════════════════════════════════
# Infrastructure & Deployment (GCP Cloud Build)
# ═══════════════════════════════════════════════
# CI/CD runs via Cloud Build triggers, NOT locally.
# These targets are for local validation / debugging only.

# Helm lint with a local preview worker image; accepts a real image reference too.
helm-lint env="qa" worker_image="projects/g5-local-preview/global/images/g5-worker-preview":
    ./scripts/helm-local.sh lint infra/helm/g5 -f infra/helm/g5/values-{{env}}.yaml --set-string api.env.G5_WORKER_IMAGE="{{worker_image}}"

# Helm template for local inspection; the default worker image is a placeholder.
helm-template env="qa" tag="latest" worker_image="projects/g5-local-preview/global/images/g5-worker-preview":
    ./scripts/helm-local.sh template g5 infra/helm/g5 \
      -f infra/helm/g5/values-{{env}}.yaml \
      --set global.imageTag={{tag}} \
      --set-string api.env.G5_WORKER_IMAGE="{{worker_image}}"

# Get GKE credentials for kubectl
gke-auth env="dev":
    gcloud container clusters get-credentials g5-{{env}} --region us-central1

# Check deployment status (read-only, safe locally)
deploy-status:
    #!/usr/bin/env bash
    set -euo pipefail
    echo "=== Deployments ==="
    kubectl get deployments -o wide
    echo ""
    echo "=== Pods ==="
    kubectl get pods -o wide
    echo ""
    echo "=== Services ==="
    kubectl get svc
    echo ""
    echo "=== Ingress ==="
    kubectl get ingress

# Trigger both retained Cloud Build CI lanes.
cb-ci branch="main": (cb-ci-rust branch) (cb-ci-e2e branch)

# Trigger the Rust CI lane.
cb-ci-rust branch="main":
    gcloud builds triggers run g5-ci-rust --branch="{{branch}}" --region="${G5_CLOUD_BUILD_REGION:-us-central1}"

# Trigger the E2E CI lane.
cb-ci-e2e branch="main":
    gcloud builds triggers run g5-ci-e2e --branch="{{branch}}" --region="${G5_CLOUD_BUILD_REGION:-us-central1}"

# Deploy a branch to QA through the g5-deploy-qa trigger in g5-qa-1ccc. QA is the only
# environment this repository delivers to (infra/ci/cloudbuild-deploy.yaml guard).
cb-deploy env="qa" branch="main":
    #!/usr/bin/env bash
    set -euo pipefail
    if [[ "{{env}}" != "qa" ]]; then
      echo "This repository deploys only to qa (g5-deploy-qa in g5-qa-1ccc); got env={{env}}." >&2
      exit 2
    fi
    gcloud builds triggers run g5-deploy-qa --project=g5-qa-1ccc --branch="{{branch}}" --region="${G5_CLOUD_BUILD_REGION:-us-central1}"

# List recent Cloud Build runs
cb-list:
    gcloud builds list --region="${G5_CLOUD_BUILD_REGION:-us-central1}" --limit=10 --format='table(id,status,source.repoSource.branchName,createTime,duration)'

# Stream Cloud Build logs
cb-logs build_id:
    gcloud builds log "{{build_id}}" --region="${G5_CLOUD_BUILD_REGION:-us-central1}" --stream

# Show Artifact Registry images
ar-images:
    gcloud artifacts docker images list us-central1-docker.pkg.dev/$(gcloud config get-value project)/g5 --format='table(package,tags,createTime)'

# Wipe & regenerate the CLOUD dev environment (dev.g5labs.ai) to a clean slate,
# in two steps. Step 1 backs up first, TRUNCATEs all tenant data, re-runs the
# platform seed (operator org + operator invitation) and stops. After the
# operator signs in again, `--regenerate --members-file=<snapshot>` creates an
# empty `internal-g5-devs` org via POST /api/v1/platform/orgs and re-invites
# today's members. DESTRUCTIVE — preview with `--dry-run`. Step 1 needs
# DEFAULT_ADMIN_EMAIL or G5D_TOKEN and either --proxy (auto cloud-sql-proxy) or
# USE_K8S_PSQL=1 DB_HOST=<private-ip>; step 2 needs a fresh operator G5D_TOKEN.
reset-dev-environment *ARGS:
    bash ./scripts/reset-dev-environment.sh {{ARGS}}
