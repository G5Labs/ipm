# =============================================================================
# Dockerfile.base-rust — Rust toolchain tier over the common base
# Base: g5/base:26.04 (Ubuntu 26.04, glibc 2.43, perl-free git)
# Platforms: linux/amd64, linux/arm64
# =============================================================================
# Contract: software_architecture/integration-stack/docker_images [D18] — the
# common base is thin, and toolchains are layered as named tiers so a leaf pulls
# a toolchain only when it genuinely builds with one. This tier exists because
# there is no official `rust:*-resolute` image; the toolchain is installed via
# rustup instead of pulling a second distribution base.
#
# WHO SHOULD USE THIS TIER
# ------------------------
# Any build stage whose output runs on the common base (26.04) or newer.
#
# WHO MUST NOT USE THIS TIER ([D18] ABI rule,
# system_invariants/microvm_execution_boundary [D12])
# ---------------------------------------------------------------------------
# Any build stage whose output binary is executed on a target OLDER than 26.04.
# glibc is backward- but not forward-compatible, so a binary linked here against
# glibc 2.43 will NOT load on noble (2.39) or bookworm (2.36). The surviving
# instance is the `g5d` Local Setup artifact that runs on end users' own
# (ungated) machines — it keeps building on its older base. The MOUNTED worker
# runtime is deliberately built HERE at 2.43: the guest floor was raised to
# match ([D12]), enforced by the fail-closed provisioning/refresh guard, so
# guests below the floor are rejected rather than crashed into.
# Build old, run new — never the reverse.
#
# Layer strategy mirrors Dockerfile.g5d-base: one RUN per toolchain concern so
# bumping one version does not rebuild the others.
# =============================================================================

ARG BASE_IMAGE=g5/base:26.04
FROM ${BASE_IMAGE} AS final

ENV DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH

# Pinned versions. RUST_VERSION tracks the workspace toolchain so the CI builder
# and the worker toolchain cannot drift onto different compilers ([I16]).
ARG RUST_VERSION=1.97.1
# v0.17.0: the SAME version the deploy sccache-GCS contract ([D17]) depends on
# for strict --start-server backend validation and the credentials-URL token
# shim. One binary at one PATH position for every descendant — the leaves used
# to install their own v0.17 under /usr/local/bin, which this tier's
# /usr/local/cargo/bin copy SHADOWED via PATH order, silently running v0.10
# semantics under a v0.17-tuned preflight.
ARG SCCACHE_VERSION=v0.17.0
# Per-arch sha256 of the pinned sccache release tarball, from upstream's
# published .sha256 files. infra/docker_images [I31] requires this tarball to be
# sha256-verified; piping the download straight into tar trusts whatever the
# endpoint returns and installs a truncated or substituted archive unchecked.
ARG SCCACHE_SHA256_AARCH64=821a86343191aa1cbab74bd42f9e93c9a63bf85e4742945f40d3ae84193c1c77
ARG SCCACHE_SHA256_X86_64=67c4a96dd237c1f518f6b36083f270f9976d516f1e57fce891755ea782e50006
ARG CARGO_CHEF_VERSION=0.1.77

# --- Layer 1: native build prerequisites -------------------------------------
# Needed by Rust sys-crates (ring, openssl-sys, libsqlite3-sys, zstd-sys,
# libgit2-sys) and to link final test binaries. NOT installing `git` here: the
# common base already provides the perl-free git, and the distro package would
# drag perl back in ([D19]). The exact compiler subset is installed instead of
# the `build-essential` metapackage, because build-essential pulls `dpkg-dev`
# which drags in `libdpkg-perl` and thereby the FULL perl — the compiler subset
# builds/links native crates identically and keeps this tier free of full perl
# ([D19] perl scope).
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    make \
    libc6-dev \
    cmake \
    curl \
    libffi-dev \
    libsqlite3-dev \
    libssl-dev \
    libzstd-dev \
    pkg-config \
    xz-utils \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

# --- Layer 2: Rust toolchain --------------------------------------------------
ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

# rustup comes as the pinned rustup-init BINARY with per-arch sha256 from
# static.rust-lang.org ([D18]: pinned, checksum-verified — never `curl | sh` of
# the mutable sh.rustup.rs script). rustup itself then verifies the toolchain
# artifacts it downloads. The install is retried in place ([D18]): this tier is
# may build on hosts where transient network failures interrupt sustained
# downloads (a reset followed by a DNS failure on reconnect);
# rustup resumes the `.partial` files it keeps, so a retry finishes the fetch
# rather than restarting it, and every attempt verifies the same manifests.
ARG RUSTUP_VERSION=1.29.0
ARG RUSTUP_SHA256_X86_64=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
ARG RUSTUP_SHA256_AARCH64=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
RUN set -eux; \
    RTARGET="$(case "${TARGETARCH:-$(uname -m)}" in arm64|aarch64) echo aarch64-unknown-linux-gnu ;; *) echo x86_64-unknown-linux-gnu ;; esac)"; \
    case "$RTARGET" in \
      aarch64-*) RUSTUP_SHA256="${RUSTUP_SHA256_AARCH64}" ;; \
      *)         RUSTUP_SHA256="${RUSTUP_SHA256_X86_64}" ;; \
    esac; \
    curl -fsSLo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RTARGET}/rustup-init"; \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    retry() { n=0; until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then return 1; fi; echo "attempt $n/5 failed: $*; retrying in $((n*10))s" >&2; sleep $((n*10)); done; }; \
    export RUSTUP_MAX_RETRIES=10; \
    retry /tmp/rustup-init -y --default-toolchain "${RUST_VERSION}" --profile default \
      --component rustfmt --component clippy; \
    rm -f /tmp/rustup-init

# --- Layer 3: build accelerators (pre-built binaries, no source compile) ------
RUN set -eux; \
    # TARGETARCH is auto-populated by BuildKit only. Cloud Build's
    # gcr.io/cloud-builders/docker runs the LEGACY builder, which leaves it
    # unset and makes `set -u` abort here; fall back to the native arch, which
    # is always correct for a single-platform (non-buildx) build.
    ARCH="$(case "${TARGETARCH:-}" in \
              arm64) echo aarch64 ;; \
              amd64) echo x86_64 ;; \
              *) uname -m ;; \
            esac)"; \
    case "$ARCH" in \
      aarch64) SCCACHE_SHA256="${SCCACHE_SHA256_AARCH64}" ;; \
      x86_64)  SCCACHE_SHA256="${SCCACHE_SHA256_X86_64}" ;; \
      *) echo "FATAL: no pinned sccache sha256 for arch $ARCH" >&2; exit 1 ;; \
    esac; \
    curl -LsSf -o /tmp/sccache.tar.gz \
      "https://github.com/mozilla/sccache/releases/download/${SCCACHE_VERSION}/sccache-${SCCACHE_VERSION}-${ARCH}-unknown-linux-musl.tar.gz"; \
    echo "${SCCACHE_SHA256}  /tmp/sccache.tar.gz" | sha256sum -c -; \
    tar zxf /tmp/sccache.tar.gz --strip-components=1 -C /usr/local/cargo/bin --wildcards '*/sccache'; \
    rm -f /tmp/sccache.tar.gz; \
    chmod +x /usr/local/cargo/bin/sccache; \
    sccache --version

RUN cargo install cargo-chef --locked --version "${CARGO_CHEF_VERSION}"

# CARGO_INCREMENTAL is NOT set at this tier: sccache rejects incremental
# compilation, so the =0 pairing lives in base-rust-warm's ENV (the tier that
# arms RUSTC_WRAPPER) and in each consumer RUN that arms the wrapper itself —
# never unconditionally on a tier whose descendants may compile wrapper-less
# ([D17] pairing rule).

# Link with lld for faster container builds (dev-up / ci-docker / release image
# builders and the base-rust-warm cook all descend from this tier and inherit
# this env). Set as CARGO_BUILD_RUSTFLAGS (env form of build.rustflags) rather
# than in the workspace .cargo/config.toml so LOCAL non-container dev builds —
# which may not have ld.lld installed — are unaffected; container builds do have
# lld (installed in Layer 4 below). The
# `-Awarnings` token is preserved from .cargo/config.toml's build.rustflags,
# because CARGO_BUILD_RUSTFLAGS overrides (does not append to) that config key.
# rustflags participate in the sccache cache key, so this value must match
# across the base-rust-warm cook and every consumer for cross-context hits.
ENV CARGO_BUILD_RUSTFLAGS="-Awarnings -Clink-arg=-fuse-ld=lld"

# Shared native compilation tools. The VMM no longer links into Rust binaries.
RUN apt-get update && apt-get install -y --no-install-recommends clang libclang-dev lld \
    && rm -rf /var/lib/apt/lists/*

# --- Build-time gate ---------------------------------------------------------
# Rule 5: a toolchain layer without a gate is a stub. Assert the pinned versions
# and that a real compile+link succeeds, rather than trusting the installers.
RUN set -eux; \
    rustc --version | grep -qF "${RUST_VERSION}"; \
    cargo --version | grep -qF "${RUST_VERSION}"; \
    sccache --version; \
    cargo chef --version; \
    cc --version >/dev/null; \
    ld --version >/dev/null; \
    # The perl-free git from the common base must have survived this tier.
    git --version; \
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: this tier reinstalled the distribution git package" >&2; exit 1; \
    fi; \
    # The full perl must stay out ([D19] perl scope): this tier installs the
    # compiler subset, NOT build-essential, precisely so dpkg-dev/libdpkg-perl
    # does not pull the full perl in. perl-base (Essential) may remain.
    for pkg in perl dpkg-dev libdpkg-perl; do \
        if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then \
            echo "FATAL: $pkg is installed; this tier must not pull the full perl" >&2; exit 1; \
        fi; \
    done; \
    # Version-agnostic: `perl-modules-5.NN`/`libperl5.NN` carry the perl minor
    # version, so a pinned name stops matching on a newer base and the gate would
    # pass with the full perl present. Match the family (Dockerfile.base does the
    # same); Essential `perl-base` is unversioned and never matches.
    bad="$(dpkg-query -W -f='${Package} ${Status}\n' 2>/dev/null \
             | awk '$NF == "installed" && ($1 ~ /^perl-modules-/ || $1 ~ /^libperl[0-9]/) { print $1 }')"; \
    if [ -n "$bad" ]; then \
        echo "FATAL: versioned perl package(s) installed: $bad" >&2; exit 1; \
    fi; \
    # Prove the toolchain can actually compile and link a binary.
    probe="$(mktemp -d)"; cd "$probe"; \
    cargo init --quiet --name toolchain_probe .; \
    cargo build --quiet --release; \
    ./target/release/toolchain_probe >/dev/null; \
    cd /; rm -rf "$probe"

CMD ["/bin/bash"]
