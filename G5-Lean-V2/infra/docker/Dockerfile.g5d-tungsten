# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.g5d-tungsten — G5 workspace VM image with Tungsten build dependencies
# =============================================================================
# Layers JDK 17 + Maven 3.9 + Docker Engine (DinD) on top of the standard g5d
# workspace VM image so an agent session can execute
# `mvn verify` against compliance-workspace/compliance-code with Testcontainers
# (Postgres / Kafka / Redis / Temporal) backed by a real local Docker daemon.
#
# The workspace VM environment must permit nested Docker for this image.
#
# Platforms: linux/amd64, linux/arm64
# =============================================================================

# Global ARG — must be declared before the first FROM so subsequent FROM
# instructions can reference it.
ARG BASE_IMAGE=g5/g5d:latest

# ---------------------------------------------------------------------------
# JDK 17 + Maven — lifted verbatim from the upstream maven:3.9-eclipse-temurin-17
# image that compliance-workspace/compliance-code/Dockerfile uses as its
# `AS builder` stage. Copying the same /opt/java/openjdk and /usr/share/maven
# trees guarantees the worker compiles compliance-service with byte-identical
# tooling to Tungsten's production build (Eclipse Temurin 17 + Maven 3.9.x).
# ---------------------------------------------------------------------------
# Digest-pinned (docker_images [D18] customer-parity exclusion): the tag is
# mutable, and the parity rationale is only real when the copied JDK/Maven
# bytes are the reviewed ones. Bump the digest together with the customer's
# build-chain image.
FROM maven:3.9-eclipse-temurin-17@sha256:a8746f15d5bb26b5b8bacb056cc76211553850f4c71d16aff845cfa004cbc197 AS maven-source

FROM ${BASE_IMAGE}

USER root

# Eclipse Temurin 17 (overrides JDK 21 from g5d-base for `java`/`javac`/`mvn`).
# JDK 21 stays installed at /usr/lib/jvm/java-21-openjdk-* for tools that need it.
COPY --from=maven-source /opt/java/openjdk /opt/java/openjdk
ENV JAVA_HOME=/opt/java/openjdk
ENV PATH="${JAVA_HOME}/bin:${PATH}"

# Maven 3.9.x from the same upstream image.
COPY --from=maven-source /usr/share/maven /usr/share/maven
ENV MAVEN_HOME=/usr/share/maven
ENV PATH="${MAVEN_HOME}/bin:${PATH}"

RUN java -version && mvn -version

# ---------------------------------------------------------------------------
# Workspace VM PATH + HOME (infra ontology g5/infra D17).
#
# The `ENV PATH=…` above reaches `docker run` / the image ENTRYPOINT directly. On
# the Cloud Hypervisor microVM path (`IsolationMode::MicroVm`, the standing Tungsten host)
# g5d DOES merge the image `config.env` (`isolation::microvm::resolved_guest_env`),
# but the dispatch environment is appended last and wins on key collisions, so
# its `PATH` overrides the image's
# `PATH`. Result: `mvn`/`java` under /usr/share/maven/bin, /opt/java/openjdk/bin
# are off the effective PATH and the chat agent sees `mvn: command not found`.
# The spec PATH always includes /usr/local/bin, so symlink the launchers there to
# make them resolvable in-microVM (harmless for the entrypoint/`docker run`
# paths, which already have them on PATH via the image ENV).
RUN ln -sf /usr/share/maven/bin/mvn /usr/local/bin/mvn \
    && ln -sf /usr/share/maven/bin/mvnDebug /usr/local/bin/mvnDebug \
    && ln -sf /opt/java/openjdk/bin/java /usr/local/bin/java \
    && ln -sf /opt/java/openjdk/bin/javac /usr/local/bin/javac

# The workspace VM agent process drops to the unprivileged `ubuntu` uid (1000), but
# its HOME (/home/ubuntu) is root-owned 0750, so Maven cannot create
# ~/.m2/repository (and any HOME-writing tool fails). Make it owned and writable
# by the agent uid so builds work without per-invocation -Duser.home overrides.
RUN mkdir -p /home/ubuntu \
    && chown 1000:1000 /home/ubuntu \
    && chmod 0700 /home/ubuntu

# ---------------------------------------------------------------------------
# Docker Engine (DinD) — Tungsten tests use Testcontainers 1.21.4, which
# spawns real containers at runtime. The runtime must therefore embed a full
# Docker daemon. iptables is required for default bridge networking.
# ---------------------------------------------------------------------------
RUN install -m 0755 -d /etc/apt/keyrings \
    && curl -fsSL https://download.docker.com/linux/ubuntu/gpg \
        -o /etc/apt/keyrings/docker.asc \
    && chmod a+r /etc/apt/keyrings/docker.asc \
    && CODENAME="$(. /etc/os-release && echo "$VERSION_CODENAME")" \
    && [ "$CODENAME" = "resolute" ] || { echo "FATAL: expected the resolute (26.04) base, got $CODENAME — the docker apt suite below must match the OS" >&2; exit 1; } \
    && echo "deb [arch=$(dpkg --print-architecture) signed-by=/etc/apt/keyrings/docker.asc] https://download.docker.com/linux/ubuntu $CODENAME stable" \
        > /etc/apt/sources.list.d/docker.list \
    && apt-get update && apt-get install -y --no-install-recommends \
        docker-ce docker-ce-cli containerd.io \
        docker-buildx-plugin docker-compose-plugin \
        iptables \
    && rm -rf /var/lib/apt/lists/* \
    && usermod -aG docker g5

# vfs storage driver works inside every Kubernetes runtime (runc, kata, gVisor)
# without depending on host overlayfs being usable nested. Slower than overlay2
# but the only universally-safe choice for a privileged DinD sidecar. Flip to
# overlay2 once the host is confirmed Ubuntu-on-bare-metal with
# overlay enabled, via daemon.json or DOCKERD_EXTRA_ARGS at runtime.
RUN mkdir -p /etc/docker \
    && printf '%s\n' '{' \
        '  "storage-driver": "vfs",' \
        '  "iptables": true,' \
        '  "log-driver": "json-file",' \
        '  "log-opts": {"max-size": "10m", "max-file": "3"}' \
        '}' > /etc/docker/daemon.json

# ---------------------------------------------------------------------------
# Entrypoint wrapper — start dockerd as root, then exec `g5d host` as g5.
# ---------------------------------------------------------------------------
COPY infra/docker/g5d-provider-env.sh /usr/local/bin/g5d-provider-env
COPY infra/docker/entrypoint-g5d-tungsten.sh /usr/local/bin/entrypoint-g5d-tungsten.sh
RUN chmod +x /usr/local/bin/g5d-provider-env /usr/local/bin/entrypoint-g5d-tungsten.sh

WORKDIR /workspace
# tini reaps zombies left behind by container teardown (Testcontainers stops
# and removes its containers after each test class; without tini the host's
# PID 1 would accumulate defunct containerd-shim children).
ENTRYPOINT ["tini", "--", "/usr/local/bin/entrypoint-g5d-tungsten.sh"]
