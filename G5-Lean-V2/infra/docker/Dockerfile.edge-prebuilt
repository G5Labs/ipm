# =============================================================================
# Dockerfile.edge-prebuilt - CI runtime packaging for prebuilt frontend assets
# =============================================================================
# Cloud CI already runs the frontend build gate. This Dockerfile validates the
# Caddy runtime image packaging from frontend/dist without running npm again.
#
# Runtime parity requirement (integration-stack/docker_images [D13]): this image
# must match Dockerfile.edge's runtime stage. It therefore uses the same common
# base ([D18]), the same Caddy-source stage pattern, the same XDG roots, and the
# same explicit CMD — a prebuilt variant that drifted from the source-built
# runtime would validate packaging that production does not use.
# =============================================================================

ARG BASE_IMAGE=g5/base:26.04
# Official multi-platform image supplies only the static Caddy binary.
ARG CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

# --- Caddy source ---
# Copy the static binary from the official image pinned by version and digest.
# The deployable runtime uses the common G5 base with this binary. Keep the
# source aligned with the sibling edge Dockerfile and Dockerfile.g5d-g5dev.
FROM ${CADDY_IMAGE} AS caddy-source

# --- Stage 2: runtime ---
FROM ${BASE_IMAGE} AS runtime

COPY --from=caddy-source /usr/bin/caddy /usr/bin/caddy

# wget backs the container HEALTHCHECK (`wget -q --spider …/healthz`). The common
# base is ubuntu:26.04 (no wget/curl, unlike the former caddy:2-alpine base), so
# install it explicitly or the client service never reports healthy. Mirrors
# Dockerfile.edge.
RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

# Inherited-git guard ([D19] / test_contract D1): fail the build if anything in
# this stage's apt set reintroduced the distribution git (its perl chain) over
# the base's perl-free build.
RUN set -eux; \
    git --version; \
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: this image reinstalled the distribution git package" >&2; exit 1; \
    fi

ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data
RUN mkdir -p /config/caddy /data/caddy /srv

COPY frontend/dist /srv
COPY infra/docker/Caddyfile /etc/caddy/Caddyfile
# Optional CI-only TLS site; activated by copying it into /etc/caddy/sites.d/
# at container start (see infra/docker/caddy-ci-tls.caddyfile).
COPY infra/docker/caddy-ci-tls.caddyfile /etc/caddy/optional/caddy-ci-tls.caddyfile
RUN mkdir -p /etc/caddy/sites.d
COPY infra/docker/edge-entrypoint.sh /usr/local/bin/edge-entrypoint.sh

EXPOSE 80

RUN set -eux; \
    caddy version; \
    caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

CMD ["/usr/local/bin/edge-entrypoint.sh"]
