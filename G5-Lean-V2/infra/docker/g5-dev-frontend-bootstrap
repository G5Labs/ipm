#!/usr/bin/env bash
set -euo pipefail

usage() {
  echo "usage: g5-dev-frontend-bootstrap [client-directory]" >&2
}

if [[ ${1:-} == "--help" || ${1:-} == "-h" ]]; then
  usage
  exit 0
fi
if [[ $# -gt 1 ]]; then
  usage
  exit 2
fi

if [[ $# -eq 1 ]]; then
  client_dir=$1
elif [[ -f frontend/package.json ]]; then
  client_dir=frontend
elif [[ -f client/package.json ]]; then
  client_dir=client
elif [[ -f package.json ]]; then
  # Invoked from inside the client checkout itself (the `frontend-only` preview
  # profile runs with working_dir frontend): resolve the cwd.
  client_dir=.
else
  echo "g5 frontend bootstrap: no client checkout found; pass the directory explicitly" >&2
  exit 2
fi

client_dir=$(cd "$client_dir" && pwd)
package_json="$client_dir/package.json"
package_lock="$client_dir/package-lock.json"
stamp="$client_dir/node_modules/.g5-lockfiles.sha256"

[[ -f $package_json ]] || { echo "g5 frontend bootstrap: missing $package_json" >&2; exit 2; }
[[ -f $package_lock ]] || { echo "g5 frontend bootstrap: missing $package_lock; npm ci requires the committed lockfile" >&2; exit 2; }
command -v npm >/dev/null || { echo "g5 frontend bootstrap: npm is unavailable" >&2; exit 2; }

if command -v sha256sum >/dev/null; then
  digest=$(sha256sum "$package_json" "$package_lock" | sha256sum | awk '{print $1}')
elif command -v shasum >/dev/null; then
  digest=$(shasum -a 256 "$package_json" "$package_lock" | shasum -a 256 | awk '{print $1}')
else
  echo "g5 frontend bootstrap: sha256sum or shasum is required" >&2
  exit 2
fi

if [[ -f $stamp && $(<"$stamp") == "$digest" ]]; then
  echo "g5 frontend bootstrap: lockfile dependencies already current"
  exit 0
fi

echo "g5 frontend bootstrap: installing frozen dependencies in $client_dir"
(cd "$client_dir" && npm ci --no-audit --no-fund)
mkdir -p "$client_dir/node_modules"
printf '%s\n' "$digest" > "$stamp"
echo "g5 frontend bootstrap: dependencies ready"
