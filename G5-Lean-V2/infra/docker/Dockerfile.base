# =============================================================================
# Dockerfile.base — The single common base image for every G5 container
# Base: ubuntu:26.04 (resolute, Ubuntu 26.04 LTS, glibc 2.43)
# Size target: thin — OS + CA certs + perl-free git only
# Platforms: linux/amd64, linux/arm64
# =============================================================================
# Contract: software_architecture/integration-stack/docker_images [D18] (one
# common base, toolchains as explicit tiers) and [D19] (git built from source
# without perl, once, here).
#
# Why this image exists: every G5 image previously carried its own upstream base
# (rust:*-bookworm, node:*-alpine, caddy:*-alpine, debian:*-slim, ubuntu:24.04,
# vendor SDK images), so a host running several G5 images pulled several
# unrelated distribution trees. Deriving them all from this one base means the
# OS layers are pulled once and shared, and an OS upgrade or CVE response
# happens in one place.
#
# This image is deliberately THIN. Toolchains belong in the tier images that
# build FROM it (Dockerfile.base-rust, Dockerfile.base-node), never here —
# putting a compiler here would push it into every deployable runtime and break
# [D1]'s no-toolchain-in-runtime rule.
#
# ABI note ([D18], system_invariants/microvm_execution_boundary [D12]): this
# base links against glibc 2.43. glibc is backward- but not forward-compatible,
# so a binary built here will NOT load on noble (2.39) or bookworm (2.36).
# Build stages whose output runs on an older target must stay on an older base.
# =============================================================================

# --- Stage 1: build git from source without perl -----------------------------
# Ubuntu's own `git` package declares a hard dependency on `perl` and
# `liberror-perl`, so no apt configuration can produce a perl-free git ([D19]).
# A source build is the only mechanism. The version tracks the distribution's
# own git (resolute ships 1:2.53.0-1ubuntu1) so behavior does not drift from
# what the archive would have supplied.
# The upstream tag is pinned by its multi-arch manifest-list digest so the
# fleet's root bytes are reviewed and reproducible: a mutable `ubuntu:26.04`
# would let a stale daemon keep old vulnerable roots or a clean rebuild change
# bytes with no repository change. Bumping this digest (Ubuntu point/CVE
# releases) is a reviewed dependency update, and the tier freshness label
# (ensure-base-images.sh hashes this Dockerfile) rebuilds every tier on bump.
ARG UBUNTU_BASE=ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b
FROM ${UBUNTU_BASE} AS git-builder

ENV DEBIAN_FRONTEND=noninteractive

ARG GIT_VERSION=2.53.0
# Published upstream digest from the PGP-signed manifest at
# https://mirrors.edge.kernel.org/pub/software/scm/git/sha256sums.asc
ARG GIT_SHA256=5818bd7d80b061bbbdfec8a433d609dc8818a05991f731ffc4a561e2ca18c653
ARG GIT_PREFIX=/opt/g5-git

# zlib is the only hard library dependency (git will not build without it).
# libcurl gives http/https transport, libexpat gives git-http-push, gettext
# keeps localized output at parity with the distribution package.
RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    ca-certificates \
    curl \
    gettext \
    libcurl4-openssl-dev \
    libexpat1-dev \
    libssl-dev \
    make \
    xz-utils \
    zlib1g-dev \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /usr/src
# kernel.org CDN endpoints fail independently (2026-08-27: mirrors.edge
# unreachable, cdn 503, www healthy), so the pinned tarball downloads through
# a mirror list with a small bounded per-mirror retry (docker_images [D19]).
# The transport is best-effort; the SHA-256 pin below is the only acceptance
# gate, and a missing/corrupt download fails the build closed there.
RUN set -eu; \
    for base in \
        https://www.kernel.org/pub/software/scm/git \
        https://cdn.kernel.org/pub/software/scm/git \
        https://mirrors.edge.kernel.org/pub/software/scm/git; do \
      for attempt in 1 2; do \
        if curl -fSL --connect-timeout 20 --max-time 300 \
             -o "git-${GIT_VERSION}.tar.xz" \
             "${base}/git-${GIT_VERSION}.tar.xz"; then \
          break 2; \
        fi; \
        rm -f "git-${GIT_VERSION}.tar.xz"; \
        sleep 10; \
      done; \
    done \
    && echo "${GIT_SHA256}  git-${GIT_VERSION}.tar.xz" | sha256sum -c - \
    && tar -xJf "git-${GIT_VERSION}.tar.xz" \
    && rm "git-${GIT_VERSION}.tar.xz"

# NO_PERL drops the six perl porcelain scripts plus git-instaweb and gitweb;
# NO_TCLTK drops git-gui/gitk. Both are recorded capability losses in [D19].
# DESTDIR-install into a self-contained prefix so the runtime stage can COPY it
# without dragging the build toolchain forward.
RUN cd "git-${GIT_VERSION}" \
    && make -j"$(nproc)" prefix="${GIT_PREFIX}" NO_PERL=1 NO_TCLTK=1 all \
    && make prefix="${GIT_PREFIX}" NO_PERL=1 NO_TCLTK=1 install \
    && cd .. \
    && rm -rf "git-${GIT_VERSION}"

# --- Stage 2: the common base ------------------------------------------------
FROM ${UBUNTU_BASE} AS final

ENV DEBIAN_FRONTEND=noninteractive

ARG GIT_VERSION=2.53.0
ARG GIT_PREFIX=/opt/g5-git

LABEL org.opencontainers.image.title="g5/base" \
      org.opencontainers.image.description="Common G5 base: Ubuntu 26.04 with perl-free git" \
      com.g5labs.base.git_version="${GIT_VERSION}" \
      com.g5labs.base.git_no_perl="1"

# Runtime libraries the source-built git links against. Deliberately NOT the
# `git` package: installing it would pull the FULL perl interpreter back in and
# violate [D19].
#
# Perl scope ([D19]): the full `perl`/`perl-modules`/`libperl`/`liberror-perl`
# packages and the perl-implemented git porcelain are absent — that is the git
# guarantee. Essential `perl-base` (a ~2 MB minimal perl) is deliberately KEPT:
# it cannot be removed without also removing `debconf` (which depends on it), and
# without debconf every later package configure — e.g. a `libc6` security
# upgrade in a descendant — dies with `debconf/frontend: not found` and breaks
# apt for the whole tree. perl-base is required by the OS package machinery and
# is never invoked by git, so keeping it does not weaken the perl-free-git
# contract.
# Package floors asserted after the install below. Declared BEFORE that layer
# on purpose: a build-arg change invalidates the cache of every later RUN, so
# raising a floor also re-runs the install instead of re-checking a cached,
# stale layer.
ARG CA_CERTIFICATES_MIN=20260816ubuntu0.26.04.1
ARG LIBLZMA5_MIN=5.8.3-1ubuntu0.1
# `apt-get upgrade` (no new packages) carries every Ubuntu security update
# published up to the build into the base, so a tier rebuild also refreshes
# packages the ubuntu:26.04 digest already ships (liblzma5, libc6, ...).
RUN apt-get update && apt-get upgrade -y --no-install-recommends \
    && apt-get install -y --no-install-recommends \
    ca-certificates \
    libcurl4t64 \
    libexpat1 \
    zlib1g \
    && rm -rf /var/lib/apt/lists/*

# Trust-store floor (2026-10-22, eMudhra/emSign intermediate-CA key compromise).
# USN-8944-1 (2026-10-20) drops `emSign ECC Root CA - G3` from ca-certificates.
# ensure-base-images.sh keys the cached tier on this file's content, never on
# package state, so a stale bundle leaves the tier only when this file changes:
# raising the floor below is the deliberate way to force every tier and leaf
# to rebuild. Both checks fail the build so a stale apt mirror cannot quietly
# reinstate the removed root in an image that otherwise looks fresh. LIBLZMA5_MIN
# pins the same week's USN-8945-1 (XZ Utils: crafted archives could run code).
RUN set -eux; \
    have="$(dpkg-query -W -f='${Version}' ca-certificates)"; \
    dpkg --compare-versions "$have" ge "$CA_CERTIFICATES_MIN" \
      || { echo "ca-certificates $have is older than $CA_CERTIFICATES_MIN (USN-8944-1)" >&2; exit 1; }; \
    have="$(dpkg-query -W -f='${Version}' liblzma5)"; \
    dpkg --compare-versions "$have" ge "$LIBLZMA5_MIN" \
      || { echo "liblzma5 $have is older than $LIBLZMA5_MIN (USN-8945-1)" >&2; exit 1; }; \
    if [ -n "$(find /etc/ssl/certs -maxdepth 1 -iname '*emSign_ECC_Root_CA_-_G3*' -print -quit)" ]; then \
      echo "distrusted emSign ECC Root CA - G3 is still installed in /etc/ssl/certs" >&2; exit 1; \
    fi

COPY --from=git-builder ${GIT_PREFIX} ${GIT_PREFIX}

# ENV PATH below only reaches docker-run contexts. microVM guests get a
# hardcoded PATH from the host/runtime spawn paths (g5d-host assignment,
# guest boot environment, agent runner) that Docker ENV never touches, and several
# runtime paths reset PATH to the same fixed set — so git must also be
# reachable via /usr/local/bin ([D19]; guest verify failure, deploy build
# adb31a26). git resolves its helper exec-path from its compiled-in prefix,
# not argv[0], so symlinks are safe.
RUN set -eux; \
    for tool in "${GIT_PREFIX}"/bin/*; do \
        ln -s "$tool" "/usr/local/bin/$(basename "$tool")"; \
    done; \
    env -i /usr/local/bin/git --version

ENV PATH="${GIT_PREFIX}/bin:${PATH}"

# Build-time gate ([D19]): the image must fail to build rather than ship a git
# that is the wrong version, that is missing, or that still depends on perl.
# Descendant images inherit this git and must not install the distro `git`.
RUN set -eux; \
    command -v git; \
    git --version; \
    git --version | grep -qF "git version ${GIT_VERSION}"; \
    # The distribution git must not be installed: it Depends on perl and
    # liberror-perl, so its presence would defeat this image's whole purpose.
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: the distribution git package is installed" >&2; exit 1; \
    fi; \
    # The FULL perl must be absent ([D19]): the NO_PERL git needs no perl, and no
    # runtime lib above pulls it. Essential `perl-base` is allowed (see the note
    # on the apt layer above — removing it takes debconf with it and breaks apt).
    # A descendant that installs build-essential would reacquire the full perl
    # via dpkg-dev→libdpkg-perl, so the tiers install the compiler subset
    # (gcc/g++/make/libc6-dev) instead and carry this same gate.
    for pkg in perl dpkg-dev libdpkg-perl liberror-perl; do \
        if dpkg-query -W -f='${Status}' "$pkg" 2>/dev/null | grep -q 'install ok installed'; then \
            echo "FATAL: package $pkg is installed; only Essential perl-base may remain" >&2; exit 1; \
        fi; \
    done; \
    # `perl-modules-5.NN` and `libperl5.NN` carry the perl minor version, so a
    # hard-coded name stops matching the moment the base moves to a newer perl
    # series — the gate would keep reporting success while the full perl was
    # present. Match the family instead of a pinned version. `perl-base` is the
    # one allowed member and is unversioned, so it never matches these patterns.
    bad="$(dpkg-query -W -f='${Package} ${Status}\n' 2>/dev/null \
             | awk '$NF == "installed" && ($1 ~ /^perl-modules-/ || $1 ~ /^libperl[0-9]/) { print $1 }')"; \
    if [ -n "$bad" ]; then \
        echo "FATAL: versioned perl package(s) installed: $bad" >&2; exit 1; \
    fi; \
    # The perl porcelain must be non-functional. NO_PERL replaces each with an
    # `unimplemented.sh` stub that exits 128, so every invocation must fail.
    for sub in svn send-email cvsimport cvsexportcommit archimport instaweb; do \
        if git "$sub" </dev/null >/dev/null 2>&1; then \
            echo "FATAL: git $sub succeeded; this image must ship perl-free git" >&2; \
            exit 1; \
        fi; \
    done; \
    # Prove the C builtins that replaced perl implementations actually work,
    # by exercising them in a real repository rather than reading a man page.
    probe="$(mktemp -d)"; cd "$probe"; \
    git init -q .; \
    git -c user.email=build@g5 -c user.name=build commit -q --allow-empty -m probe; \
    git bisect start >/dev/null; \
    git bisect reset >/dev/null; \
    git submodule status >/dev/null; \
    git -c user.email=build@g5 -c user.name=build rebase HEAD >/dev/null; \
    # add -p is builtin C since git 2.37 (test_contract D1 names it): prove it
    # actually stages a hunk non-interactively rather than trusting the docs.
    echo probe > probe.txt; git add probe.txt; \
    git -c user.email=build@g5 -c user.name=build commit -qm probe2; \
    echo changed > probe.txt; \
    printf 'y\n' | git add -p probe.txt >/dev/null; \
    git diff --cached --quiet && { echo "FATAL: git add -p staged nothing" >&2; exit 1; } || true; \
    git diff --cached --name-only | grep -q probe.txt; \
    cd /; rm -rf "$probe"

CMD ["/bin/bash"]
