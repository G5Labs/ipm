# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.g5-api — G5 API Server
# Multi-stage build: Rust builder → slim runtime
# Target: slim runtime for the API server, repair-aware migrator, and g5d CLI
# Platforms: linux/amd64, linux/arm64
# =============================================================================

# --- Stage 1: Build ---
# Rust toolchain tier + baked workspace-dependency sccache
# (integration-stack/docker_images [D18]/[D20]); replaces rust:1.93-bookworm.
# Binaries built here link glibc 2.43 and are copied onto the g5/base:26.04
# runtime below (same glibc). Declared as GLOBAL ARGs before the first FROM so
# the runtime stage's `FROM ${RUNTIME_BASE_IMAGE}` also picks up its default —
# an ARG declared only before the SECOND FROM does not supply one, and the
# build fails with "base name should not be blank".
ARG BUILDER_BASE_IMAGE=g5/base-rust-warm:26.04
ARG RUNTIME_BASE_IMAGE=g5/base:26.04
FROM ${BUILDER_BASE_IMAGE} AS builder

WORKDIR /build
ARG G5D_BUILD_FEATURE_FLAGS=""
ARG G5_CARGO_PROFILE=release
ARG G5_DOCKER_CARGO_BUILD_JOBS=2

# Keep compiler/linker concurrency independent of the worker's CPU count.
# The workspace .cargo/config.toml is dev-specific and is not copied here.
ENV CARGO_BUILD_JOBS="${G5_DOCKER_CARGO_BUILD_JOBS}"

# GCS-backed sccache (integration-stack/docker_images D17). Gated on a
# non-empty SCCACHE_GCS_BUCKET: empty (the default) leaves this build
# operationally equivalent with caching disabled — no wrapper, no binary,
# inert scaffolding only. Fail-open by design: an unreachable bucket
# only slows the compile, never fails or alters it. Auth: the pipeline
# passes SCCACHE_GCS_CREDENTIALS_URL (a token shim on the cloudbuild
# network serving the BUILD SA's token in TaskCluster format) because the
# host-net metadata server serves the worker VM's untrusted identity, not
# the build SA (proven: canary aefb0909). No keys ever enter the build.
# The binary is a pinned prebuilt
# release — never `cargo install` (its own cold compile + MSRV-drift risk).
ARG SCCACHE_GCS_BUCKET=""
ARG SCCACHE_GCS_CREDENTIALS_URL=""
ARG SCCACHE_GCS_KEY_PREFIX="sccache/deploy"
# sccache itself is INHERITED from the base-rust tier (pinned v0.17,
# sha256-verified at tier build, first on PATH at /usr/local/cargo/bin) — this
# leaf no longer downloads its own copy, so deploys carry no GitHub-release
# dependency here and the preflight below always exercises the exact tier
# binary the warm cache was cooked with ([D18]/[D20]).
# No global RUSTC_WRAPPER: sccache_preflight runs immediately before EVERY
# cargo invocation (a server healthy at one build can die before the next)
# and enables the wrapper only after a STRICT `sccache --start-server`
# succeeds, preceded by a stop so the start always re-validates the backend.
# Strictness is load-bearing, empirically proven 2026-08-17: v0.17 validates
# GCS only on explicit --start-server; client autostart (e.g. --show-stats)
# is lenient, and a compile through sccache with a bad backend then FAILS
# (request-time is fail-closed, not fail-open). The visible --show-stats at
# the top of each preflight also brackets every invocation in the logs.
# Degraded-mode cost: each failed strict start waits ~10s, then compiles
# uncached — slow-but-green, never red.
ENV SCCACHE_GCS_BUCKET="${SCCACHE_GCS_BUCKET}"
ENV SCCACHE_GCS_CREDENTIALS_URL="${SCCACHE_GCS_CREDENTIALS_URL}"
ENV SCCACHE_GCS_KEY_PREFIX="${SCCACHE_GCS_KEY_PREFIX}"
ENV SCCACHE_GCS_RW_MODE="READ_WRITE"
ENV SCCACHE_IDLE_TIMEOUT="0"
ENV SCCACHE_IGNORE_SERVER_IO_ERROR="1"
# Deliberately NOT setting CARGO_INCREMENTAL here: cargo treats ANY set value
# other than "1" (including empty) as forced-off, so an unconditional env
# would break the incremental g5-dev-profile builds local docker-compose
# uses. Deploy/release build the release profile, which is non-incremental
# by default — exactly what sccache requires. Do not combine a non-empty
# SCCACHE_GCS_BUCKET with an incremental profile; sccache rejects
# incremental compilation (cloudbuild_workspace_hides_baked_cargo_home).

# Install source-independent build dependencies.
RUN apt-get update && apt-get install -y --no-install-recommends \
    pkg-config libssl-dev cmake \
    && rm -rf /var/lib/apt/lists/*

# Enable SQLx offline mode (no live database needed at compile time)
ENV SQLX_OFFLINE=true
ENV SQLX_CLI_VERSION="=0.8.6"

# Cache dependencies: copy only manifests first
COPY Cargo.toml Cargo.lock ./
COPY .sqlx/ .sqlx/
COPY backend/g5-contracts/Cargo.toml backend/g5-contracts/Cargo.toml
COPY backend/g5-auth/Cargo.toml backend/g5-auth/Cargo.toml
COPY backend/g5-storage/Cargo.toml backend/g5-storage/Cargo.toml
COPY backend/g5-semantic/Cargo.toml backend/g5-semantic/Cargo.toml
COPY backend/g5-scm/Cargo.toml backend/g5-scm/Cargo.toml
COPY backend/g5-internal-api/Cargo.toml backend/g5-internal-api/Cargo.toml
COPY backend/g5-authz/Cargo.toml backend/g5-authz/Cargo.toml
COPY backend/g5-api-foundation/Cargo.toml backend/g5-api-foundation/Cargo.toml
COPY backend/g5-api-data/Cargo.toml backend/g5-api-data/Cargo.toml
COPY backend/g5-api-core/Cargo.toml backend/g5-api-core/Cargo.toml
COPY backend/g5-api-routes/Cargo.toml backend/g5-api-routes/Cargo.toml
COPY backend/g5-api/Cargo.toml backend/g5-api/Cargo.toml
COPY backend/g5d-foundation/Cargo.toml backend/g5d-foundation/Cargo.toml
COPY backend/g5d-isolation/Cargo.toml backend/g5d-isolation/Cargo.toml
COPY backend/g5d-agent/Cargo.toml backend/g5d-agent/Cargo.toml
COPY backend/g5d-host/Cargo.toml backend/g5d-host/Cargo.toml
COPY backend/g5d-dispatch/Cargo.toml backend/g5d-dispatch/Cargo.toml
COPY backend/g5d/Cargo.toml backend/g5d/Cargo.toml
COPY tests/e2e/Cargo.toml tests/e2e/Cargo.toml
# Every workspace member's manifest must be present or cargo refuses to load
# the workspace (scripts/check-layout.py enforces this list).
COPY tools/fake-provider-cli/Cargo.toml tools/fake-provider-cli/Cargo.toml

# Create dummy source files to build dependencies
RUN mkdir -p backend/g5-contracts/src backend/g5-auth/src backend/g5-storage/src backend/g5-semantic/src backend/g5-scm/src backend/g5-internal-api/src backend/g5-authz/src backend/g5-api-foundation/src backend/g5-api-data/src backend/g5-api-core/src backend/g5-api-routes/src backend/g5-api/src backend/g5d-foundation/src backend/g5d-isolation/src backend/g5d-agent/src backend/g5d-host/src backend/g5d-dispatch/src backend/g5d/src tests/e2e/src tools/fake-provider-cli/src/bin && \
    echo "fn main() {}" > backend/g5-api/src/main.rs && \
    mkdir -p backend/g5-api/tests && printf '' > backend/g5-api/tests/main.rs && \
    echo "fn main() {}" > backend/g5d/src/main.rs && \
    echo "fn main() {}" > tests/e2e/src/main.rs && \
    echo "" > backend/g5-contracts/src/lib.rs && \
    echo "" > backend/g5-auth/src/lib.rs && \
    echo "" > backend/g5-storage/src/lib.rs && \
    echo "" > backend/g5-semantic/src/lib.rs && \
    echo "" > backend/g5-scm/src/lib.rs && \
    echo "" > backend/g5-internal-api/src/lib.rs && \
    echo "" > backend/g5-authz/src/lib.rs && \
    echo "" > backend/g5-api-foundation/src/lib.rs && \
    echo "" > backend/g5-api-data/src/lib.rs && \
    echo "" > backend/g5-api-core/src/lib.rs && \
    echo "" > backend/g5-api-routes/src/lib.rs && \
    echo "" > backend/g5d-foundation/src/lib.rs && \
    echo "" > backend/g5d-isolation/src/lib.rs && \
    echo "" > backend/g5d-agent/src/lib.rs && \
    echo "" > backend/g5d-host/src/lib.rs && \
    echo "" > backend/g5d-dispatch/src/lib.rs && \
    echo "" > tools/fake-provider-cli/src/lib.rs && \
    echo "fn main() {}" > tools/fake-provider-cli/src/bin/fake-claude.rs && \
    echo "fn main() {}" > tools/fake-provider-cli/src/bin/fake-codex.rs && \
    echo "fn main() {}" > tools/fake-provider-cli/src/bin/fake-g5-tools.rs

# Build dependencies only (cached layer)
RUN --mount=type=cache,id=cargo-reg-api,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-target-g5-api-build,target=/build/target,sharing=locked \
    sccache_preflight() { \
        export RUSTC_WRAPPER=; \
        command -v sccache >/dev/null 2>&1 || return 0; \
        if [ -n "$SCCACHE_GCS_BUCKET" ]; then \
            sccache --show-stats 2>/dev/null || true; \
            sccache --stop-server >/dev/null 2>&1 || true; \
            if sccache --start-server >/dev/null 2>&1; then \
                export RUSTC_WRAPPER=sccache CARGO_INCREMENTAL=0; \
            else \
                echo "WARN: sccache backend unavailable; compiling uncached"; \
            fi; \
        elif [ -n "$(find "${SCCACHE_DIR:-/opt/g5-sccache}" -type f -print -quit 2>/dev/null)" ]; then \
            # No GCS bucket but the base-rust-warm tier baked a local object \
            # cache: arm the disk backend so local dev-up/ci image builds hit \
            # the warmed dependencies (docker_images [D20]) instead of \
            # compiling cold. Fail-soft like the GCS path. \
            sccache --stop-server >/dev/null 2>&1 || true; \
            if sccache --start-server >/dev/null 2>&1; then \
                export RUSTC_WRAPPER=sccache CARGO_INCREMENTAL=0; \
            fi; \
        fi; \
    } && \
    sccache_preflight && \
    cargo build --profile "$G5_CARGO_PROFILE" -p g5-api 2>/dev/null || true

# Remove placeholder crate trees before copying real sources so deleted files
# do not linger across cached local rebuilds.
RUN rm -rf backend/g5-contracts backend/g5-auth backend/g5-storage backend/g5-semantic backend/g5-scm backend/g5-internal-api backend/g5-authz backend/g5-api-foundation backend/g5-api-data backend/g5-api-core backend/g5-api-routes backend/g5-api backend/g5d-foundation backend/g5d-isolation backend/g5d-agent backend/g5d-host backend/g5d-dispatch backend/g5d tools/fake-provider-cli

# Copy actual source code
COPY backend/g5-contracts/ backend/g5-contracts/
COPY backend/g5-auth/ backend/g5-auth/
COPY backend/g5-storage/ backend/g5-storage/
COPY backend/g5-semantic/ backend/g5-semantic/
COPY backend/g5-scm/ backend/g5-scm/
COPY backend/g5-internal-api/ backend/g5-internal-api/
COPY backend/g5-authz/ backend/g5-authz/
COPY backend/g5-api-foundation/ backend/g5-api-foundation/
COPY backend/g5-api-data/ backend/g5-api-data/
COPY backend/g5-api-core/ backend/g5-api-core/
COPY backend/g5-api-routes/ backend/g5-api-routes/
COPY backend/g5-api/ backend/g5-api/
COPY backend/g5d-foundation/ backend/g5d-foundation/
COPY backend/g5d-isolation/ backend/g5d-isolation/
COPY backend/g5d-agent/ backend/g5d-agent/
COPY backend/g5d-host/ backend/g5d-host/
COPY backend/g5d-dispatch/ backend/g5d-dispatch/
COPY backend/g5d/ backend/g5d/
COPY tools/fake-provider-cli/ tools/fake-provider-cli/
# g5-contracts and the fakes embed the provider CLI pins at build time
# (`include_str!` of the single-source pin files), so the builder needs them.
COPY scripts/claude-code-cli-version scripts/codex-cli-version scripts/

# Touch source files to invalidate the dummy builds
RUN touch backend/g5-contracts/src/lib.rs backend/g5-auth/src/lib.rs backend/g5-storage/src/lib.rs backend/g5-semantic/src/lib.rs backend/g5-scm/src/lib.rs backend/g5-authz/src/lib.rs backend/g5-api-foundation/src/lib.rs backend/g5-api-data/src/lib.rs backend/g5-api-core/src/lib.rs backend/g5-api-routes/src/lib.rs backend/g5-api/src/main.rs backend/g5d-foundation/src/lib.rs backend/g5d-isolation/src/lib.rs backend/g5d-agent/src/lib.rs backend/g5d-host/src/lib.rs backend/g5d-dispatch/src/lib.rs backend/g5d/src/main.rs

# Build the actual binaries. g5-api always builds with its normal feature
# profile; g5d uses the feature flags selected for this image build.
RUN --mount=type=cache,id=cargo-reg-api,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-target-g5-api-build,target=/build/target,sharing=locked \
    sccache_preflight() { \
        export RUSTC_WRAPPER=; \
        command -v sccache >/dev/null 2>&1 || return 0; \
        if [ -n "$SCCACHE_GCS_BUCKET" ]; then \
            sccache --show-stats 2>/dev/null || true; \
            sccache --stop-server >/dev/null 2>&1 || true; \
            if sccache --start-server >/dev/null 2>&1; then \
                export RUSTC_WRAPPER=sccache CARGO_INCREMENTAL=0; \
            else \
                echo "WARN: sccache backend unavailable; compiling uncached"; \
            fi; \
        elif [ -n "$(find "${SCCACHE_DIR:-/opt/g5-sccache}" -type f -print -quit 2>/dev/null)" ]; then \
            # No GCS bucket but the base-rust-warm tier baked a local object \
            # cache: arm the disk backend so local dev-up/ci image builds hit \
            # the warmed dependencies (docker_images [D20]) instead of \
            # compiling cold. Fail-soft like the GCS path. \
            sccache --stop-server >/dev/null 2>&1 || true; \
            if sccache --start-server >/dev/null 2>&1; then \
                export RUSTC_WRAPPER=sccache CARGO_INCREMENTAL=0; \
            fi; \
        fi; \
    } && \
    sccache_preflight && \
    cargo build --profile "$G5_CARGO_PROFILE" -p g5-api --bins && \
    sccache_preflight && \
    cargo build --profile "$G5_CARGO_PROFILE" -p g5d ${G5D_BUILD_FEATURE_FLAGS} && \
    (sccache --show-stats 2>/dev/null || true) && \
    cp "/build/target/${G5_CARGO_PROFILE}/g5-api" /usr/local/bin/g5-api && \
    cp "/build/target/${G5_CARGO_PROFILE}/g5-db-migrate" /usr/local/bin/g5-db-migrate && \
    cp "/build/target/${G5_CARGO_PROFILE}/g5d" /usr/local/bin/g5d && \
    echo "g5-api binary size: $(stat -c%s /usr/local/bin/g5-api) bytes" && \
    echo "g5-db-migrate binary size: $(stat -c%s /usr/local/bin/g5-db-migrate) bytes" && \
    echo "g5d binary size: $(stat -c%s /usr/local/bin/g5d) bytes"

# Install sqlx-cli for local/admin fallback migration commands.
# Pinned to the workspace `sqlx` version (0.8.6) so the migration tool
# tracks the library, and an unpinned install can't drift onto a release
# with a newer rustc MSRV than this build image.
RUN --mount=type=cache,id=cargo-reg-api,target=/usr/local/cargo/registry \
    --mount=type=cache,id=cargo-target-api-tools,target=/build/target,sharing=locked \
    sccache_preflight() { \
        export RUSTC_WRAPPER=; \
        command -v sccache >/dev/null 2>&1 || return 0; \
        if [ -n "$SCCACHE_GCS_BUCKET" ]; then \
            sccache --show-stats 2>/dev/null || true; \
            sccache --stop-server >/dev/null 2>&1 || true; \
            if sccache --start-server >/dev/null 2>&1; then \
                export RUSTC_WRAPPER=sccache CARGO_INCREMENTAL=0; \
            else \
                echo "WARN: sccache backend unavailable; compiling uncached"; \
            fi; \
        elif [ -n "$(find "${SCCACHE_DIR:-/opt/g5-sccache}" -type f -print -quit 2>/dev/null)" ]; then \
            # No GCS bucket but the base-rust-warm tier baked a local object \
            # cache: arm the disk backend so local dev-up/ci image builds hit \
            # the warmed dependencies (docker_images [D20]) instead of \
            # compiling cold. Fail-soft like the GCS path. \
            sccache --stop-server >/dev/null 2>&1 || true; \
            if sccache --start-server >/dev/null 2>&1; then \
                export RUSTC_WRAPPER=sccache CARGO_INCREMENTAL=0; \
            fi; \
        fi; \
    } && \
    sccache_preflight && \
    cargo install sqlx-cli --version "$SQLX_CLI_VERSION" --locked --no-default-features --features postgres,rustls --root /usr/local

# --- Stage 2: Runtime ---
# Runtime on the shared common base ([D18]) instead of a second distribution
# image. git is inherited perl-free from that base ([D19]) and must NOT be
# re-installed via apt. The OpenSSL runtime package is the Ubuntu 26.04 t64
# name (libssl3t64), not Debian's libssl3.
FROM ${RUNTIME_BASE_IMAGE}

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3t64 libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Inherited-git guard ([D19] / test_contract D1): fail the build if anything in
# this stage's apt set reintroduced the distribution git (its perl chain) over
# the base's perl-free build.
RUN set -eux; \
    git --version; \
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: this image reinstalled the distribution git package" >&2; exit 1; \
    fi

# Copy binaries
COPY --from=builder /usr/local/bin/g5-api /usr/local/bin/g5-api
COPY --from=builder /usr/local/bin/g5-db-migrate /usr/local/bin/g5-db-migrate
COPY --from=builder /usr/local/bin/g5d /usr/local/bin/g5d
COPY --from=builder /usr/local/bin/sqlx /usr/local/bin/sqlx

# Copy database migrations
COPY backend/g5-api/src/db/migrations/ /app/migrations/

# Copy entrypoint script (runs file-based migrations before starting g5-api)
COPY infra/docker/entrypoint-api.sh /app/entrypoint-api.sh

# Copy sqlx offline data
COPY .sqlx/ /app/.sqlx/

WORKDIR /app

# Non-root user plus a filestore-style shared repo root.
# Pin the UID/GID so control-plane pods and shared Filestore dirs keep a stable
# ownership contract across rebuilds and rollouts.
# `/data/repos` stays as a compatibility symlink for seed helpers and legacy
# file URLs that still point at the shared repo tree.
RUN groupadd -g 10001 g5 && useradd -u 10001 -g g5 -d /app g5 && \
    mkdir -p /data && \
    mkdir -p /mnt/g5-repos/repos && \
    chown -R g5:g5 /mnt/g5-repos && \
    ln -s /mnt/g5-repos/repos /data/repos
USER g5

EXPOSE 7500

# Healthcheck via /healthz endpoint
HEALTHCHECK --interval=5s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:7500/healthz || exit 1

ENV RUST_LOG=info
ENV LISTEN_ADDR=0.0.0.0:7500

ENTRYPOINT ["/app/entrypoint-api.sh"]
