# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.g5-api-prebuilt — CI runtime packaging for prebuilt API artifacts
# =============================================================================
# This Dockerfile intentionally contains no Rust toolchain and no release
# compile. Cloud CI builds backend/g5-api/g5d/sqlx once in a Rust step, then uses this
# Dockerfile to validate the slim runtime image packaging.
# =============================================================================

# Runtime on the common base (integration-stack/docker_images [D18], [D4]);
# replaces debian:bookworm-slim so this prebuilt runtime matches its source-built
# sibling's shape ([D13]). git and ca-certificates come from the common base —
# git is the perl-free build of [D19] and is not re-installed via apt; the
# OpenSSL runtime package is the Ubuntu 26.04 t64 name (libssl3t64).
ARG RUNTIME_BASE_IMAGE=g5/base:26.04
FROM ${RUNTIME_BASE_IMAGE} AS runtime-base

RUN apt-get update && apt-get install -y --no-install-recommends \
    libssl3t64 libpq5 curl \
    && rm -rf /var/lib/apt/lists/*

# Inherited-git guard ([D19] / test_contract D1): fail the build if anything in
# this stage's apt set reintroduced the distribution git (its perl chain) over
# the base's perl-free build.
RUN set -eux; \
    git --version; \
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: this image reinstalled the distribution git package" >&2; exit 1; \
    fi

COPY backend/g5-api/src/db/migrations/ /app/migrations/
COPY infra/docker/entrypoint-api.sh /app/entrypoint-api.sh
COPY .sqlx/ /app/.sqlx/

WORKDIR /app

RUN groupadd -g 10001 g5 && useradd -u 10001 -g g5 -d /app g5 && \
    mkdir -p /data && \
    mkdir -p /mnt/g5-repos/repos && \
    chown -R g5:g5 /mnt/g5-repos && \
    ln -s /mnt/g5-repos/repos /data/repos
USER g5

EXPOSE 7500

HEALTHCHECK --interval=5s --timeout=5s --retries=3 \
    CMD curl -f http://localhost:7500/healthz || exit 1

ENV RUST_LOG=info
ENV LISTEN_ADDR=0.0.0.0:7500

FROM runtime-base AS runtime

USER root
COPY .ci-release-artifacts/api/g5-api /usr/local/bin/g5-api
COPY .ci-release-artifacts/api/g5d /usr/local/bin/g5d
COPY .ci-release-artifacts/api/sqlx /usr/local/bin/sqlx
RUN chmod 0555 /usr/local/bin/g5-api /usr/local/bin/g5d /usr/local/bin/sqlx && \
    ldd /usr/local/bin/g5d | tee /tmp/g5d.ldd && \
    ! grep -E 'libkrunfw\.so|libkrun\.so|not found' /tmp/g5d.ldd
USER g5

ENTRYPOINT ["/app/entrypoint-api.sh"]
