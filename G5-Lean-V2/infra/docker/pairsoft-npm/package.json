{
  "name": "procurement",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve --port 4201 ",
    "start:local": "ng serve --port 4201 --configuration=local --proxy-config proxy.conf.local.json",
    "build": "npm run checkall && ng build",
    "build-docker": "ng build --configuration docker",
    "build-docker-production": "ng build --configuration production",
    "build-docker-sourcemap": "ng build --configuration docker --source-map=true",
    "watch": "ng build --watch --configuration development",
    "test": "node scripts/run-with-ci-cache.js ng test",
    "checkall": "npm run checktabs && npm run checkglclearbuttons && npm run checkundefinedcollections && npm run checkgridkeys && npm run checkpendotags",
    "pretest": "npm run checkall",
    "pretest:ci": "npm run checkall",
    "precodecoveragereport": "npm run checkall",
    "checktabs": "node scripts/check-tabitem-visible.js",
    "checkglclearbuttons": "node scripts/check-field-customization-clear-buttons.test.js && node scripts/check-field-customization-clear-buttons.js",
    "checkundefinedcollections": "node scripts/check-undefined-collections.test.js && node scripts/check-undefined-collections.js",
    "checkgridkeys": "node scripts/check-grid-keys.test.js && node scripts/check-grid-keys.js",
    "checkpendotags": "node scripts/check-pendo-tags.test.js && node scripts/check-pendo-tags.js",
    "testwithcodecoverage": "node scripts/run-with-ci-cache.js ng test --code-coverage",
    "codecoveragereport": "node scripts/run-with-ci-cache.js ng test --watch=false --browsers=ChromeHeadlessNoSandbox --code-coverage=true",
    "test:ci": "node scripts/run-with-ci-cache.js ng test --watch=false --browsers=ChromeHeadless"
  },
