# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.validation-metadata — offline `cargo metadata` for local validation
# =============================================================================
# The preflight audits (check-layout, check-just-commands, test_ci_docker_contract,
# test_validation_review) and selector narrowing need `cargo metadata --no-deps`
# to enumerate the workspace. scripts/workspace_metadata.py runs that on the host
# when a toolchain is present and otherwise inside this image, so `just docker-ci`
# works on a fresh Docker-capable host with no host Rust (G5-Lean#355). The image
# builds once (the only step that needs the network); metadata then runs with
# `--network none` and the checkout mounted read-only.
#
# Single external base (base_image_consolidation [D2], docker_images [D18]): like
# Dockerfile.base-rust, it builds on the fleet's pinned ubuntu:26.04 and installs
# the toolchain via rustup rather than pulling a second distribution base. It
# derives from ubuntu — not g5/base-rust — because it is a Phase 0 preflight tool
# that must build before any g5/base* tier exists.
#
# Deliberately tiny: `cargo metadata --no-deps` only parses manifests, so no C
# toolchain, no project dependencies, and no build state are needed.
# =============================================================================

# Pinned fleet base — identical digest to Dockerfile.base's UBUNTU_BASE.
ARG UBUNTU_BASE=ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b
FROM ${UBUNTU_BASE}

ENV DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH

# Pinned to match the fleet (Dockerfile.base-rust RUST_VERSION). `cargo metadata`
# is version-agnostic, but pinning keeps this runner on the one reviewed toolchain.
ARG RUST_VERSION=1.97.1

RUN apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates \
    curl \
    && rm -rf /var/lib/apt/lists/*

ENV RUSTUP_HOME=/usr/local/rustup
ENV CARGO_HOME=/usr/local/cargo
ENV PATH="/usr/local/cargo/bin:${PATH}"

# rustup comes as the pinned rustup-init BINARY with per-arch sha256 from
# static.rust-lang.org ([D18]: pinned, checksum-verified), mirroring
# Dockerfile.base-rust. `--profile minimal`: metadata needs only rustc/cargo.
ARG RUSTUP_VERSION=1.29.0
ARG RUSTUP_SHA256_X86_64=4acc9acc76d5079515b46346a485974457b5a79893cfb01112423c89aeb5aa10
ARG RUSTUP_SHA256_AARCH64=9732d6c5e2a098d3521fca8145d826ae0aaa067ef2385ead08e6feac88fa5792
RUN set -eux; \
    RTARGET="$(case "${TARGETARCH:-$(uname -m)}" in arm64|aarch64) echo aarch64-unknown-linux-gnu ;; *) echo x86_64-unknown-linux-gnu ;; esac)"; \
    case "$RTARGET" in \
      aarch64-*) RUSTUP_SHA256="${RUSTUP_SHA256_AARCH64}" ;; \
      *)         RUSTUP_SHA256="${RUSTUP_SHA256_X86_64}" ;; \
    esac; \
    curl -fsSLo /tmp/rustup-init "https://static.rust-lang.org/rustup/archive/${RUSTUP_VERSION}/${RTARGET}/rustup-init"; \
    echo "${RUSTUP_SHA256}  /tmp/rustup-init" | sha256sum -c -; \
    chmod +x /tmp/rustup-init; \
    retry() { n=0; until "$@"; do n=$((n+1)); if [ "$n" -ge 5 ]; then return 1; fi; echo "attempt $n/5 failed: $*; retrying in $((n*10))s" >&2; sleep $((n*10)); done; }; \
    export RUSTUP_MAX_RETRIES=10; \
    retry /tmp/rustup-init -y --default-toolchain "${RUST_VERSION}" --profile minimal; \
    rm -f /tmp/rustup-init

# Build-time gate: assert the pinned toolchain installed and runs.
RUN rustc --version | grep -qF "${RUST_VERSION}" \
    && cargo --version | grep -qF "${RUST_VERSION}"

# Commands run against the read-only checkout mounted here.
WORKDIR /src
