ARG PLAYWRIGHT_BASE_IMAGE=mcr.microsoft.com/playwright:v1.58.2-noble@sha256:6446946a1d9fd62d9ae501312a2d76a43ee688542b21622056a372959b65d63d
FROM ${PLAYWRIGHT_BASE_IMAGE}

ENV CI=true \
    NODE_ENV=test \
    PLAYWRIGHT_BROWSERS_PATH=/ms-playwright \
    PLAYWRIGHT_SKIP_BROWSER_DOWNLOAD=1

# Docker CLI (client only; cloudbuild shares the host docker socket with every
# step) and unzip. Required by the remote-tracking E2E fixture
# (tests/e2e/fixtures/remote-repo-server.ts), which drives the REAL git remote inside
# the API container via `docker exec <api> git …` for the D42–D44
# push/import/diverge scenarios, and by archive-download assertions that use
# `unzip -p` to verify downloaded workspace contents. The Docker CLI install
# matches Dockerfile.ci-builder.
RUN apt-get update \
    && apt-get install -y --no-install-recommends docker.io unzip \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /opt/g5-playwright-client

COPY frontend/package.json frontend/package-lock.json ./

RUN npm ci --prefer-offline && npm cache clean --force

WORKDIR /workspace
