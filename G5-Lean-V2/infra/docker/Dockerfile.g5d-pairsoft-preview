# syntax=docker/dockerfile:1
# =============================================================================
# Dockerfile.g5d-pairsoft-preview
#
# PairSoft .NET/Angular runtime for G5 workspace VMs and preview jobs. This
# image is a customer base_image rootfs: G5 binaries are mounted from the
# signed workspace host at /opt/g5/bin, while this image supplies PairSoft's
# language toolchains (.NET 8 + .NET 6 compat, Node 20, Chrome for Testing,
# the baked Pairsoft.Core NuGet feed), the tools PairSoft's own gates run
# with (PowerShell 7.4, sqlcmd, Playwright Chromium) and the local-development
# process tools a preview profile may start inside the microVM (Azure
# Functions Core Tools, Azurite, serve, Docker Engine + Compose for SQL
# Server / Redis / the Event Hubs emulator, baked npm dependency caches).
# Azure App Configuration has no emulator; the PairSoft workspace's
# `.g5/preview/` shims run an in-guest stub for it.
#
# This is the single PairSoft image: the former g5d-pairsoft-dotnet test
# runtime was folded in here because every published artifact was already a
# superset of it.
# =============================================================================

# Common base ([D18]/[D19] integration-stack/docker_images): perl-free git,
# Ubuntu 26.04 (glibc 2.43). This guest rootfs sits above the host-mounted g5d
# ABI floor (build old / run new — microvm_execution_boundary [D12]). The vendor
# .NET SDK image previously supplied the 8.0.403 SDK; both the 8.0.403 SDK and
# the .NET 6 compat SDK are now installed onto the common base from Microsoft's
# pinned dotnet-install.sh source ([D18]).
ARG BASE_IMAGE=g5/base:26.04
FROM ${BASE_IMAGE}

ARG DOTNET_8_SDK_VERSION=8.0.403
ARG DOTNET_6_SDK_VERSION=6.0.428
ARG NODE_VERSION=20.20.2
ARG NODE_SHA256=df770b2a6f130ed8627c9782c988fda9669fa23898329a61a871e32f965e007d
ARG CHROME_FOR_TESTING_VERSION=150.0.7871.24
ARG CHROME_FOR_TESTING_SHA256=e0dd5721ae87fc74322b370e74f815c146357ebe42af176f8eee3f788b2ec01d
ARG CHROMEDRIVER_SHA256=47d1ccd914fe37806f42cddf34e423575c68ac6d072d9a5d1cf19bdc1035f243
ARG AZURE_FUNCTIONS_CORE_TOOLS_VERSION=4.12.1
ARG AZURITE_VERSION=3.35.0
ARG SERVE_VERSION=14.2.5
# PowerShell 7.4 LTS from the GitHub release tarball (Ubuntu 26.04 has no
# Microsoft apt package); sha256 from the release's hashes.sha256, verified
# against the downloaded archive on 2026-10-29. Every PairSoft gate is a .ps1.
ARG POWERSHELL_VERSION=7.4.22
ARG POWERSHELL_SHA256=9de443bef974f219c98a33b0f4096aace7f30b42188f37a1b14c5da7e82c8a6a
# go-sqlcmd static binary: tools/rebuild-local-database.ps1 and
# run-all-migrations.ps1 need `sqlcmd` on PATH and pass -I / -C, which
# go-sqlcmd accepts. The release ships no checksum file; the sha256 was
# computed from the downloaded archive on 2026-10-29.
ARG SQLCMD_VERSION=1.10.0
ARG SQLCMD_SHA256=92516d98c63d99b0994de5b61350c91f6915f9b76f139a59039fbcb225c2e987
# Playwright pin = PairSoft main e2e/package.json's @playwright/test (the e2e
# seed below); scripts/test_pairsoft_preview_image.py keeps the two equal.
ARG PLAYWRIGHT_VERSION=1.61.1

LABEL org.opencontainers.image.title="G5 PairSoft Platform Preview Runtime" \
      org.opencontainers.image.description="PairSoft microVM base for G5 workspaces and preview jobs with .NET 8.0.403, .NET 6 compatibility, Node 20, Chromium, chromedriver, Playwright Chromium, PowerShell 7.4, sqlcmd, git, baked PairSoftCore NuGet packages, Azure Functions Core Tools, Azurite, serve, Docker Engine + Compose, and baked npm dependency caches" \
      com.g5labs.runtime.schema="v1" \
      com.g5labs.runtime.workload="pairsoft-platform-preview" \
      com.g5labs.runtime.preview="true" \
      com.g5labs.runtime.base_image="ubuntu-26.04-glibc-2.43" \
      com.g5labs.runtime.dotnet.sdk="8.0.403" \
      com.g5labs.runtime.dotnet.compat_sdk="${DOTNET_6_SDK_VERSION}" \
      com.g5labs.runtime.node="${NODE_VERSION}" \
      com.g5labs.runtime.pairsoft.core_packages="2.0.10" \
      com.g5labs.runtime.chrome_for_testing="${CHROME_FOR_TESTING_VERSION}" \
      com.g5labs.runtime.playwright="${PLAYWRIGHT_VERSION}" \
      com.g5labs.runtime.powershell="${POWERSHELL_VERSION}" \
      com.g5labs.runtime.sqlcmd="${SQLCMD_VERSION}" \
      com.g5labs.runtime.azure.functions.core_tools="${AZURE_FUNCTIONS_CORE_TOOLS_VERSION}" \
      com.g5labs.runtime.azurite="${AZURITE_VERSION}" \
      com.g5labs.runtime.serve="${SERVE_VERSION}" \
      com.g5labs.runtime.npm_cache_seed="/opt/pairsoft/npm-cache" \
      com.g5labs.runtime.docker.engine="true" \
      com.g5labs.runtime.kernel.features="netfilter-iptables-required-for-in-guest-dockerd" \
      com.g5labs.runtime.testcontainers.enabled="false" \
      com.g5labs.runtime.external_services="sql-server-redis-azurite-eventhubs-emulator-run-in-guest-docker;app-configuration-stub-required-for-full-platform-preview"

SHELL ["/bin/bash", "-o", "pipefail", "-c"]

USER root

# Keep the image env small. g5d merges OCI config env into microVM launches, so
# large defaults can become boot-path baggage. Tool binaries are placed in
# /usr/local/bin or /usr/bin because the task PATH overrides image PATH.
# RestoreConfigFile is intentionally image-wide: G5 runs unwrapped dotnet
# commands, and PairSoftPlatform's repo config maps Pairsoft.Core* to a private
# Azure feed that this image replaces with the baked local package feed.
# PLAYWRIGHT_BROWSERS_PATH points `npx playwright test` at the baked browsers;
# the guest runtime clears the env for agent turns, so the /home/agent and
# /home/ubuntu default lookup paths are also linked to the bake below.
ENV DOTNET_ROOT=/usr/share/dotnet \
    DOTNET_NOLOGO=1 \
    DOTNET_CLI_TELEMETRY_OPTOUT=1 \
    DOTNET_SKIP_FIRST_TIME_EXPERIENCE=1 \
    DOTNET_CLI_HOME=/work/.dotnet \
    NUGET_PACKAGES=/work/.nuget/packages \
    NUGET_XMLDOC_MODE=skip \
    RestoreConfigFile=/opt/pairsoft/nuget/NuGet.Config \
    POWERSHELL_TELEMETRY_OPTOUT=1 \
    PLAYWRIGHT_BROWSERS_PATH=/opt/ms-playwright \
    CHROME_BIN=/usr/local/bin/chromium \
    LANG=en_US.UTF-8 \
    LC_ALL=en_US.UTF-8

# gettext-base, iproute2 and netcat-openbsd serve the preview profile scripts
# (envsubst templating, port probes); sudo carries the single scoped rule for
# the dockerd starter; bzip2 unpacks the sqlcmd release; liblttng-ust1t64 is
# pwsh's tracepoint provider dependency (Microsoft's own pwsh image ships it;
# readelf on the 7.4.22 tarball, 2026-10-29); the lib set is the
# runtime closure of Chrome for Testing AND Playwright's Chromium line (the
# enumerated set from Dockerfile.g5d-g5dev — `playwright install-deps` is
# unpinned and refuses the 26.04 codename; the ldd gate at the end verifies
# every baked browser binary against this set).
RUN apt-get update \
    && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
        bash \
        bzip2 \
        gcc \
        g++ \
        make \
        libc6-dev \
        ca-certificates \
        curl \
        fontconfig \
        fonts-dejavu-core \
        fonts-liberation \
        fonts-unifont \
        gettext-base \
        iproute2 \
        jq \
        libasound2t64 \
        libatk-bridge2.0-0t64 \
        libatk1.0-0t64 \
        libatspi2.0-0t64 \
        libavahi-client3 \
        libavahi-common3 \
        libcairo2 \
        libcups2t64 \
        libdbus-1-3 \
        libdrm2 \
        libgbm1 \
        libgdiplus \
        libglib2.0-0t64 \
        libgssapi-krb5-2 \
        libgtk-3-0t64 \
        libicu78 \
        liblttng-ust1t64 \
        libnspr4 \
        libnss3 \
        libssl3t64 \
        libpango-1.0-0 \
        libpangocairo-1.0-0 \
        libwayland-server0 \
        libx11-6 \
        libx11-xcb1 \
        libxcb-randr0 \
        libxcb1 \
        libxcomposite1 \
        libxdamage1 \
        libxext6 \
        libxfixes3 \
        libxi6 \
        libxkbcommon0 \
        libxrandr2 \
        libxrender1 \
        libxss1 \
        libxtst6 \
        locales \
        netcat-openbsd \
        procps \
        python3 \
        sudo \
        tar \
        tzdata \
        unzip \
        xz-utils \
        zip \
    && sed -i 's/^# *\(en_US.UTF-8 UTF-8\)/\1/' /etc/locale.gen \
    && locale-gen en_US.UTF-8 \
    && rm -rf /var/lib/apt/lists/*

# Docker Engine + Compose in the guest (docker_images [I32]): PairSoft's
# gates need SQL Server, Redis, Azurite and the Event Hubs emulator as
# containers, and their deploy gate is a compose stack. The installer,
# daemon.json, starter, sudo rule and browser gate are the files shared with
# Dockerfile.g5d-g5dev, not forks.
COPY infra/docker/g5-docker-engine-install.sh /usr/local/share/g5/docker-engine-install.sh
RUN bash /usr/local/share/g5/docker-engine-install.sh

# Node 20 and npm for PairSoft's Angular workspace. node:20 has no noble
# image variant, so install the official upstream tarball directly.
RUN curl -fsSLO "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-x64.tar.xz" \
    && echo "${NODE_SHA256}  node-v${NODE_VERSION}-linux-x64.tar.xz" | sha256sum -c - \
    && tar -xJf "node-v${NODE_VERSION}-linux-x64.tar.xz" -C /usr/local --strip-components=1 --no-same-owner \
    && rm -f "node-v${NODE_VERSION}-linux-x64.tar.xz"

# Ubuntu's chromium package is a snap launcher. Use Chrome for Testing so
# headless browser tests have a real binary and a matching chromedriver.
RUN curl -fsSLo /tmp/chrome-linux64.zip \
        "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_FOR_TESTING_VERSION}/linux64/chrome-linux64.zip" \
    && curl -fsSLo /tmp/chromedriver-linux64.zip \
        "https://storage.googleapis.com/chrome-for-testing-public/${CHROME_FOR_TESTING_VERSION}/linux64/chromedriver-linux64.zip" \
    && echo "${CHROME_FOR_TESTING_SHA256}  /tmp/chrome-linux64.zip" | sha256sum -c - \
    && echo "${CHROMEDRIVER_SHA256}  /tmp/chromedriver-linux64.zip" | sha256sum -c - \
    && mkdir -p /opt/chrome-for-testing \
    && unzip -q /tmp/chrome-linux64.zip -d /opt/chrome-for-testing \
    && unzip -q /tmp/chromedriver-linux64.zip -d /opt/chrome-for-testing \
    && ln -sf /opt/chrome-for-testing/chrome-linux64/chrome /usr/local/bin/chromium \
    && ln -sf /opt/chrome-for-testing/chrome-linux64/chrome /usr/bin/chromium-browser \
    && ln -sf /opt/chrome-for-testing/chromedriver-linux64/chromedriver /usr/local/bin/chromedriver \
    && rm -f /tmp/chrome-linux64.zip /tmp/chromedriver-linux64.zip

# The common base carries no .NET, so both SDKs are installed here from
# Microsoft's pinned dotnet-install.sh ([D18]): the primary 8.0.403 SDK the
# vendor image used to supply, plus the .NET 6 SDK for PairSoft's remaining
# net6.0 projects (its targeting packs + runtimes, without restore-time
# downloads). Both land in DOTNET_ROOT so `dotnet` resolves them side by side.
# The launcher is symlinked into /usr/local/bin immediately so the NuGet-feed
# step below can invoke `dotnet` (the common base puts nothing on PATH for it,
# unlike the vendor SDK image).
RUN curl -fsSL https://dot.net/v1/dotnet-install.sh -o /tmp/dotnet-install.sh \
    && chmod +x /tmp/dotnet-install.sh \
    && /tmp/dotnet-install.sh \
        --version "${DOTNET_8_SDK_VERSION}" \
        --install-dir "${DOTNET_ROOT}" \
        --no-path \
    && /tmp/dotnet-install.sh \
        --version "${DOTNET_6_SDK_VERSION}" \
        --install-dir "${DOTNET_ROOT}" \
        --no-path \
    && rm -f /tmp/dotnet-install.sh \
    && ln -sf "${DOTNET_ROOT}/dotnet" /usr/local/bin/dotnet

COPY infra/docker/pairsoft-core-nuget/ /opt/pairsoft/nuget/

# PairSoftPlatform's repository nuget.config points Pairsoft.Core* at the
# private Azure feed. For G5 tests, use the baked package feed instead.
RUN test "$(find /opt/pairsoft/nuget/feed -maxdepth 1 -name 'Pairsoft.Core*.2.0.10.nupkg' | wc -l)" -eq 13 \
    && dotnet nuget list source --configfile /opt/pairsoft/nuget/NuGet.Config \
    && chmod -R a+rX /opt/pairsoft/nuget

# PowerShell 7.4 LTS, checksum-verified release tarball, with `powershell`
# aliased to it because several PairSoft scripts spawn `powershell`. Both
# launchers live in the task PATH directories (image PATH is overridden).
RUN curl -fsSLo /tmp/powershell.tar.gz \
        "https://github.com/PowerShell/PowerShell/releases/download/v${POWERSHELL_VERSION}/powershell-${POWERSHELL_VERSION}-linux-x64.tar.gz" \
    && echo "${POWERSHELL_SHA256}  /tmp/powershell.tar.gz" | sha256sum -c - \
    && mkdir -p /opt/microsoft/powershell/7 \
    && tar -xzf /tmp/powershell.tar.gz -C /opt/microsoft/powershell/7 --no-same-owner \
    && chmod 0755 /opt/microsoft/powershell/7/pwsh \
    && ln -sf /opt/microsoft/powershell/7/pwsh /usr/local/bin/pwsh \
    && ln -sf /opt/microsoft/powershell/7/pwsh /usr/bin/pwsh \
    && ln -sf /opt/microsoft/powershell/7/pwsh /usr/local/bin/powershell \
    && rm -f /tmp/powershell.tar.gz

# go-sqlcmd, checksum-verified static binary.
RUN curl -fsSLo /tmp/sqlcmd.tar.bz2 \
        "https://github.com/microsoft/go-sqlcmd/releases/download/v${SQLCMD_VERSION}/sqlcmd-linux-amd64.tar.bz2" \
    && echo "${SQLCMD_SHA256}  /tmp/sqlcmd.tar.bz2" | sha256sum -c - \
    && tar -xjf /tmp/sqlcmd.tar.bz2 -C /usr/local/bin sqlcmd \
    && chmod 0755 /usr/local/bin/sqlcmd \
    && ln -sf /usr/local/bin/sqlcmd /usr/bin/sqlcmd \
    && rm -f /tmp/sqlcmd.tar.bz2

# Make launchers resolvable through the G5 task PATH even when the image PATH is
# overridden by task env.
RUN ln -sf /usr/local/lib/node_modules/npm/bin/npm-cli.js /usr/local/bin/npm \
    && ln -sf /usr/local/lib/node_modules/npm/bin/npx-cli.js /usr/local/bin/npx \
    && if [[ -e /usr/local/lib/node_modules/corepack/dist/corepack.js ]]; then \
         ln -sf /usr/local/lib/node_modules/corepack/dist/corepack.js /usr/local/bin/corepack; \
       fi

# Preview profiles may boot Azure Functions hosts and local storage emulation.
# Put launchers in stable task PATH directories because microVM task env can
# override the image PATH. The install is retried: azure-functions-core-tools'
# postinstall (`node lib/install.js`) fetches the Core Tools zip from
# cdn.functions.azure.com outside npm's registry retry budget, and that CDN
# times out transiently (dev deploy 020740f7, 2026-09-01: connect ETIMEDOUT on
# the single attempt). A global reinstall is idempotent — npm replaces the
# partially installed package — and the pinned versions plus the build-time
# asserts below remain the acceptance gates ([D10]).
RUN for attempt in 1 2 3 4 5; do \
      if npm install -g "azure-functions-core-tools@${AZURE_FUNCTIONS_CORE_TOOLS_VERSION}" --unsafe-perm true "azurite@${AZURITE_VERSION}" "serve@${SERVE_VERSION}"; then \
        break; \
      fi; \
      if [ "$attempt" -eq 5 ]; then \
        echo "ERROR: preview tool install failed after ${attempt} attempts" >&2; \
        exit 1; \
      fi; \
      echo "WARN: preview tool install failed (attempt ${attempt}/5); retrying in 15s" >&2; \
      sleep 15; \
    done \
    && ln -sf /usr/local/bin/func /usr/bin/func \
    && ln -sf /usr/local/bin/azurite /usr/bin/azurite \
    && ln -sf /usr/local/bin/azurite-blob /usr/bin/azurite-blob \
    && ln -sf /usr/local/bin/azurite-queue /usr/bin/azurite-queue \
    && ln -sf /usr/local/bin/azurite-table /usr/bin/azurite-table \
    && ln -sf /usr/local/bin/serve /usr/bin/serve

# Playwright's Chromium (browser + headless shell) for PairSoft's e2e pack,
# baked at the world-writable PLAYWRIGHT_BROWSERS_PATH so `npx playwright
# test` in the guest never downloads. 1.61 is the first 26.04-aware line, so
# no host-platform override is needed (compare Dockerfile.g5d-g5dev).
RUN mkdir -p /opt/ms-playwright \
    && npm_config_cache=/tmp/npm-playwright npx -y "playwright@${PLAYWRIGHT_VERSION}" install chromium \
    && chmod -R a+rwX /opt/ms-playwright \
    && rm -rf /tmp/npm-playwright /root/.npm

# Baked npm dependency caches (infra/docker_images I29/I30). Warm every
# tarball and registry-metadata entry for the PairSoft procurement app's and
# e2e pack's dependency trees from the vendored package.json snapshots, then
# discard the throwaway node_modules — only the content-addressed cache
# ships. The image must NOT carry the app's node_modules, a runtime-honored
# lockfile, or a prebuilt dist/: `npm install` in the preview VM always
# resolves the freshly materialized workspace's real package.json, so the
# previewed app is always the latest version and the cache only removes
# network downloads (every hit is SHA-512 integrity-verified by npm). The
# second install of each seed proves at bake time that the cache is complete
# enough to resolve and install the snapshot fully --offline. `serve` is
# warmed too so `npx -y serve …` profiles resolve without a per-boot download.
COPY infra/docker/pairsoft-npm/package.json /opt/pairsoft/npm-seed/package.json
COPY infra/docker/pairsoft-e2e-npm/package.json /opt/pairsoft/npm-seed-e2e/package.json
RUN for seed in /opt/pairsoft/npm-seed /opt/pairsoft/npm-seed-e2e; do \
      mkdir -p /tmp/npm-warm \
      && cp "${seed}/package.json" /tmp/npm-warm/ \
      && (cd /tmp/npm-warm && npm install --cache /opt/pairsoft/npm-cache --no-audit --no-fund) \
      && rm -rf /tmp/npm-warm || exit 1; \
    done \
    && mkdir -p /tmp/npm-warm \
    && cp /opt/pairsoft/npm-seed/package.json /tmp/npm-warm/ \
    && (cd /tmp/npm-warm && npm install --cache /opt/pairsoft/npm-cache --no-audit --no-fund --no-save "serve@${SERVE_VERSION}") \
    && rm -rf /tmp/npm-warm \
    && for seed in /opt/pairsoft/npm-seed /opt/pairsoft/npm-seed-e2e; do \
      mkdir -p /tmp/npm-offline-check \
      && cp "${seed}/package.json" /tmp/npm-offline-check/ \
      && (cd /tmp/npm-offline-check && npm install --offline --cache /opt/pairsoft/npm-cache --no-audit --no-fund) \
      && rm -rf /tmp/npm-offline-check || exit 1; \
    done \
    && test -d /opt/pairsoft/npm-cache/_cacache \
    && [ -n "$(ls -A /opt/pairsoft/npm-cache/_cacache)" ] \
    && chown -R 1000:1000 /opt/pairsoft/npm-cache /opt/pairsoft/npm-seed /opt/pairsoft/npm-seed-e2e \
    && chmod -R a+rwX /opt/pairsoft/npm-cache \
    && chmod -R a+rX /opt/pairsoft/npm-seed /opt/pairsoft/npm-seed-e2e

# In-rootfs fallback npm cache for boots without the host-mounted shared
# volume, plus the seed pointer `g5d preview-serve` uses to hydrate an empty
# shared per-workspace cache (g5d preview_tunnel D22 / doctor_and_sidecar D51).
# When the host stamps the volume, its spec env `npm_config_cache=/cache/npm`
# overrides this image default (spec env wins on merge).
ENV npm_config_cache=/opt/pairsoft/npm-cache \
    G5D_NPM_CACHE_SEED=/opt/pairsoft/npm-cache

# dockerd configuration, starter and boot hook: the same files and rules as
# Dockerfile.g5d-g5dev. The starter flips vfs to overlay2 when a real ext4
# scratch disk is mounted at /var/lib/docker (microvm_runtime D53) and keeps
# vfs otherwise; the socket group is gid 1000 because the agent uses an
# explicit uid:gid. MicroVM guests have no systemd and the agent runs as
# UID 1000, so the root-owned starter has its own scoped sudo rule (D25) —
# the ONLY escalation this image grants.
COPY infra/docker/g5-dockerd-daemon.json /etc/docker/daemon.json
COPY infra/docker/g5-dev-dockerd-start.sh /usr/local/bin/g5-dev-dockerd-start
COPY infra/docker/g5-dev-dockerd.sudoers /etc/sudoers.d/g5-dev-dockerd
RUN chmod 0755 /usr/local/bin/g5-dev-dockerd-start \
    && chmod 0440 /etc/sudoers.d/g5-dev-dockerd \
    && visudo -cf /etc/sudoers.d/g5-dev-dockerd

# Guest boot hook (microvm_runtime D57): the entry script runs this as root,
# backgrounded, before the task env is sourced, so the preview profile's
# first `docker compose up` finds the daemon already up. It also raises the
# inotify instance limit: PairSoft's WAPIT suites host 270+ in-process web
# hosts and exhaust the 128 default (their CI sets
# DOTNET_hostBuilder__reloadConfigOnChange=false for the same reason).
# Failure is logged to /var/log/g5-guest-boot.log, never boot-fatal.
RUN printf '%s\n' \
        '#!/usr/bin/env bash' \
        '# Image boot hook (microvm_runtime D57): inotify headroom, then dockerd.' \
        'set -euo pipefail' \
        'sysctl -w fs.inotify.max_user_instances=1024 fs.inotify.max_user_watches=1048576 || true' \
        '/usr/local/bin/g5-dev-dockerd-start' \
        > /usr/local/bin/g5-guest-boot \
    && chmod 0755 /usr/local/bin/g5-guest-boot

# UID/GID 1000 is the in-VM agent identity. Give it stable passwd/group entries
# and writable homes/caches so dotnet, NuGet, npm, browser tests, Azure
# Functions hosts and Azurite can write without per-command overrides. The
# guest runtime hands agents HOME=/home/agent with a cleared env, so both
# homes link Playwright's default lookup path to the bake. Docker socket
# access comes from daemon.json "group": "ubuntu", not group membership.
RUN if ! getent group 1000 >/dev/null; then groupadd --gid 1000 ubuntu; fi \
    && if ! getent passwd 1000 >/dev/null; then \
         useradd --uid 1000 --gid 1000 --create-home --shell /bin/bash ubuntu; \
       fi \
    && mkdir -p /home/ubuntu/.cache /home/agent/.cache /work/.dotnet /work/.nuget/packages /work/.npm \
         /work/.azure-functions /work/.azurite /tmp/chrome-user-data \
    && ln -s /opt/ms-playwright /home/ubuntu/.cache/ms-playwright \
    && ln -s /opt/ms-playwright /home/agent/.cache/ms-playwright \
    && chown -R 1000:1000 /home/ubuntu /home/agent /work /tmp/chrome-user-data \
    && chmod 0700 /home/ubuntu /home/agent \
    && chmod 1777 /tmp /tmp/chrome-user-data

# Build-time gates: every tool a gate or profile calls answers from the task
# PATH; the single sudo rule parses; every baked Playwright binary resolves
# against the apt set above through the shared gate (an unresolved library
# has no non-root remedy in the guest); the perl-free base contract ([D19])
# survives the Docker and PowerShell installs.
COPY infra/docker/g5-browser-ldd-gate.sh /usr/local/bin/g5-browser-ldd-gate
RUN chmod 0755 /usr/local/bin/g5-browser-ldd-gate
RUN dotnet --list-sdks | grep -E '^8[.]0[.]403 ' \
    && dotnet --list-sdks | grep -E '^6[.]0[.]' \
    && dotnet --list-runtimes | grep -E '^Microsoft[.]NETCore[.]App 6[.]0[.]' \
    && node --version \
    && npm --version \
    && func --version \
    && azurite --version \
    && serve --version \
    && pwsh -NoProfile -NonInteractive -Command '$PSVersionTable.PSVersion.ToString()' | grep -qx "${POWERSHELL_VERSION}" \
    && powershell -NoProfile -NonInteractive -Command 'exit 0' \
    && sqlcmd --version | grep -q "${SQLCMD_VERSION}" \
    && docker --version \
    && docker compose version \
    && docker buildx version \
    && test -x /usr/local/bin/g5-dev-dockerd-start \
    && test -x /usr/local/bin/g5-guest-boot \
    && visudo -cf /etc/sudoers.d/g5-dev-dockerd \
    && /usr/local/bin/g5-browser-ldd-gate /opt/ms-playwright \
    && chromium --version \
    && chromedriver --version \
    && git --version \
    && for p in perl dpkg-dev libdpkg-perl; do \
         if dpkg-query -W -f='${Status}' "$p" 2>/dev/null | grep -q 'install ok installed'; then \
           echo "FATAL: $p is installed; this image installs the compiler subset, not build-essential, to stay free of the full perl ([D19])" >&2; exit 1; \
         fi; \
       done \
    && bad="$(dpkg-query -W -f='${Package} ${Status}\n' 2>/dev/null \
                | awk '$NF == "installed" && ($1 ~ /^perl-modules-/ || $1 ~ /^libperl[0-9]/) { print $1 }')" \
    && if [ -n "$bad" ]; then \
         echo "FATAL: versioned perl package(s) installed: $bad ([D19])" >&2; exit 1; \
       fi

