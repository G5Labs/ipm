ARG BASE_IMAGE=g5-ci-builder
FROM ${BASE_IMAGE}

USER root

RUN apt-get update \
  && DEBIAN_FRONTEND=noninteractive apt-get install -y --no-install-recommends \
    util-linux \
    xfsprogs \
  && rm -rf /var/lib/apt/lists/*

COPY scripts/run-rust-xfs-orchestrator.sh /usr/local/bin/run-rust-xfs-orchestrator
RUN chmod +x /usr/local/bin/run-rust-xfs-orchestrator

ENTRYPOINT ["/usr/local/bin/run-rust-xfs-orchestrator"]
