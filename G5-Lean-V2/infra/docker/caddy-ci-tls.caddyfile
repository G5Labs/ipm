# HTTPS edge for the CI stacks (cloud E2E and docker-ci). Copied into
# /etc/caddy/sites.d/ of the edge container so the main Caddyfile's trailing
# `import` picks it up; the plain :80 site keeps serving for health probes.
#
# Previews are served only from per-preview hosts
# (`g5.security.mvp-exposure.preview`), which must be HTTPS and same-site
# with the platform origin. Caddy's internal CA issues the apex and the
# wildcard certificates; the Playwright runner ignores certificate errors
# but still talks HTTPS, so `__Host-`/`Secure` cookies behave as in
# production. Requests for `*.<G5_EDGE_PREVIEW_SUFFIX>` go to the API for
# every path, exactly like the Helm ingress host rule.
https://{$G5_EDGE_TLS_APEX}, https://*.{$G5_EDGE_PREVIEW_SUFFIX} {
    tls internal

    @preview host *.{$G5_EDGE_PREVIEW_SUFFIX}
    handle @preview {
        reverse_proxy {$G5_API_URL:http://g5-api:7500}
    }

    import g5_edge
}
