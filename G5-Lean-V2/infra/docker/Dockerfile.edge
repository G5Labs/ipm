# =============================================================================
# Dockerfile.edge — G5 Edge / Reverse Proxy / Static Frontend
# Multi-stage build: Node tier builder → Caddy source → common-base runtime
# Size target: marginal layers over g5/base:26.04 < 20 MB
#   (integration-stack/docker_images [I4] — the target is marginal cost above the
#   shared base, not absolute image size, because [D18] makes the base shared
#   across the fleet and pulled once)
# Platforms: linux/amd64, linux/arm64
# =============================================================================

# --- Stage 1: Build client ---
# Node comes from the shared tier ([D18]) instead of node:22-alpine. The Vite
# output is pure JS, so it carries no glibc coupling and may safely be produced
# on the newer base.
ARG NODE_BASE_IMAGE=g5/base-node:26.04
ARG BASE_IMAGE=g5/base:26.04
# Official multi-platform image supplies only the static Caddy binary.
ARG CADDY_IMAGE=caddy:2.11.4-alpine@sha256:6aeddd44c3078b0f9a35206472a11420648a79c184603ef95957d0a20044cb2b

FROM ${NODE_BASE_IMAGE} AS builder

WORKDIR /app

# Install dependencies
COPY frontend/package.json frontend/package-lock.json ./
RUN --mount=type=cache,id=npm-edge,target=/root/.npm \
    npm ci

# Copy client source and build
COPY frontend/ .
ARG VITE_G5_CI_WORKFLOW=false
ARG VITE_G5_ENABLE_CLOUD_WORKSPACE_WORKFLOWS=false
ARG VITE_G5_ENABLE_INTENT_LOG_VIEWER=false
ENV VITE_G5_CI_WORKFLOW=${VITE_G5_CI_WORKFLOW}
ENV VITE_G5_ENABLE_CLOUD_WORKSPACE_WORKFLOWS=${VITE_G5_ENABLE_CLOUD_WORKSPACE_WORKFLOWS}
ENV VITE_G5_ENABLE_INTENT_LOG_VIEWER=${VITE_G5_ENABLE_INTENT_LOG_VIEWER}
# vite's production build needs more heap than V8 grants by default on a
# small host: inside a 4 vCPU / 14 GB workspace VM it died at about 2 GB
# ("Ineffective mark-compacts near heap limit") while the API image compiled
# beside it (QA, 2026-10-09). Builder stage only; the runtime stage is Caddy.
ENV NODE_OPTIONS=--max-old-space-size=4096
RUN npm run build

# --- Caddy source ---
# Copy the static binary from the official image pinned by version and digest.
# The deployable runtime uses the common G5 base with this binary. Keep the
# source aligned with the sibling edge Dockerfile and Dockerfile.g5d-g5dev.
FROM ${CADDY_IMAGE} AS caddy-source

# --- Stage 3: runtime on the common base ---
FROM ${BASE_IMAGE} AS runtime

COPY --from=caddy-source /usr/bin/caddy /usr/bin/caddy

# wget backs the container HEALTHCHECK (`wget -q --spider …/healthz`,
# docker-compose*.yml). The common base is ubuntu:26.04, which ships neither
# wget nor curl — unlike the former caddy:2-alpine base that bundled BusyBox
# wget — so install it explicitly or the client service never reports healthy.
RUN apt-get update && apt-get install -y --no-install-recommends wget \
    && rm -rf /var/lib/apt/lists/*

# Inherited-git guard ([D19] / test_contract D1): fail the build if anything in
# this stage's apt set reintroduced the distribution git (its perl chain) over
# the base's perl-free build.
RUN set -eux; \
    git --version; \
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: this image reinstalled the distribution git package" >&2; exit 1; \
    fi

# Caddy resolves its config and data roots from XDG paths. The upstream caddy
# image sets these, and the Caddyfile/serving behavior depends on them, so they
# must be reproduced now that we no longer inherit that image.
ENV XDG_CONFIG_HOME=/config
ENV XDG_DATA_HOME=/data
RUN mkdir -p /config/caddy /data/caddy /srv

# Copy built static assets
COPY --from=builder /app/dist /srv

# Copy Caddy configuration
COPY infra/docker/Caddyfile /etc/caddy/Caddyfile
# Optional CI-only TLS site; activated by copying it into /etc/caddy/sites.d/
# at container start (see infra/docker/caddy-ci-tls.caddyfile).
COPY infra/docker/caddy-ci-tls.caddyfile /etc/caddy/optional/caddy-ci-tls.caddyfile
RUN mkdir -p /etc/caddy/sites.d
COPY infra/docker/edge-entrypoint.sh /usr/local/bin/edge-entrypoint.sh

EXPOSE 80

# Verify the copied static binary actually runs on this base and that the
# Caddyfile adapts, so a broken copy fails the build instead of the deploy.
RUN set -eux; \
    caddy version; \
    caddy validate --config /etc/caddy/Caddyfile --adapter caddyfile

# Caddy serves static files and reverse-proxies /api/* and /ws/* to g5-api.
# The entrypoint only decides whether the CI HTTPS site is active before it
# execs `caddy run`; the base is the common G5 base, so the command must be
# stated explicitly or the image would start no server at all.
CMD ["/usr/local/bin/edge-entrypoint.sh"]
