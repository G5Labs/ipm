{
  "name": "p2p-e2e",
  "version": "0.1.0",
  "private": true,
  "description": "Playwright end-to-end tests for the P2P procurement frontend",
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "test": "playwright test",
    "test:smoke": "playwright test --grep @smoke",
    "test:gate": "playwright test --grep \"@smoke|@critical|@contract\"",
    "test:regression": "playwright test --grep @regression",
    "test:headed": "playwright test --headed",
    "test:ui": "playwright test --ui",
    "report": "playwright show-report",
    "auth:refresh": "node scripts/refresh-auth.mjs",
    "lint": "eslint .",
    "check:pin": "node scripts/check-playwright-pin.mjs",
    "check:testids": "node scripts/check-testids.mjs",
    "check:tags": "node scripts/check-tags.mjs",
    "check": "npm run check:pin && npm run check:testids && npm run check:tags && tsc --noEmit && npm run lint"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.0",
    "dotenv": "16.6.1",
    "eslint": "10.7.0",
    "eslint-plugin-playwright": "2.10.5",
    "typescript": "5.4.5",
    "typescript-eslint": "8.64.0"
  }
}
