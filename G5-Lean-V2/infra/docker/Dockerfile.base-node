# =============================================================================
# Dockerfile.base-node — Node.js toolchain tier over the common base
# Base: g5/base:26.04 (Ubuntu 26.04, glibc 2.43, perl-free git)
# Platforms: linux/amd64, linux/arm64
# =============================================================================
# Contract: software_architecture/integration-stack/docker_images [D18] — the
# common base is thin, and toolchains are layered as named tiers. This tier
# exists so the SPA build stage and the Node sidecars stop pulling a second
# distribution base (previously `node:22-alpine`, a musl distro unrelated to
# every other G5 image).
#
# Node comes from the official nodejs.org release tarball, pinned to an exact
# version with per-architecture sha256 verification ([D18]: language runtimes
# are installed from a pinned, checksum-verified source). This replaces the
# earlier NodeSource setup-script install, which executed a mutable remote
# script and resolved latest-in-major — neither pinned nor verifiable.
#
# ABI note ([D18], system_invariants/microvm_execution_boundary [D12]): binaries
# produced here link against glibc 2.43 and will not load on noble (2.39) or
# bookworm (2.36). Pure-JS output (a Vite `dist/`) carries no such constraint,
# which is why the SPA build may safely use this tier while native binary
# producers targeting older runtimes may not.
# =============================================================================

ARG BASE_IMAGE=g5/base:26.04
FROM ${BASE_IMAGE} AS final

ENV DEBIAN_FRONTEND=noninteractive
ARG TARGETARCH

# Exact version pin + per-arch sha256 from nodejs.org's published SHASUMS256.
# NODE_MAJOR is derived for the gate below; the pin aligns with the client
# workspace's engine expectation and scripts/worker-host-env.sh's NODE_VERSION.
ARG NODE_VERSION=22.23.4
ARG NODE_SHA256_X64=1805bcd35e6815559bd2eb97db438d3fdb0eb3a5e6a977b7c1badca76337e9ce
ARG NODE_SHA256_ARM64=6287aa46b6c375d816e63ae66d024fbbfd70404825aabdfdf898a970871d2f4b
ARG NODE_MAJOR=22

# curl fetches the tarball; xz-utils unpacks it (the thin common base carries
# neither). No gnupg needed: verification is by pinned sha256, not a keyring.
RUN apt-get update && apt-get install -y --no-install-recommends \
    curl \
    xz-utils \
    && rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    ARCH="$(case "${TARGETARCH:-$(uname -m)}" in arm64|aarch64) echo arm64 ;; *) echo x64 ;; esac)"; \
    case "$ARCH" in \
      arm64) NODE_SHA256="${NODE_SHA256_ARM64}" ;; \
      x64)   NODE_SHA256="${NODE_SHA256_X64}" ;; \
    esac; \
    curl -fsSLo /tmp/node.tar.xz "https://nodejs.org/dist/v${NODE_VERSION}/node-v${NODE_VERSION}-linux-${ARCH}.tar.xz"; \
    echo "${NODE_SHA256}  /tmp/node.tar.xz" | sha256sum -c -; \
    tar -xJf /tmp/node.tar.xz -C /usr/local --strip-components=1 --no-same-owner; \
    rm -f /tmp/node.tar.xz

# --- Build-time gate ---------------------------------------------------------
# Rule 5: a toolchain layer without a gate is a stub. Assert the major version
# actually installed and that npm can resolve and run, rather than trusting the
# setup script's exit code.
RUN set -eux; \
    node --version; \
    node --version | grep -qE "^v${NODE_MAJOR}\."; \
    npm --version; \
    # The perl-free git from the common base must have survived this tier.
    git --version; \
    if dpkg-query -W -f='${Status}' git 2>/dev/null | grep -q 'install ok installed'; then \
        echo "FATAL: this tier reinstalled the distribution git package" >&2; exit 1; \
    fi; \
    # Prove the runtime actually executes, not just that the binary exists.
    probe="$(mktemp -d)"; \
    echo 'process.stdout.write("ok")' > "$probe/probe.js"; \
    test "$(node "$probe/probe.js")" = "ok"; \
    rm -rf "$probe"

CMD ["/bin/bash"]
