# Enable after the QA build identities, registry and KVM pool are ready.
enable_application_triggers = false

# Keep existing ownership until admin resources, trusted publishers and all
# consumer reads are verified. This single switch controls all artifact paths;
# it does not move Cloud Build, state, old QA artifacts or their IAM.
artifact_project = "g5-qa-1ccc"
# artifact_project = "g5lean-admin-1ccc"

# Supply both target bindings after bootstrap/platform outputs and DNS review.
# Enable promotion after acceptance; the weekly G5 schedule is already selected
# and becomes effective when the release targets and promotion are enabled.
qa_release_authority_reviewed = false
enable_release_bootstrap = false
enable_promotion         = false
enable_release_train = true
promotion_targets    = {}

