#cloud-config
# =============================================================================
# Ubuntu 24.04 autoinstall seed for the G5 worker image.
#
# Boots the live-server ISO under Packer's qemu builder, partitions the disk
# as GPT with:
#
#   - 1 MiB bios_grub  — legacy BIOS boot trampoline (qemu legacy boot)
#   - 512 MiB ESP      — UEFI System Partition for GCE / general UEFI hosts
#   - 1 GiB /boot      — ext4; conservative for any bootloader that can't
#                        read XFS (older GRUB, some on-prem KVM stacks)
#   - rest /           — XFS with `mkfs.xfs -m reflink=1` (the rev-7 keystone)
#
# Hybrid BIOS+UEFI layout means the same raw disk imports cleanly to GCE
# (UEFI) and boots in legacy qemu/PNC stacks without conversion. The
# `late-commands` then enable ssh, set NOPASSWD sudo for the packer user
# (locked in 90-cleanup.sh), and pre-stage kvm modules to load on every boot.
# =============================================================================
autoinstall:
  version: 1
  locale: en_US.UTF-8
  keyboard:
    layout: us
  identity:
    hostname: g5-worker
    username: packer
    # SHA-512 hash of the literal string "packer" — ephemeral build-time
    # credential. The packer user is locked + sudoers removed in 90-cleanup.sh.
    password: "$6$g5packer$MB4UnIPh8oEgxLGeGic5bz2f390Wzg8czCobL9SY9CJO3hRuicVb3ojjsmAXymEWJ.fCx/hKjOW2aMErZer0e/"
  ssh:
    install-server: true
    allow-pw: true
  packages:
    - openssh-server
    - qemu-guest-agent
  storage:
    config:
      - id: disk0
        type: disk
        ptable: gpt
        path: /dev/vda
        wipe: superblock-recursive
        preserve: false
        grub_device: true
        match:
          size: largest
      - id: bios-grub
        type: partition
        device: disk0
        size: 1M
        flag: bios_grub
        wipe: superblock
      - id: esp-partition
        type: partition
        device: disk0
        size: 512M
        flag: boot
        wipe: superblock
      - id: esp-format
        type: format
        volume: esp-partition
        fstype: fat32
      - id: boot-partition
        type: partition
        device: disk0
        size: 1G
        wipe: superblock
      - id: boot-format
        type: format
        volume: boot-partition
        fstype: ext4
      - id: root-partition
        type: partition
        device: disk0
        size: -1
        wipe: superblock
      - id: root-format
        type: format
        volume: root-partition
        fstype: xfs
        extra_options:
          - "-m"
          - "reflink=1"
      - id: root-mount
        type: mount
        device: root-format
        path: /
      - id: boot-mount
        type: mount
        device: boot-format
        path: /boot
      - id: esp-mount
        type: mount
        device: esp-format
        path: /boot/efi
  late-commands:
    - curtin in-target --target=/target -- systemctl enable ssh
    # NOTE: no `usermod -aG sudo packer` — the identity user is created by
    # cloud-init on FIRST BOOT, so it doesn't exist in-target during late-commands
    # (usermod would exit 6). sudoers.d/90-packer below grants NOPASSWD sudo, and
    # subiquity already adds the primary user to the sudo group on first boot.
    - echo 'packer ALL=(ALL) NOPASSWD:ALL' > /target/etc/sudoers.d/90-packer
    - chmod 0440 /target/etc/sudoers.d/90-packer
    # Pre-load BOTH KVM module variants on every boot. modprobe silently
    # ignores the one that doesn't match the host CPU. This avoids the bug
    # where a build-time CPU detection (e.g. Intel) writes the wrong module
    # config for a deployment-time host (e.g. AMD) — see /tmp/review_opus47_of_codex.md.
    - printf 'kvm\nkvm_intel\nkvm_amd\n' > /target/etc/modules-load.d/g5-worker-kvm.conf
  # On autoinstall failure, dump the installer logs + any crash to the serial
  # console so the Packer build step (which captures serial-console.log) shows
  # the root cause instead of an opaque timeout. Failure-only and build-time
  # only (autoinstall never runs on the deployed image). argv (list-of-list)
  # form to stay subiquity-schema-valid.
  error-commands:
    - ["sh", "-c", "{ echo '=== curtin-install.log tail ==='; tail -n 250 /var/log/installer/curtin-install.log; echo '=== subiquity debug tail ==='; tail -n 150 /var/log/installer/subiquity-server-debug.log; echo '=== crash ==='; cat /var/crash/*.crash 2>/dev/null | head -150; } > /dev/ttyS0 2>&1 || true"]
  user-data:
    disable_root: true
