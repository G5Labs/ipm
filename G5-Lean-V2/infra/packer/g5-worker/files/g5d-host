#!/usr/bin/env bash
# =============================================================================
# /usr/local/libexec/g5d-host — stable image entrypoint for `g5d host`.
# =============================================================================
set -euo pipefail

G5D_BIN="${G5D_BIN:-/opt/g5-host/bin/g5d}"
export G5_RUNTIME_LIB_DIR=/opt/g5-host/libs
export G5D_HOST_RUNTIME_BIN_DIR="${G5D_HOST_RUNTIME_BIN_DIR:-/var/g5d-data/runtime/bin}"
export G5D_ROOTFS_STATE_DIR="${G5D_ROOTFS_STATE_DIR:-/var/lib/g5d/rootfs}"

# The image owns the host library search path, including when an older API
# rewrites host.env with the guest path during a rolling upgrade.
export LD_LIBRARY_PATH=/opt/g5-host/libs

# Host-side children must resolve executables from the private host bundle.
# G5D_HOST_RUNTIME_BIN_DIR identifies the independent guest export only.
export PATH="/opt/g5-host/bin${PATH:+:$PATH}"

exec "$G5D_BIN" host
