# =============================================================================
# /etc/g5/host.env — Environment for g5d-host.service.
#
# Baked into the image with empty defaults; PR-rev7-7 (worker provisioning,
# rev-7 plan §5.7) replaces this file via the control-plane bootstrap step
# with the host's actual JWT, control-plane endpoint, and per-org VPC tags.
#
# Variables (placeholders today; documented contract for PR-rev7-3 +
# PR-rev7-7):
#
#   G5_CONTROL_PLANE_URL    HTTPS endpoint of the g5-api control plane this
#                           host registers against.
#   G5_HOST_JWT             Per-host JWT issued by the control plane.
#                           Customer-operated deployments override the
#                           issuer; the verifier stays the same.
#   G5D_HOST_ID             Stable per-host identifier (UUID).
#   G5_HOST_REGION          Cloud region / on-prem site tag.
#   G5_RUNTIME_NODE         Override path for the bundled node binary
#                           (defaults to /opt/g5-host/bin/node).
#   G5D_HOST_RUNTIME_BIN_DIR Override path for the runtime bin directory
#                           (defaults to /var/g5d-data/runtime/bin).
#   G5_RUNTIME_LIB_DIR      Override path for the runtime lib directory
#                           (defaults to /opt/g5-host/libs).
#   RUST_LOG                tracing-subscriber filter for the supervisor.
# =============================================================================

G5_CONTROL_PLANE_URL=
G5_HOST_JWT=
G5D_HOST_ID=
G5_HOST_REGION=
G5_RUNTIME_NODE=/opt/g5-host/bin/node
G5D_HOST_RUNTIME_BIN_DIR=/var/g5d-data/runtime/bin
G5_RUNTIME_LIB_DIR=/opt/g5-host/libs
# In-process OCI layer cache. Pinned to the writable /var/g5d-data volume: the
# code default (/var/cache/g5d/oci-layers, g5d-foundation/src/oci/cache.rs) sits on this
# image's READ-ONLY root fs, so extracting a customer base_image fails EROFS.
G5D_OCI_CACHE_DIR=/var/g5d-data/cache/oci-layers
RUST_LOG=info
