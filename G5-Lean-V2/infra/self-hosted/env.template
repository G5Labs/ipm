G5_COMPOSE_PROJECT=g5-self-hosted
G5_HOME=/opt/g5
G5_DATA_DIR=/var/lib/g5
G5_API_URL=https://api.g5labs.ai
G5_LICENSE_KEY=
G5_RELEASE_VERSION=

G5_EXTERNAL_URL=https://g5.example.com
G5_GIT_EXTERNAL_URL=
# Previews are served from https://<task-id>.<suffix>/ and need: HTTPS,
# a suffix on the same registrable domain as G5_EXTERNAL_URL (for example
# preview.g5.example.com), wildcard DNS for *.<suffix> pointing at the edge,
# and a certificate that covers both the platform host and *.<suffix>.
# Blank keeps the platform running with previews unavailable.
G5_PREVIEW_HOST_SUFFIX=
# Outbound email (organization invitations). `disabled` sends nothing; `resend`
# needs a Resend account, its verified sending domain (for example
# mail.example.com) and an API key. Each kind of mail uses its own mailbox there,
# e.g. invitations@mail.example.com. Quote a display name with spaces, e.g.
# G5_EMAIL_FROM_NAME='Acme Platform'. See docs/email-delivery.md.
G5_EMAIL_TRANSPORT=disabled
G5_EMAIL_FROM_DOMAIN=
G5_EMAIL_FROM_NAME=G5
G5_EMAIL_RESEND_API_KEY=
G5_HTTP_PORT=80
G5_HTTPS_PORT=443
# Dedicated edge/API network. Move all three together if this subnet overlaps.
G5_EDGE_SUBNET=172.30.254.0/29
G5_EDGE_IP=172.30.254.2
G5_API_EDGE_IP=172.30.254.3
# Set both to readable absolute host paths to enable the bundled Caddy TLS
# overlay. Leave both blank to preserve the base edge behavior.
G5_TLS_CERT_FILE=
G5_TLS_KEY_FILE=

G5_IMAGE_API=
G5_IMAGE_EDGE=
G5_IMAGE_WORKER=
G5_IMAGE_MIGRATION=
G5_IMAGE_POSTGRES=pgvector/pgvector:pg17

G5_DB_NAME=g5
G5_DB_USER=g5
G5_DB_PASSWORD=
G5_DATABASE_URL=

G5_JWT_PRIVATE_KEY=
G5_JWT_PUBLIC_KEY=
G5_SCM_ENCRYPTION_KEY=
G5_COOKIE_SECURE=true
G5_CORS_ALLOWED_ORIGINS=
G5_RATE_LIMIT_ENABLED=true
G5_RATE_LIMIT_RPM=20000
G5_SELF_HOSTED_DEFAULT_ORG_NAME='Default Organization'
G5_SELF_HOSTED_DEFAULT_ORG_SLUG=default
G5_SELF_HOSTED_DEFAULT_ADMIN_EMAIL=admin@g5.local
G5_SELF_HOSTED_DEFAULT_ADMIN_NAME='G5 Self-Hosted Admin'

G5_GITHUB_CLIENT_ID=
G5_GITHUB_CLIENT_SECRET=
G5_GITHUB_AUTHORIZE_URL=
G5_GITHUB_TOKEN_URL=
G5_GITHUB_USERINFO_URL=
G5_MICROSOFT_CLIENT_ID=
G5_MICROSOFT_CLIENT_SECRET=
G5_MICROSOFT_TENANT_ID=
G5_MICROSOFT_AUTHORIZE_URL=
G5_MICROSOFT_TOKEN_URL=
G5_MICROSOFT_JWKS_URL=
G5_SCM_GITLAB_CLIENT_ID=
G5_SCM_GITLAB_CLIENT_SECRET=
G5_SCM_GITLAB_AUTHORIZE_URL=
G5_SCM_GITLAB_TOKEN_URL=
G5_SCM_GITLAB_USERINFO_URL=

G5D_ISOLATION_MODE=microvm
G5D_LLM_PROVIDER=
G5D_LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

SELF_HOSTED=true
ENABLE_CLOUD_FEATURES=false
RUST_LOG=info
