set dotenv-load := false

selfhost := "scripts/g5-selfhost.sh"

# Verify host prerequisites, directory layout, secrets, and current image refs.
setup:
    {{selfhost}} setup

# Start the current installed release without pulling a newer release.
up:
    {{selfhost}} up

# Stream service logs. Usage: just logs [service]
logs service="":
    {{selfhost}} logs "{{service}}"

# Stop the stack without deleting persistent data.
down:
    {{selfhost}} down

# Create a verified backup under backups/YYYYmmdd-HHMMSS.
backup:
    {{selfhost}} backup

# Restore the database from a backup directory, or from the latest backup.
restore backup="latest":
    {{selfhost}} restore "{{backup}}"

# Pull the latest entitled release, migrate, and roll back on failure.
upgrade:
    {{selfhost}} upgrade
