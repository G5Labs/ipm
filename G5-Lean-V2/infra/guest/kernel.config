CONFIG_KVM_INTEL=y
CONFIG_KVM_AMD=y
# Inner hosts (g5.architecture.microvm_backend.nested): a nested-enabled guest
# runs the unmodified `g5d vm-exec` launch, which needs Cloud Hypervisor's
# Landlock ruleset (a hard requirement of --landlock), the passt egress policy
# (inet nf_tables with ct and fib expressions) and a reflink-capable root,
# which the guest makes from a loop-mounted XFS image on its ext4 disk.
CONFIG_SECURITY_LANDLOCK=y
CONFIG_LSM="landlock"
CONFIG_NF_TABLES_INET=y
CONFIG_NFT_CT=y
CONFIG_NFT_FIB_IPV4=y
CONFIG_NFT_FIB_IPV6=y
CONFIG_NFT_FIB_INET=y
CONFIG_BLK_DEV_LOOP=y
CONFIG_XFS_FS=y
