{
  "name": "g5-client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:seed": "bash ../scripts/seed-demo.sh auto ../demo-workspace && vite",
    "dev:mock": "VITE_MOCK=true vite",
    "build": "tsc --project tsconfig.build.json --noEmit && vite build",
    "preview": "vite preview",
    "lint": "eslint src/",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,js,jsx,css,json}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:smoke": "vitest run -c vitest.config.smoke.ts",
    "test:e2e": "playwright test -c e2e/playwright.config.ts",
    "test:e2e:ui": "playwright test -c e2e/playwright.config.ts --ui",
    "test:e2e:mock-preview": "playwright test -c e2e/mock-preview/playwright.config.ts",
    "dev:review-mock": "vite --config vite.review-mock.config.ts",
    "build:review-mock": "vite build --config vite.review-mock.config.ts"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@tanstack/react-query": "^5.62.0",
    "@tiptap/core": "^3.32.1",
    "@tiptap/extension-code": "^3.32.1",
    "@tiptap/extension-list": "^3.32.1",
    "@tiptap/extension-table": "^3.32.1",
    "@tiptap/pm": "^3.32.1",
    "@tiptap/react": "^3.32.1",
    "@tiptap/starter-kit": "^3.32.1",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "@xyflow/react": "^12.10.2",
    "github-markdown-css": "^5.9.0",
    "hast-util-from-html": "^2.0.3",
    "hast-util-sanitize": "^5.0.2",
    "hast-util-to-jsx-runtime": "^2.3.6",
    "highlight.js": "^11.11.1",
    "katex": "^0.16.28",
    "lucide-react": "^0.563.0",
    "mdast-util-gfm": "^3.1.0",
    "mdast-util-math": "^3.0.0",
    "mdast-util-to-markdown": "^2.2.1",
    "modern-screenshot": "^4.7.0",
    "monaco-editor": "0.55.1",
    "pdfjs-dist": "6.4.299",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.13.0",
    "rehype-katex": "^7.0.1",
    "rehype-raw": "^7.0.0",
    "rehype-sanitize": "^6.0.0",
    "rehype-slug": "^6.0.0",
    "remark-gfm": "^4.0.1",
    "remark-math": "^6.0.0",
    "remark-parse": "^11.0.0",
    "robot-heads": "^0.3.0",
    "unified": "^11.0.5",
    "yaml": "^2.9.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.52.0",
    "@tailwindcss/postcss": "^4.1.18",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/hast": "^3.0.5",
    "@types/mdast": "^4.0.4",
    "@types/pg": "^8.18.0",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.4.24",
    "axe-core": "^4.13.0",
    "eslint": "^9.39.1",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.2.0",
    "jsdom": "^26.1.0",
    "mermaid": "^11.12.2",
    "msw": "^2.7.0",
    "pg": "^8.20.0",
    "postcss": "^8.5.0",
    "prettier": "^3.5.0",
    "tailwindcss": "^4.1.18",
    "typescript": "5.8",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.0.0",
    "vitest": "^3.2.0",
    "ws": "^8.19.0"
  },
  "overrides": {
    "monaco-editor": {
      "dompurify": "^3.4.17"
    }
  }
}
