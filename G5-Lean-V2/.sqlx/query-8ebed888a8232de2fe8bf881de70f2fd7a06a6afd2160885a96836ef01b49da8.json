  "query": "\n            SELECT id, session_id, role, content, artifacts, citations,\n                   input_tokens, output_tokens, status, message_index, created_at, is_error_notice,\n                   task_id, attempt\n            FROM chat_messages\n            WHERE session_id = $1 AND message_index <= $2\n            ORDER BY message_index ASC\n            ",
