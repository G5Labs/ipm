{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT o.id AS org_id, o.name AS org_name, o.slug AS org_slug, om.role,\n                   o.kind AS org_kind\n            FROM org_memberships om\n            JOIN orgs o ON o.id = om.org_id\n            WHERE om.user_id = $1 AND om.deactivated_at IS NULL\n            ORDER BY om.created_at ASC\n            ",
