{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT\n                id,\n                workspace_id,\n                category,\n                severity,\n                title,\n                message,\n                task_id,\n                comment_id,\n                reply_id,\n                actions,\n                read_at,\n                expires_at,\n                created_at,\n                actor_user_id\n            FROM notifications\n            WHERE workspace_id = $1\n              AND recipient_user_id = $2\n              AND ($3::BOOLEAN = FALSE OR read_at IS NULL)\n            ORDER BY created_at DESC\n            LIMIT $4\n            ",
