  "query": "SELECT provider AS \"provider!\", model AS \"model!\", COALESCE(SUM(cost_usd), 0) AS \"cost_usd!\", COALESCE(SUM(input_tokens), 0)::bigint AS \"input_tokens!\", COALESCE(SUM(output_tokens), 0)::bigint AS \"output_tokens!\", COUNT(*) AS \"request_count!\" FROM usage_records WHERE workspace_id = $1 AND created_at >= $2 AND created_at < $3 GROUP BY provider, model ORDER BY COALESCE(SUM(cost_usd), 0) DESC",
