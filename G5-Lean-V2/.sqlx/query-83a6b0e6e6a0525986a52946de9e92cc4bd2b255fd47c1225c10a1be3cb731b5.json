{
  "db_name": "PostgreSQL",
  "query": "\n            SELECT o.id, o.name, o.slug, m.role, o.created_at\n            FROM orgs o\n            JOIN org_memberships m ON o.id = m.org_id\n            WHERE m.user_id = $1 AND m.deactivated_at IS NULL\n            ORDER BY o.name ASC\n            ",
