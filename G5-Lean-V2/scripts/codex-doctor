#!/usr/bin/env bash
# Read-only checks for this checkout's planning/review skill profile.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
python3 "$repo_root/scripts/sync-ontology-skills.py" --check
exec python3 - "$repo_root" <<'PYDOCTOR'
from pathlib import Path
import json
import sys
import tomllib

root = Path(sys.argv[1])
errors = []
for name in [".claude/hooks", ".codex/hooks", ".codex/hooks.json"]:
    if (root / name).exists():
        errors.append(f"unexpected repo hook path: {name}")
for name in [".claude/settings.json", ".claude/settings.local.json", ".codex/config.toml", ".mcp.json"]:
    path = root / name
    if not path.exists():
        continue
    data = tomllib.loads(path.read_text()) if path.suffix == ".toml" else json.loads(path.read_text())
    if data.get("hooks"):
        errors.append(f"repo hooks remain configured: {name}")
    servers = data.get("mcpServers", data.get("mcp_servers", {}))
    if {"g5-tools", "g5-intent-aux"}.intersection(servers):
        errors.append(f"legacy MCP auto-registration remains: {name}")
if errors:
    print("\n".join(errors), file=sys.stderr)
    sys.exit(1)
print("No repo hooks or legacy MCP auto-registration. Local checks only; global/client state is separate.")
PYDOCTOR
