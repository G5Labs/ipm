#!/usr/bin/env bash
# Launch ordinary Codex in this checkout without generating a G5 runtime profile.
set -euo pipefail
repo_root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
case "${1:-}" in
  --doctor) shift; exec "$repo_root/scripts/codex-doctor" "$@" ;;
  --dry-run)
    shift
    printf 'Ordinary Codex; checkout: %s\nNo generated config, hooks, MCP preparation or CODEX_HOME override.\n' "$repo_root"
    exit 0 ;;
esac
cli="$(command -v codex || true)"
if [ -z "$cli" ] || [ "$cli" -ef "${BASH_SOURCE[0]}" ]; then
  printf 'Resolve the native codex executable on PATH before using this wrapper.\n' >&2
  exit 1
fi
cd "$repo_root"
exec "$cli" "$@"
