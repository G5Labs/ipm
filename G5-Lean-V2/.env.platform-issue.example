# Optional local GitHub App delivery for the platform bug-reporting affordance.
#
# Copy this file to .env.platform-issue.local, fill in the real values, and keep
# the copy local. `just dev-up` and `just dev-restart-backend` source that file
# after .env. It is ignored by Git; do not place these values in a tracked file.

# Set this to true only after every value below, including the private key, is
# real. The copied example otherwise remains fail-closed.
G5_PLATFORM_ISSUE_REPORTING_ENABLED=false
G5_PLATFORM_ISSUE_GITHUB_REPO=OWNER/platform-bug-reports
G5_PLATFORM_ISSUE_GITHUB_APP_ID=1234567
G5_PLATFORM_ISSUE_GITHUB_APP_INSTALLATION_ID=12345678
G5_PLATFORM_ISSUE_GITHUB_API_BASE_URL=https://api.github.com

# In the copied local file, paste the complete private key as one Bash
# ANSI-C-quoted value, preserving literal \n escapes. This tracked example
# intentionally uses a non-PEM placeholder so secret scanners do not treat it
# as credential material. Uncomment, replace locally, and then enable the feature.
# G5_PLATFORM_ISSUE_GITHUB_APP_PRIVATE_KEY=$'REPLACE_WITH_LOCAL_GITHUB_APP_KEY'
