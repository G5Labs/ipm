  "proposals": [
    {
      "id": "QP-HOME",
      "kind": "new D",
      "proposed_id": "g5.ui.home-attention",
      "owner": ".g5/ontology/features/ui.g5.md",
      "obligations": [
        "P01"
      ],
      "text": "Home projects actionable approvals and open questions from their existing owners, limited to the caller’s authorized audience. Question attention is for owned workspaces. Counts derived from a loaded or filtered page describe that slice; absence, loading or failure must not imply that no outstanding work exists.",
      "provenance": "agent-recovered proposal",
      "authority": [
        ".g5/pr_ontology_diff_design/ux-v2-workbench/ontology-plan.md:908-934",
        "backend/g5-api-core/src/services/workspace/home_service.rs:158-402"
      ],
      "why": "Journey completion does not require an actionable inbox or qualify partial-page counts. Separate decision authority remains in approval/question owners.",
      "confidence": "high omission; medium recovered scope"
    },
    {
      "id": "QP-TEMPLATES",
      "kind": "new D",
      "proposed_id": "g5.documents.explainer-catalog",
      "owner": ".g5/ontology/features/documents.g5.md",
      "obligations": [
        "P02"
      ],
      "text": "Offer reusable explainer prompts from built-ins plus valid saved templates in the repository’s committed configuration. Owner edits use the ordinary live-file and publication boundaries; saving a template does not itself claim that it has been published.",
      "provenance": "agent-recovered proposal",
      "authority": [
        ".g5/pr_ontology_diff_design/ux-v2-workbench/ontology-plan.md:213-224",
        "backend/g5-api-core/src/services/workspace/workspace_service.rs:8383-8510"
      ],
      "why": "Workbench phase actions have different replacement semantics and do not require an explainer catalog. No six-template count or file-format algorithm needs new intent.",
      "confidence": "high omission; medium recovered product scope"
    },
    {
      "id": "QP-TEMPLATE-REPLACE",
      "kind": "new D / restore former semantic owner",
      "proposed_id": "g5.documents.explainer.templates",
      "owner": ".g5/ontology/features/documents.g5.md",
      "obligations": [
        "P03"
      ],
      "text": "Saving a user explainer template must not silently replace another template: replacement requires an explicit choice, and built-in template identities remain reserved.",
      "provenance": "agent-recovered proposal",
      "authority": [
        "3d17915d:.g5/ontology/features/documents.g5.md#g5.documents.explainer.templates",
        "frontend/src/components/explainer/CreateExplainerModal.tsx:517-583,896-928",
        "backend/g5-api-core/src/services/workspace/workspace_service.rs:8460-8592"
      ],
      "why": "Retains the prior explicit-replacement commitment without importing historical percentage claims or assuming atomic native file replacement.",
