# The study report, compact protocol, and findings are the reviewable record.
# Per-run inputs, prompts, scripts, patches, caches, and evaluations remain local.
/*
!/.gitignore
!/README.md
!/protocol.md
!/implementation-plan.md
!/design-adjudication.md
!/design-followup-results.md
!/implementation-results.md
!/review-adjudication.md
!/review-results.md
!/repair-results.md
!/selector-results.md
!/repair-and-selector-adjudication.md
!/review-fix/
