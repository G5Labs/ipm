# ---------------------------------------------------------------------------
# Local development environment template
# Copy to .env and adjust values for your setup.
# Values here are automatically forwarded to Docker containers via
# docker-compose.dev.yml variable interpolation.
# ---------------------------------------------------------------------------

# Postgres connection for sqlx compile-time query verification.
# When using docker-compose.dev.yml with the example port override below:
#   postgres://g5:g5_dev@localhost:5433/g5_dev
# When using devcontainer compose:    postgres://g5:g5_dev@postgres:5432/g5
DATABASE_URL=postgres://g5:g5_dev@localhost:5433/g5_dev

# Postgres connection used by the integration-test harness.
# Keep this aligned with DATABASE_URL unless you intentionally use a separate
# Postgres instance for test bootstrap.
TEST_DATABASE_URL=postgres://g5:g5_dev@localhost:5433/g5_dev

# Port overrides — avoid conflicts with a local Postgres (5432).
# These variables are consumed by docker-compose.dev.yml and Justfile recipes.
# Default (uncommented) values use non-conflicting ports:
G5_PORT_POSTGRES=5433
# G5_PORT_API=7500    # default, no conflict
# G5_PORT_EDGE=3000   # default, no conflict

# Local stack recipes provision one retained secret bundle outside checkouts.
# Leave all JWT/SCM fields unset to use it. Explicit overrides must supply a
# complete matching JWT private/public pair and a generated SCM encryption key.
# Existing encrypted data requires its original key; see docs/local-stack-secrets.md.

# ---------------------------------------------------------------------------
# LLM API keys — forwarded to g5-api and g5d-worker containers.
# Used by `just demo-up`, `just dev-up`, `just test-live-llm`, and `just ci-docker-live`.
# Configure the appropriate key for API-key provider routes.
# ---------------------------------------------------------------------------
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# OPENROUTER_API_KEY=sk-or-...

# Codex API-key credentials are normally configured in Settings > Runtime
# Config. To use ChatGPT subscription auth, enable the subscription checkbox
# and send a chat message. The workspace VM runs codex login --device-auth;
# chat displays the sign-in link and one-time code. Complete sign-in within
# five minutes, or send another message to retry. Credentials remain in the
# owner-bound VM; never upload or copy a laptop auth.json into G5.
# See docs/codex-device-auth.md for the live validation workflow.


# ---------------------------------------------------------------------------
# Native worker host isolation (ontology g5.runtime.boot.backend.process-local).
# On Linux/KVM, `just dev-up` boots one Cloud Hypervisor VM per workspace. To run
# workspaces (chat, preview, terminal) as plain host processes instead — for
# example to run the `full-stack` preview profile on this machine's own Docker —
# set BOTH of these. Localhost development only: no VM boundary, host network,
# provider/task secrets in host process environment, no resource caps. The
# host refuses `process` without the acknowledgement, and `just dev-up` makes the
# local API admit such a host only while both are set (it derives
# G5_ALLOW_PROCESS_ISOLATION_HOSTS itself; do not set that one).
# ---------------------------------------------------------------------------
# G5D_ISOLATION_MODE=process
# G5D_ALLOW_PROCESS_ISOLATION=1

# ---------------------------------------------------------------------------
# Provider CLI binaries (docs/lean-provider-cli-contract.md §6).
# The worker spawns the Claude Code and Codex CLIs pinned in
# scripts/claude-code-cli-version and scripts/codex-cli-version. Leave empty to
# resolve them from the image (/opt/g5/bin in the microVM guest, /usr/local/bin
# in the Docker worker) or PATH. Tests point them at the fakes built from
# tools/fake-provider-cli (fake-claude, fake-codex; G5_FAKE_SCENARIO selects the
# frames they replay).
# ---------------------------------------------------------------------------
G5_CLAUDE_PATH=
G5_CODEX_PATH=

# ---------------------------------------------------------------------------
# Provided-Agent Claude Code runtime.
# Separate from G5D_LLM_PROVIDER / OPENROUTER_API_KEY / ANTHROPIC_API_KEY.
# Claude Code uses subscription/OAuth by default. To use provider API keys,
# configure task-scoped Runtime Config secrets by the exact env names the agent
# should see.
# ---------------------------------------------------------------------------

# Provided-Agent Claude Code model pins. Leave empty to use subscription/OAuth
# or task-scoped Runtime Config defaults; set to override.
G5_CLAUDE_CODE_OPUS_MODEL=
G5_CLAUDE_CODE_SONNET_MODEL=
G5_CLAUDE_CODE_HAIKU_MODEL=
G5_CLAUDE_CODE_ANTHROPIC_MODEL=
G5_CLAUDE_CODE_SUBAGENT_MODEL=

# ---------------------------------------------------------------------------
# Optional: explicit LLM provider/model override (auto-detected from keys if unset)
# ---------------------------------------------------------------------------
# G5D_LLM_PROVIDER=anthropic
# G5D_LLM_MODEL=anthropic/claude-sonnet-4.6

# ---------------------------------------------------------------------------
# Worker org assignment — auto-detected and persisted by `just demo-up`.
# If unset, workers auto-register to the first org by UUID sort, which may
# differ from the org your workspace lives in.  `just demo-up` writes this
# automatically; you only need to set it manually if starting workers outside
# the Justfile flow.
# ---------------------------------------------------------------------------
# G5D_ORG_ID=
