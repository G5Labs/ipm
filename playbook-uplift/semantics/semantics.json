  "invariants": {
    "INV-HIST": {
      "text": "The history record of every command is honest (A1, A7).",
      "reads": [
        "History",
        "ModuleRecords",
        "ModuleCode"
      ]
    },
    "INV-MOD": {
      "text": "An installed module's record and its compiled code agree (A3, A5).",
      "reads": [
        "ModuleRecords",
        "ModuleCode"
      ]
    },
    "INV-DEP": {
      "text": "Every installed module's requirements are satisfied (A11).",
      "reads": [
        "ModuleRecords"
      ]
    },
    "INV-SET": {
      "text": "A setting reads back what was last written (A12).",
      "reads": [
        "Settings"
      ]
    },
    "INV-REPO": {
      "text": "Registry definitions are unique and match what search reads (A5, A8).",
      "reads": [
        "Registries"
      ]
    },
    "INV-SYNC": {
      "text": "A developer-mode module's baseline matches its server code (A7).",
      "reads": [
        "SyncBaselines",
        "ModuleCode"
      ]
    },
    "INV-TEMP": {
      "text": "No IPM working data outlives its command (A5).",
      "reads": [
        "IpmWorkingData"
      ],
      "residue_only": true
    },
    "INV-FRAME": {
      "text": "A read-only command changes no IPM fact (A6).",
      "reads": [
        "History",
        "InstanceConfig",
        "ModuleCode",
        "ModuleRecords",
        "Registries",
        "Settings",
        "SyncBaselines",
        "SystemCode",
        "UpdateSteps"
      ],
      "commands": [
        "list-installed",
        "history-find",
        "search",
        "orphans",
        "version"
      ],
      "must_not_write": true
    },
    "INV-MAP": {
      "text": "A namespace uses IPM from where the last enable or unmap said, and nothing else changes (A6, A12).",
      "reads": [
        "InstanceConfig",
        "MappedNamespaceMeta"
      ]
    },
    "INV-STEPS": {
      "text": "Each registered update step of a version transition runs once, in order; steps marked done are not rerun (A9, A13).",
      "reads": [
        "UpdateSteps"
      ]
    },
    "INV-SYSCODE": {
      "text": "IPM commands change no system (IRISSYS) code (A6).",
      "reads": [
        "SystemCode"
      ]
    }
  },
  "global_classes_note": "IRISLOCALDATA code globals hold IRIS's generated SQL cached-query classes (^%sqlcq); IRISAUDIT holds system audit records of security changes; IRISSECURITY ^SECURITY holds web, CSP, role and user definitions."
}
