set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.Uninstall") write !,"RESULT Test.PM.Integration.Uninstall ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.PkgCaseUninstall") write !,"RESULT Test.PM.Integration.PkgCaseUninstall ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
