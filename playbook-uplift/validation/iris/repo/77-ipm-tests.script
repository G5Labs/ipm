set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.ModuleVersion") write !,"RESULT Test.PM.Integration.ModuleVersion ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.FileCopy -DUnitTest.Method=TestKeepOnUninstall") write !,"RESULT Test.PM.Integration.FileCopy#TestKeepOnUninstall ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.FileCopy -DUnitTest.Method=TestProtectedDirectoryFileCopy") write !,"RESULT Test.PM.Integration.FileCopy#TestProtectedDirectoryFileCopy ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm test -only -quiet -DUnitTest.Case=Test.PM.Unit.CLI") write !,"RESULT Test.PM.Unit.CLI ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm test -only -quiet -DUnitTest.Case=Test.PM.Unit.Oras") write !,"RESULT Test.PM.Unit.Oras ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
halt
