set sc=##class(Uplift.Nsp.Ns).InstallHere() write !,"NCC INSTALL ",$system.Status.IsOK(sc)," ",$system.Status.GetErrorText(sc),!
write !,"OBS|nc-nsp-setup-ncc-clean-local-install|status=",$select($system.Status.IsOK(sc):"ok",1:"err"),";zpm=",##class(Uplift.Nsp.Util).Mod("zpm","NCC"),";maps=",##class(Uplift.Nsp.Util).Maps("NCC"),";",!
halt
