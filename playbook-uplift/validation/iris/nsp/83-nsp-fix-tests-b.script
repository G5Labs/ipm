set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.IncludeTests") write !,"RESULT Test.PM.Integration.IncludeTests ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.DeployedMappings") write !,"RESULT Test.PM.Integration.DeployedMappings ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.DeployedPackageLoad") write !,"RESULT Test.PM.Integration.DeployedPackageLoad ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.DeployedItems") write !,"RESULT Test.PM.Integration.DeployedItems ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
halt
