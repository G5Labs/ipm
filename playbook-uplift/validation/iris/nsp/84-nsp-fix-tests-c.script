set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.CustomPhase") write !,"RESULT Test.PM.Integration.CustomPhase ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.ExternalNameModuleAction") write !,"RESULT Test.PM.Integration.ExternalNameModuleAction ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.CopyDirOverlap") write !,"RESULT Test.PM.Integration.CopyDirOverlap ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.Generate") write !,"RESULT Test.PM.Integration.Generate ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
halt
