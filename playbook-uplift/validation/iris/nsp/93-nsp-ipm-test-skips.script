zn "USER-VERIFY"
for run=1,4,5 { set rs=##class(%SQL.Statement).%ExecDirect(,"SELECT a.Status, COUNT(*) AS N FROM %UnitTest_Result.TestAssert a WHERE a.TestMethod->TestCase->TestSuite->TestInstance = ? GROUP BY a.Status",run) set o="" while rs.%Next() { set o=o_"status"_rs.%Get("Status")_":"_rs.%Get("N")_" " } set rs2=##class(%SQL.Statement).%ExecDirect(,"SELECT a.Description FROM %UnitTest_Result.TestAssert a WHERE a.Status=2 AND a.TestMethod->TestCase->TestSuite->TestInstance = ?",run) set sk="" while rs2.%Next() { set sk=sk_$translate(rs2.%Get("Description"),";|=",",/:")_" / " } write !,"OBS|nc-nsp-ipm-test-run-",run,"-assert-status|counts=",o,";skipped=",sk,";",! }
halt
