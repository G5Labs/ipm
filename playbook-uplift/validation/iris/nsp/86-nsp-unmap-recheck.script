set u="Uplift.Nsp.Util" for ns="NCA","NCE" { kill kv set kv("maps")=$classmethod(u,"Maps",ns),kv("pkgDest")=$classmethod(u,"PkgDest",ns),kv("rtnDest")=##class(Uplift.Nsp.Ns).RtnDest(ns,"%IPM.Main.1"),kv("hasIPM")=$classmethod(u,"HasIPM",ns),kv("cpf")=##class(Uplift.Nsp.Ns).CpfMap(ns) do $classmethod(u,"Emit","nc-nsp-N6-unmap-recheck-"_$zcvt(ns,"L"),.kv) }
zn "NCA"
set sc=##class(Uplift.Nsp.Util).Run("version",.o) write !,"OBS|nc-nsp-N6-shell-after-unmap|ns=NCA;status=",##class(Uplift.Nsp.Util).Clean(##class(Uplift.Nsp.Util).St(sc)),";",!
halt
