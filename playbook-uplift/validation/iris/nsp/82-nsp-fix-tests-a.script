set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.BatchActivate") write !,"RESULT Test.PM.Integration.BatchActivate ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.SystemRequirements") write !,"RESULT Test.PM.Integration.SystemRequirements ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.Health") write !,"RESULT Test.PM.Integration.Health ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.Interoperability") write !,"RESULT Test.PM.Integration.Interoperability ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.VersionReq") write !,"RESULT Test.PM.Integration.VersionReq ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),!
halt
