zn "%SYS"
set userDB=##class(%SYS.Namespace).GetPackageDest("USER","%IPM"), sysDB=##class(%SYS.Namespace).GetPackageDest("%SYS","%IPM") set rs=##class(%ResultSet).%New("Config.Namespaces:List") do rs.Execute("*") set out="",same=1,cnt=0 while rs.Next() { set ns=rs.Get("Namespace"), d=##class(%SYS.Namespace).GetPackageDest(ns,"%IPM"), cnt=cnt+1, out=out_ns_":"_d_" " set:d'=sysDB same=0 } write !,"OBS|nc-mig-ipm-mapped-globally-configured|configuredNamespaces=",cnt,";allShareSysIPMdb=",same,";ipmInstalledIn=",sysDB,";perNamespace=",out,";",!
set m=##class(%IPM.Storage.Module).NameOpen("zpm") write !,"OBS|nc-mig-ipm-upgraded-in-sys|zpmVersionInSYS=",$select($isobject(m):m.VersionString,1:"<none>"),";root=",$select($isobject(m):m.Root,1:""),";",! kill m
set out="" set id="" for { set id=$order(^IPM.Repo.DefinitionD(id)) quit:id=""  set o=##class(%IPM.Repo.Definition).%OpenId(id) continue:'$isobject(o)  set out=out_o.Name_"["_o.%ClassName(1)_" enabled:"_o.Enabled_" url:"_$select(o.%IsA("%IPM.Repo.Remote.Definition"):o.URL,1:"")_"] " } set lout="" set k="" for { set k=$order(^%ZPM.Client.ServerDefD(k),1,d) quit:k=""  set lout=lout_$listget(d,2)_" " } write !,"OBS|nc-mig-repos-sys|repos=",out,";legacyRepoNames=",lout,";legacyRepoGlobalDest=",##class(%SYS.Namespace).GetGlobalDest("USER","%ZPM.Client.ServerDefD"),";",!
write !,"OBS|nc-mig-ipm-cli-scripts|binIpmInModuleRoot=",##class(%File).Exists("/usr/irissys/ipm/zpm/0.10.11-beta.29/bin/ipm"),";localBinIpm=",##class(%File).Exists("/home/irisowner/.local/bin/ipm"),";",!
set ok=0 try { set ok=##class(IPM.Installer).ORASInstalled() } catch e { set ok="err:"_$translate(e.DisplayString(),";|=",",/:") } write !,"OBS|nc-mig-oras-python-installed|orasInstalled=",ok,";",!
halt
