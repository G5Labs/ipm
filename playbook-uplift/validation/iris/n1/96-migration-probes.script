zn "%SYS"
set userDB=##class(%SYS.Namespace).GetPackageDest("USER","%IPM") kill nsl do ##class(%SYS.Namespace).ListAll(.nsl) set ns="",out="",same=1 for { set ns=$order(nsl(ns)) quit:ns=""  set d=##class(%SYS.Namespace).GetPackageDest(ns,"%IPM"), out=out_ns_":"_$select(d=userDB:"userDB",1:d)_" " set:d'=userDB same=0 } write !,"OBS|nc-mig-ipm-mapped-globally|allNamespacesShareUserIPMdb=",same,";sysEqualsUser=",(##class(%SYS.Namespace).GetPackageDest("%SYS","%IPM")=userDB),";perNamespace=",out,";",!
write !,"OBS|nc-mig-legacy-classes-remain|hasLegacyZPMPackage=",##class(%IPM.Utils.Migration).HasLegacyZPMPackage(),";zpmPackageManagerCompiled=",($data(^oddCOM("%ZPM.PackageManager"))>0),";",!
set ns="",out="" for { set ns=$order(nsl(ns)) quit:ns=""  continue:'##class(%SYS.Namespace).Exists(ns)  try { new $namespace set $namespace=ns set n=0,names="" set id="" for { set id=$order(^IPM.Storage.ModuleD(id),1,dd) quit:id=""  set n=n+1,names=names_$listget(dd,2)_"," } set m=0 set id="" for { set id=$order(^ZPM.Dev.ModuleD(id)) quit:id=""  set m=m+1 } set out=out_ns_":ipm="_n_"("_names_")/legacy="_m_" " } catch e { set out=out_ns_":err "} } write !,"OBS|nc-mig-module-records|perNamespace=",out,";",!
zn "USER"
set out="" set id="" for { set id=$order(^IPM.Repo.DefinitionD(id)) quit:id=""  set o=##class(%IPM.Repo.Definition).%OpenId(id) continue:'$isobject(o)  set out=out_o.Name_"["_o.%ClassName(1)_" enabled="_o.Enabled_" url="_$select(o.%IsA("%IPM.Repo.Remote.Definition"):o.URL,1:"")_" user="_$select(o.%IsA("%IPM.Repo.Remote.Definition"):o.Username,1:"")_"] " } write !,"OBS|nc-mig-repos-user|repos=",$translate(out,";|=","/!:"),";legacyRepoRows=",$select($data(^%ZPM.Client.ServerDefD):$order(^%ZPM.Client.ServerDefD(""),-1),1:0),";",!
set comm=0 set id="" for { set id=$order(^IPM.Repo.DefinitionD(id)) quit:id=""  set o=##class(%IPM.Repo.Definition).%OpenId(id) if $isobject(o),o.%IsA("%IPM.Repo.Remote.Definition"),o.URL["pm.community.intersystems.com",o.Enabled set comm=1 } write !,"OBS|nc-mig-community-registry-enabled|communityRepoEnabledInUSER=",comm,";",!
zn "%SYS"
write !,"OBS|nc-mig-repo-storage-not-mapped|repoGlobalDestUSER=",##class(%SYS.Namespace).GetGlobalDest("USER","IPM.Repo.DefinitionD"),";repoGlobalDestSYS=",##class(%SYS.Namespace).GetGlobalDest("%SYS","IPM.Repo.DefinitionD"),";sysRepoRows=",$select($data(^IPM.Repo.DefinitionD):$order(^IPM.Repo.DefinitionD(""),-1),1:0),";",!
set out="" set ns="" for { set ns=$order(nsl(ns)) quit:ns=""  continue:'##class(Config.Namespaces).Exists(ns)  kill rs set rs=##class(%ResultSet).%New("Config.MapPackages:List") do rs.Execute(ns,"*") while rs.Next() { set out=out_ns_">"_rs.Get("Name")_"@"_rs.Get("Database")_" " } } write !,"OBS|nc-mig-package-mappings|mappings=",out,";",!
halt
