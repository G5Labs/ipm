do ##class(Uplift.Inst.Checks).Reset()
set sc=##class(%IPM.Main).Shell("zpm verify -only -DUnitTest.Case=Test.PM.Integration.BuildDependencyGraph") write !,"RESULT Test.PM.Integration.BuildDependencyGraph ",$select($system.Status.IsOK(sc):"OK",1:$translate($system.Status.GetErrorText(sc),$c(13,10),"  ")),!
do ##class(Uplift.Inst.Checks).Reset()
set sc=##class(%IPM.Main).Shell("zpm verify -only -DUnitTest.Case=Test.PM.Integration.DepNoVersion") write !,"RESULT Test.PM.Integration.DepNoVersion ",$select($system.Status.IsOK(sc):"OK",1:$translate($system.Status.GetErrorText(sc),$c(13,10),"  ")),!
for m="TestAllNoErrorModulesNoMirror","TestAllErrorModulesNoMirror","TestUpdateNonMatchingTarballFails","TestUpdateAfterInterruptedUpdate","TestModuleUpdateStepAdded","TestUpdateOfUninstalledModule","TestUpdateToOlderVersion","TestUpdateToInvalidVersion","TestUpdateToNewVersionTwice","TestUpdateToSameVersionTwiceNoMirror","TestSharedTransitiveDependencyUpdate","TestOffsetDiamondUpdate","TestDevModePropagation","TestDependencyVersionsUpdated" { do ##class(Uplift.Inst.Checks).Reset() set sc=##class(%IPM.Main).Shell("zpm verify -only -DUnitTest.Case=Test.PM.Integration.Update -DUnitTest.Method="_m) write !,"RESULT Test.PM.Integration.Update#",m," ",$select($system.Status.IsOK(sc):"OK",1:$translate($system.Status.GetErrorText(sc),$c(13,10),"  ")),! }
for m="Test01Module0Dependencies","Test02Module2Dependencies0Transient","Test03Module1Dependency2Transient","Test04Module2Dependencies1Transient","Test06ModuleMultipleVersions","Test07ModuleNoLockFile","Test09Module2DependenciesSameTransient","Test10ComplexNestedDependencies" { do ##class(Uplift.Inst.Checks).Reset() set sc=##class(%IPM.Main).Shell("zpm verify -only -DUnitTest.Case=Test.PM.Integration.LockFile -DUnitTest.Method="_m) write !,"RESULT Test.PM.Integration.LockFile#",m," ",$select($system.Status.IsOK(sc):"OK",1:$translate($system.Status.GetErrorText(sc),$c(13,10),"  ")),! }
do ##class(Uplift.Inst.Checks).Reset()
halt
