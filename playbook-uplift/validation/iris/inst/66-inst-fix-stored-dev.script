set sc=$system.OBJ.LoadDir("/tmp/uplift/Uplift/","ck-d",.err,1) write !,"LOAD probe ",$system.Status.IsOK(sc)," ",$system.Status.GetErrorText(sc),!
set sc=$system.OBJ.LoadDir("/tmp/uplift/inst/Uplift/","ck-d",.err,1) write !,"LOAD inst ",$system.Status.IsOK(sc)," ",$system.Status.GetErrorText(sc),!
write !,"IPMVER=",##class(%IPM.Storage.Module).NameOpen("zpm").VersionString,!
do ##class(Uplift.Inst.FixChecks).Main()
halt
