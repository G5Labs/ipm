set sc=$system.OBJ.LoadDir("/tmp/uplift/r4nsp/Uplift/","ck",,1) write !,"LOADED ",$system.Status.IsOK(sc),!
write !,"OBS|r4-nsp-collation-run1-residue|NCR4SNewColl=",##class(Uplift.R4Nsp.Probe).NewColl(##class(Uplift.R4Nsp.Probe).DbDir("NCR4S")),";",!
do ##class(Uplift.R4Nsp.Probe).Collation("2")
halt
