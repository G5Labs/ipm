write $zversion,!
set sc=$system.OBJ.Load("/home/irisowner/zpm/preload/cls/IPM/Installer.cls","ck") write !,"LOADSC ",sc,!
set sc=##class(IPM.Installer).setup("/home/irisowner/zpm/",3) write !,"SETUPSC ",sc,!
write !,"IPMVER=",##class(%IPM.Storage.Module).NameOpen("zpm").VersionString,!
set ^UpliftObsSuffix="@2025.3" write !,"SUFFIX=",^UpliftObsSuffix,!
halt
