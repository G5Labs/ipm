for m="TestDevModeRollbackNotCommitted","TestDevModeFailureAfterCommit","TestNoTransactionFailure","TestDevMode","TestInvalidHistoryCommands","TestHistoryModifiers","TestMultipleNamespaces","TestUpdate" { set sc=##class(%IPM.Main).Shell("zpm verify -only -quiet -DUnitTest.Case=Test.PM.Integration.History -DUnitTest.Method="_m) write !,"RESULT ",m," ",$select($system.Status.IsOK(sc):"OK",1:$system.Status.GetErrorText(sc)),! }
halt
