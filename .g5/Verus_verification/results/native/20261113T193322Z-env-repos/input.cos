set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT Name, Enabled, %CLASSNAME AS cls FROM %IPM_Repo.Definition") while rs.%Next() { write !,"OBS ENV repo=",rs.Name," enabled=",rs.Enabled," class=",rs.cls,! }
set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT TOP 5 ID, Name FROM %IPM_StudioDocument.ModuleStream ORDER BY ID DESC") while rs.%Next() { write !,"OBS ENV modstream=",rs.ID," ",rs.Name,! }
write !,"NATIVE-END",!
halt
