{
  "models": {
    "provenance.rs": {
      "wrong-qualified-supplier": [
        "server:r.repository,root:repo.root",
        "server:beta(),root:repo.root"
      ],
      "wrong-selected-root": [
        "root:repo.root,package:p",
        "root:Root::B,package:p"
      ],
      "ignore-enabled-filter": [
        "if !repo.enabled || !w.roots.contains_key(repo.root)",
        "if false || !w.roots.contains_key(repo.root)"
      ],
      "not-found-returns-success": [
        "None=>Result{ok:false,world:w,assessed:true},Some(q)",
        "None=>Result{ok:true,world:w,assessed:true},Some(q)"
      ],
      "drop-installed-supplier": [
        "supplier:q.server,root:q.root",
        "supplier:seq![],root:q.root"
      ],
      "wrong-installed-root": [
        "supplier:q.server,root:q.root",
        "supplier:q.server,root:Root::B"
      ],
      "wrong-code-payload": [
        "code:Some(q.package.payload)",
        "code:Some(0)"
      ],
      "wrong-history-supplier": [
        "Action::Install,q.package),q.server,filesystem()",
        "Action::Install,q.package),beta(),filesystem()"
      ],
      "drop-history-moniker": [
        "q.server,filesystem(),details(q.root)",
        "q.server,seq![],details(q.root)"
      ],
      "wrong-history-root": [
        "q.server,filesystem(),details(q.root)",
        "q.server,filesystem(),details(Root::B)"
      ],
      "delete-erases-history": [
        "World{repos:w.repos.remove(name),..w}",
        "World{repos:w.repos.remove(name),records:Map::empty(),..w}"
      ],
      "reconfigure-erases-history": [
        "World{repos:w.repos.insert(name,Repo{root,enabled}),..w}",
        "World{repos:w.repos.insert(name,Repo{root,enabled}),records:Map::empty(),..w}"
      ],
      "history-reader-looks-up-current-repo": [
        "Some(r)=>Some(source_view(r)),None=>None",
        "Some(r)=>if w.repos.contains_key(r.source){Some(source_view(Row{details:details(w.repos[r.source].root),..r}))}else{None},None=>None"
      ],
      "show-requires-current-definition": [
        "Some(m)=>if m.supplier.len()>0{Some(m.supplier)}",
        "Some(m)=>if m.supplier.len()>0 && w.repos.contains_key(m.supplier){Some(m.supplier)}"
      ],
      "list-requires-current-definition": [
        "Some(m)=>m.supplier==name",
        "Some(m)=>m.supplier==name && w.repos.contains_key(name)"
      ],
      "local-keeps-old-supplier": [
        "supplier:seq![],root}),code:Some(p.payload)",
        "supplier:supplier(w),root}),code:Some(p.payload)"
      ],
      "local-action-treated-as-install": [
        "receipt(w.next_id,Action::Load,p),1)",
        "receipt(w.next_id,Action::Install,p),1)"
      ],
      "skip-history-finalization": [
        "pub open spec fn persist(r:Row)->Row {Row{finalized:true,..r}}",
        "pub open spec fn persist(r:Row)->Row {Row{finalized:false,..r}}"
      ],
      "details-omits-module-pattern": [
        "root_text(root)+seq![42u8,47,109,111,100,117,108,101,46,120,109,108]",
        "root_text(root)+seq![42u8]"
      ],
      "uninstall-projection-keeps-module": [
        "pub open spec fn successful_uninstall(w:World)->World {World{module:None,code:None,..w}}",
        "pub open spec fn successful_uninstall(w:World)->World {World{module:w.module,code:None,..w}}"
      ],
      "uninstall-projection-keeps-code": [
        "pub open spec fn successful_uninstall(w:World)->World {World{module:None,code:None,..w}}",
        "pub open spec fn successful_uninstall(w:World)->World {World{module:None,code:w.code,..w}}"
      ],
      "uninstall-projection-erases-old-history": [
        "pub open spec fn successful_uninstall(w:World)->World {World{module:None,code:None,..w}}",
        "pub open spec fn successful_uninstall(w:World)->World {World{module:None,code:None,records:Map::empty(),..w}}"
      ],
      "claims-nonfresh-install-is-assessed": [
        "if !fresh_install(w) {Result{ok:false,world:w,assessed:false}}",
        "if false {Result{ok:false,world:w,assessed:false}}"
      ]
    }
  },
  "session": [
    "do $system.OBJ.Load(\"/tmp/iter16/Provenance.cls\",\"ck\")",
    "do ##class(Iter16.Provenance).Run()"
  ],
