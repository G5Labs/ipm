    "if !configurable(k) { Out { not_found: true, ..out(slots) } }\n    else if k == TRF()",
    "if !configurable(k) { Out { not_found: true, ok: false, ..out(slots) } }\n    else if k == TRF()"
   ],
   "format-not-validated": [
    "else if k == TRF() && !valid_format(v) { Out { error: true, ..out(slots) } }",
    "else if false { Out { error: true, ..out(slots) } }"
   ],
   "first-write-not-default": [
    "Slot { value: v, has_default: true, default: if s.has_default { s.default } else { v } }",
    "Slot { value: v, ..s }"
   ],
   "analytics-text-enabled": [
    "pub open spec fn analytics_disabled(v: int) -> bool { v <= 0 || v >= 1000 }",
