{
  "models": {
    "scope.rs": {
      "ignore-resource-scope": [
        "if !has_scope(phases,r.declared)",
        "if false"
      ],
      "ignore-returned-scope": [
        "if !has_scope(phases,children.returned_scope)",
        "if false"
      ],
      "lose-phase-producer": [
        "returned_scope:r.phase",
        "returned_scope:seq![Phase::Test]"
      ],
      "leak-scope-metadata": [
        "else {base},metadata:false",
        "else {base},metadata:children.metadata"
      ],
      "omit-path-readdition": [
        "base.insert(r.name)",
        "base"
      ],
      "defensive-path-handled": [
        "pub open spec fn test_path_export_handled()->bool {false}",
        "pub open spec fn test_path_export_handled()->bool {true}"
      ],
      "path-copy-handled": [
        "path_has_processor() && test_path_export_handled()",
        "true"
      ],
      "ignore-include-flag": [
        "Some(b)=>b,None=>manifest",
        "Some(b)=>manifest,None=>manifest"
      ],
      "ignore-explicit-zero": [
        "Some(b)=>b,None=>manifest",
        "Some(b)=>b || manifest,None=>manifest"
      ],
      "lose-file-payload": [
        "|p:Text|source[p]",
        "|p:Text|seq![]"
      ],
      "directory-prefix-not-normalized": [
        "prefix(directory_prefix(r.name),p)",
        "prefix(r.name,p)"
      ],
      "omitted-clears-stored-include": [
        "Some(value)=>value,None=>old",
        "Some(value)=>value,None=>false"
      ],
      "explicit-false-does-not-reset": [
        "Some(value)=>value,None=>old",
        "Some(value)=>value || old,None=>old"
      ],
      "command-writes-stored-include": [
        "PackageState{stored,contents:",
        "PackageState{stored:match command {Some(value)=>value,None=>stored},contents:"
      ]
    }
  },
  "session": [
    "do $system.OBJ.Load(\"/tmp/iter10/Packaging.cls\",\"ck\")",
    "do ##class(Iter10.Packaging).Run()"
  ],
  "replay_model": "scope.rs",
  "replay": {
    "ut-direct-path": "b(unit_children(fixture(Phase::Test)).paths.contains(fixture(Phase::Test).name))",
    "ut-direct-scope": "b(unit_children(fixture(Phase::Test)).metadata)",
    "ut-filter-resource": "b(references(split_scope(),seq![Phase::Test]).paths.contains(split_scope().name))",
    "ut-filter-returned": "b(references(split_scope(),seq![Phase::Verify]).paths.contains(split_scope().name))",
    "ut-filter-both": "b(references(split_scope(),seq![Phase::Test,Phase::Verify]).paths.contains(split_scope().name))",
    "ut-meta-leak": "b(references(split_scope(),seq![Phase::Test,Phase::Verify]).metadata)",
    "ut-path-processor": "b(path_has_processor())",
    "ut-path-handled": "b(test_path_export_handled())",
    "pkg-default-stored": "b(matrix(0).stored)",
    "pkg-default-test": "b(matrix(0).contents.contains_key(filename()))",
