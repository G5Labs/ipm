    "pkg-flag-bytes": "b(matrix(1).contents.contains_key(filename()) && matrix(1).contents[filename()]==source()[filename()])",
    "pkg-flag-manifest": "b(matrix(1).contents.contains_key(manifest_path()))",
    "pkg-manifest-stored": "b(matrix(2).stored)",
    "pkg-manifest-test": "b(matrix(2).contents.contains_key(filename()))",
    "pkg-manifest-bytes": "b(matrix(2).contents.contains_key(filename()) && matrix(2).contents[filename()]==source()[filename()])",
    "pkg-manifest-manifest": "b(matrix(2).contents.contains_key(manifest_path()))",
    "pkg-zero-stored": "b(matrix(3).stored)",
    "pkg-zero-test": "b(matrix(3).contents.contains_key(filename()))",
    "pkg-zero-bytes": "b(matrix(3).contents.contains_key(filename()) && matrix(3).contents[filename()]==source()[filename()])",
    "pkg-zero-manifest": "b(matrix(3).contents.contains_key(manifest_path()))",
    "pkg-sticky-stored": "b(matrix(4).stored)",
    "pkg-sticky-test": "b(matrix(4).contents.contains_key(filename()))",
    "pkg-sticky-bytes": "b(matrix(4).contents.contains_key(filename()) && matrix(4).contents[filename()]==source()[filename()])",
    "pkg-sticky-manifest": "b(matrix(4).contents.contains_key(manifest_path()))",
    "pkg-verify-flag-stored": "b(matrix(5).stored)",
    "pkg-verify-flag-test": "b(matrix(5).contents.contains_key(filename()))",
    "pkg-verify-flag-bytes": "b(matrix(5).contents.contains_key(filename()) && matrix(5).contents[filename()]==source()[filename()])",
    "pkg-verify-flag-manifest": "b(matrix(5).contents.contains_key(manifest_path()))",
    "pkg-verify-default-stored": "b(matrix(6).stored)",
