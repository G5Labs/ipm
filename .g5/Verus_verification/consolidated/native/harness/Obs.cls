/// Observation harness for the consolidated uplift (not IPM product code). Prints "OBS <case> <field>=<value>" lines.
Class Consolidated.Obs
{

ClassMethod Run(case As %String, cmd As %String) As %Status
{
    set tl = $tlevel
    write !,"CMD ",case," ",cmd,!
    set sc = ##class(%IPM.Main).Shell(cmd)
    write !,"OBS ",case," status=",$select($system.Status.IsOK(sc):"OK",1:"ERR"),!
    if $system.Status.IsError(sc) {
        write "OBS ",case," error=",$translate($piece($system.Status.GetErrorText(sc),$char(13,10),1),$char(10,13),"  "),!
    }
    write "OBS ",case," tlevel.before=",tl," tlevel.after=",$tlevel,!
    quit sc
}

ClassMethod Mod(case As %String, name As %String)
{
    set m = ##class(%IPM.Storage.Module).NameOpen($zconvert(name,"L"))
    if '$isobject(m) { write "OBS ",case," mod.",name,"=absent",! quit }
    write "OBS ",case," mod.",name,"=present version=",m.VersionString," repo=",m.Repository," desc=",m.Description," dev=",+m.DeveloperMode,!
}

ClassMethod Repos(case As %String)
{
    set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT ID, Name, %IPM_Repo.Definition_SortOrder(ID) AS SO FROM %IPM_Repo.Definition ORDER BY ID")
    set n = 0
    while rs.%Next() {
        set n = n + 1
        set r = ##class(%IPM.Repo.Definition).%OpenId(rs.ID)
        set root = $select(r.%IsA("%IPM.Repo.Filesystem.Definition"):r.Root,1:"")
        write "OBS ",case," repo.",rs.Name,"=id:",rs.ID," sort:",rs.SO," root:",root,!
    }
    write "OBS ",case," repos.count=",n,!
}

ClassMethod Hist(case As %String, pkg As %String)
{
    set rs = ##class(%SQL.Statement).%ExecDirect(,"SELECT TOP 1 ID, Action, Success, Committed, Finalized FROM %IPM_General.History WHERE Package = ? ORDER BY ID DESC", pkg)
    if 'rs.%Next() { write "OBS ",case," hist.",pkg,"=none",! quit }
    write "OBS ",case," hist.",pkg,"=action:",rs.Action," success:",$select(rs.Success=1:1,1:0)," committed:",rs.Committed," finalized:",rs.Finalized,!
}


ClassMethod Cls(case As %String, cls As %String)
{
    set def = ##class(%Dictionary.ClassDefinition).%ExistsId(cls)
    set comp = ##class(%Dictionary.CompiledClass).%ExistsId(cls)
    set run = 0
    if comp { try { set run = $classmethod(cls, $select(cls[".A":"Ok",1:"Bad")) } catch { set run = "err" } }
    write "OBS ",case," cls.",cls,"=def:",def," compiled:",comp," runs:",run,!
}


ClassMethod ZpmVersion(case As %String, name As %String)
{
    set m = ##class(%IPM.Storage.Module).NameOpen(name)
    set doc = ##class(%Library.RoutineMgr).%OpenId(name_".ZPM"), v = ""
    if $isobject(doc) { do doc.Code.Rewind() set t = doc.Code.Read(32000) set v = $piece($piece(t,"<Version>",2),"</Version>") }
    write "OBS ",case," mv=",$select($isobject(m):m.VersionString,1:"absent")," doc=",v,!
}

ClassMethod HoldLock(id As %String, seconds As %Integer)
{
    set sc = ##class(%IPM.Repo.Definition).%LockId(id)
    set ^Consolidated.Probe("held") = $system.Status.IsOK(sc)
    hang seconds
    do ##class(%IPM.Repo.Definition).%UnlockId(id)
    set ^Consolidated.Probe("held") = 0
}

ClassMethod ProbeLock(id As %String)
{
    set sc = ##class(%IPM.Repo.Definition).%LockId(id, 0, 0)
    set ^Consolidated.Probe("probe") = $system.Status.IsOK(sc)
    if $system.Status.IsOK(sc) { do ##class(%IPM.Repo.Definition).%UnlockId(id) }
}

ClassMethod ZLang(case As %String)
{
    set out = ""
    for rtn = "%ZLANGC00.MAC", "%ZLANGF00.MAC" {
        set r = ##class(%Routine).%New(rtn), starts = 0, users = 0, lines = 0
        if ##class(%Routine).Exists(rtn) { while 'r.AtEnd { set l = r.ReadLine(), lines = lines + 1 if $match(l, "^ ;Generated by (%IPM.Main|%ZPM.PackageManager): Start$") { set starts = starts + 1 } if l [ "consolidated-user-line" { set users = users + 1 } } }
        set out = out_" "_$piece(rtn,".")_"=starts:"_starts_",user:"_users
    }
    write "OBS ",case," zlang=",$zstrip(out,"<W"),!
}


ClassMethod EnvRecord()
{
    set ^Consolidated.Env($increment(^Consolidated.Env)) = ##class(%IPM.General.EnvironmentConfig).%Get().GetArg("envmod", "greeting")
}

ClassMethod EnvLoad(case As %String, paths As %String)
{
    set ok = 1, err = ""
    try { do ##class(%IPM.Lifecycle.Base).LoadEnvironmentConfig(paths) } catch ex { set ok = 0, err = $piece($system.Status.GetErrorText(ex.AsStatus()),$char(13,10)) }
    set c = ##class(%IPM.General.EnvironmentConfig).%Get()
    set l = c.GetArg("envmod","list"), ls = ""
    if $isobject(l) { set it = l.%GetIterator() while it.%GetNext(.k,.v) { set ls = ls_v_"," } }
    write "OBS ",case," ok=",ok," empty=",c.IsEmpty()," greeting=",c.GetArg("envmod","greeting")," x=",c.GetArg("envmod","nested","x")," y=",c.GetArg("envmod","nested","y")," list=",ls," k=",$select($isobject(c.GetArg("envmod","k")):"object",1:c.GetArg("envmod","k")),!
    if 'ok { write "OBS ",case," error=",$translate(err,$char(10)," "),! }
}


ClassMethod LockInTx(case As %String, id As %String)
{
    set tl0 = $tlevel
    tstart
    set r = ##class(%IPM.Repo.Filesystem.Definition).%OpenId(id)
    set sc = r.BuildCache(1,0,0)
    set tl = $tlevel
    kill ^Consolidated.Probe("probe")
    job ##class(Consolidated.Obs).ProbeLock(id)
    for i=1:1:50 { quit:$data(^Consolidated.Probe("probe"))  hang 0.2 }
    write "OBS ",case," build=",$system.Status.IsOK(sc)," tlevel.inside=",tl," lockable=",$get(^Consolidated.Probe("probe"),"none"),!
    trollback
    write "OBS ",case," tlevel.after=",$tlevel," entry=",tl0,!
}

}
