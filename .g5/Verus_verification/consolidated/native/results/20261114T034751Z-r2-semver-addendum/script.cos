set SV="%IPM.General.SemanticVersion", EX="%IPM.General.SemanticVersionExpression"
do ##class(%IPM.Repo.UniversalSettings).SetValue("SemVerPostRelease",0)
set vl=$listbuild("0.0.1","0.1.0","0.1.5","1.0.0-alpha","1.0.0-beta","1.0.0","1.0.0+snapshot","1.1.0-beta","1.2.0","1.2.3","1.3.0","2.0.0-beta.1","2.0.0","2.5.0","3.0.0","2024.1.0","2024.1.2","2024.12.0","1.2.3+build-x")
set xl=$listbuild("<1.0.0",">1.0.0","<=1.0.0")
for i=1:1:$listlength(xl) { set s=$list(xl,i) do $classmethod(EX,"FromString",s,.e) set bits="" for j=1:1:$listlength(vl) { set bits=bits_e.IsSatisfiedBy($classmethod(SV,"FromString",$list(vl,j))) } write "OBS Y",i," res=",e.ToResolvedString()," sat=",bits,! }
set al=$listbuild($lb("1.0.0",">=2.0.0"),$lb(">=2.0.0","1.0.0"))
for i=1:1:$listlength(al) { set p=$list(al,i) try { do $classmethod(EX,"FromString",$list(p,1),.a) do $classmethod(EX,"FromString",$list(p,2),.b) set r=a.And(b) write "OBS B",i+1," res=",r.ToResolvedString(),! } catch ex { write "OBS B",i+1," err=",$piece($system.Status.GetErrorText(ex.AsStatus()),$char(13,10)),! } }
write !,"NATIVE-END",!
halt
