// Held-back case: a downgrade between prereleases of different versions; neighbors with releases.
do ##class(Consolidated.Obs).Run("HB1","load /tmp/c5h/hb-2beta/") do ##class(Consolidated.Obs).Mod("HB1","hb-pre")
do ##class(Consolidated.Obs).Run("HB2","load /tmp/c5h/hb-1rc/") do ##class(Consolidated.Obs).Mod("HB2","hb-pre")
do ##class(Consolidated.Obs).Run("HR1","load /tmp/c5h/hr-2/") do ##class(Consolidated.Obs).Mod("HR1","hb-rel")
do ##class(Consolidated.Obs).Run("HR2","load /tmp/c5h/hr-1/") do ##class(Consolidated.Obs).Mod("HR2","hb-rel")
do ##class(Consolidated.Obs).Run("HM1","load /tmp/c5h/hm-2beta/") do ##class(Consolidated.Obs).Mod("HM1","hb-mix")
do ##class(Consolidated.Obs).Run("HM2","load /tmp/c5h/hm-1/") do ##class(Consolidated.Obs).Mod("HM2","hb-mix")
write !,"NATIVE-END",!
halt
