do ##class(Consolidated.Obs).Run("R2txn","load /tmp/c1r/two-txn/")
do ##class(Consolidated.Obs).Mod("R2txn","tworec-txn") do ##class(Consolidated.Obs).Hist("R2txn","tworec-txn")
do ##class(Consolidated.Obs).Cls("R2txn","TwoResTxn.A") do ##class(Consolidated.Obs).Cls("R2txn","TwoResTxn.B")
do ##class(Consolidated.Obs).Run("R2notxn","load /tmp/c1r/two-notxn/ -DNoTransaction=1")
do ##class(Consolidated.Obs).Mod("R2notxn","tworec-notxn") do ##class(Consolidated.Obs).Hist("R2notxn","tworec-notxn")
do ##class(Consolidated.Obs).Cls("R2notxn","TwoResNotxn.A") do ##class(Consolidated.Obs).Cls("R2notxn","TwoResNotxn.B")
do ##class(Consolidated.Obs).Run("R2dev","load /tmp/c1r/two-dev/ -dev")
do ##class(Consolidated.Obs).Mod("R2dev","tworec-dev") do ##class(Consolidated.Obs).Hist("R2dev","tworec-dev")
do ##class(Consolidated.Obs).Cls("R2dev","TwoResDev.A") do ##class(Consolidated.Obs).Cls("R2dev","TwoResDev.B")
do ##class(Consolidated.Obs).Run("R2ok","load /tmp/c1r/two-ok/")
do ##class(Consolidated.Obs).Mod("R2ok","tworec-ok") do ##class(Consolidated.Obs).Hist("R2ok","tworec-ok")
do ##class(Consolidated.Obs).Cls("R2ok","TwoResOk.A") do ##class(Consolidated.Obs).Cls("R2ok","TwoResOk.B")
write !,"NATIVE-END",!
halt
