{
  "models": {
    "webapps.rs": {
      "jwt-swap-timeouts": [
        "Key::AccessTimeout=>raw.access,Key::RefreshTimeout=>raw.refresh",
        "Key::AccessTimeout=>raw.refresh,Key::RefreshTimeout=>raw.access"
      ],
      "jwt-ignore-prompt": [
        "if prompt.contains_key(k){prompt[k]}",
        "if false{prompt[k]}"
      ],
      "omit-authentication-default": [
        ".insert(Key::Authentication)",
        ""
      ],
      "copy-namespace": [
        "k==Key::Namespace || k==Key::Name",
        "k==Key::Name"
      ],
      "path-stays-literal": [
        "if prefix(csp_root,raw)",
        "if false"
      ],
      "dispatch-keeps-file-path": [
        "if dispatch!=0 {None}",
        "if false {None}"
      ],
      "copy-loses-target": [
        "{generated}",
        "{None}"
      ],
      "webapp-export-falls-back": [
        "fn webapp_export_handled()->bool {true}",
        "fn webapp_export_handled()->bool {false}"
      ],
      "uninstall-keeps-app": [
        "{apps.remove(name)}",
        "{apps}"
      ],
      "reinstall-loses-suffix": [
        "apps.insert(name,evaluate_path(archived,csp_root))",
        "apps.insert(name,csp_root)"
      ],
      "external-flag-ignored": [
        "if use_external{external}else{internal}",
        "internal"
      ],
      "external-renames-manifest": [
        "fn archive_manifest_name(internal:int,external:int,use_external:bool)->int {internal}",
        "fn archive_manifest_name(internal:int,external:int,use_external:bool)->int {external}"
      ],
      "copy-discards-content": [
        "+seq![name],source[name])",
        "+seq![name],0)"
      ],
      "package-drops-declaration": [
        "Some(Archive{path:declared})",
        "Some(Archive{path:PathExpr::Csp(seq![])})"
      ],
      "publish-does-not-store": [
        "if provider_ok {registry.insert(key,archive)}",
        "if false {registry.insert(key,archive)}"
      ]
    },
    "catalog.rs": {
      "versions-ascending": [
        "v>=sorted[0]",
        "v<=sorted[0]"
      ],
      "upper-bound-inclusive": [
        "raw[0]<b",
        "raw[0]<=b"
      ],
      "group-multiple-rows": [
        "rows:if list.len()>0{1}else{0}",
        "rows:list.len()"
      ],
      "group-drops-list": [
        "versions:if all_versions{list}else{seq![]}",
        "versions:seq![]"
      ],
      "platform-deployed-always-visible": [
        "!a.deployed || a.platforms.contains(current)",
        "true"
      ],
      "platform-list-bypasses-filter": [
        "show_all || compatible(a,current)",
        "true"
      ],
      "platform-install-bypasses-filter": [
        "{compatible(a,current)}",
        "{true}"
      ],
      "deployed-tag-loses-platform": [
        "Some(Tag::Deployed(a.version,p))",
        "Some(Tag::Source(a.version))"
      ]
    },
    "python.rs": {
      "bypass-skips-explicit-wheel": [
        "if exists && pip_ok",
        "if exists && pip_ok && !bypass"
      ],
      "wheel-clean-deletes": [
        "installed:Some(installed_before)},\n Phase::Other",
        "installed:Some(false)},\n Phase::Other"
      ],
      "missing-wheel-swallowed": [
        "ok:module==1",
        "ok:true"
      ],
      "ipm-wheel-error-fatal": [
        "ok:module==1",
        "ok:false"
      ],
      "wheel-clean-unhandled": [
        "Phase::Clean=>Wheel{pip_called:false,handled:true",
        "Phase::Clean=>Wheel{pip_called:false,handled:false"
      ],
      "pip-keeps-empty-args": [
        "if args[0].len()==0 {rest}",
        "if false {rest}"
      ],
      "pip-error-assumes-rollback": [
        "installed:if exists {None}else{Some(installed_before)}",
        "installed:Some(installed_before)"
      ]
    }
  },
  "session": [
    "do $system.OBJ.Load(\"/tmp/iter8/Probe.cls\",\"ck\")",
    "do ##class(Iter8.Probe).Generated()",
    "do ##class(Iter8.Probe).WebRoundtrip()",
    "do ##class(Iter8.Probe).Catalog()",
    "do ##class(Iter8.Probe).Platform()",
    "do ##class(Iter8.Probe).Python()",
    "do ##class(Iter8.Probe).External()"
  ],
  "replay_model": "all.rs",
  "replay": {
    "gen-csp-only": "b(generated_path(7,Some(seq![1int,2,3]),seq![1int,2])==None)",
    "gen-path-expression": "b(matches!(manifest_path(seq![1int,2,3],seq![1int,2]),PathExpr::Csp(_)))",
    "gen-copy-expression": "b(filecopy_target(generated_path(0,Some(seq![1int,2,3]),seq![1int,2])).is_some())",
    "gen-jwt-enabled": "generated_props(map![Key::Authentication=>1int,Key::Dispatch=>7int],map![Key::Authentication=>1int],jwt_prompt(Jwt{enable:1,access:120,refresh:1800}))[Key::JwtEnabled]",
    "gen-jwt-access": "generated_props(map![Key::Authentication=>1int,Key::Dispatch=>7int],map![Key::Authentication=>1int],jwt_prompt(Jwt{enable:1,access:120,refresh:1800}))[Key::AccessTimeout]",
    "gen-jwt-refresh": "generated_props(map![Key::Authentication=>1int,Key::Dispatch=>7int],map![Key::Authentication=>1int],jwt_prompt(Jwt{enable:1,access:120,refresh:1800}))[Key::RefreshTimeout]",
    "gen-path": "b(evaluate_path(manifest_path(seq![1int,2,3],seq![1int,2]),seq![1int,2])==seq![1int,2,3])",
    "gen-copied-file": "b(filecopy_target(generated_path(0,Some(seq![1int,2,3]),seq![1int,2])).is_some())",
    "web-publish": "b(package_webapp(PathExpr::Csp(seq![3int]),false).is_some())",
    "web-absent": "b(!uninstall(map![7int=>seq![1int,2,3]],7).contains_key(7))",
    "web-path-same": "b(package_roundtrip(map![7int=>seq![1int,2,3]],7,PathExpr::Csp(seq![3int]),seq![1int,2])[7]==seq![1int,2,3])",
    "catalog-count": "grouped(seq![1int,3,2],None,true).rows as int",
    "catalog-selected": "grouped(seq![1int,3,2],None,true).selected.unwrap()",
    "catalog-all": "b(grouped(seq![1int,3,2],None,true).versions==seq![3int,2,1])",
    "catalog-limited-count": "grouped(seq![1int,3,2],Some(3),true).rows as int",
    "catalog-limited-selected": "grouped(seq![1int,3,2],Some(3),true).selected.unwrap()",
    "catalog-limited-all": "b(grouped(seq![1int,3,2],Some(3),true).versions==seq![2int,1])",
    "platform-visible": "b(catalog_visible(Artifact{version:1,deployed:true,platforms:set![26int]},26,false))",
    "platform-reported": "b(reported_platform(Artifact{version:1,deployed:true,platforms:set![26int]},26)==Some(26))",
    "platform-install-compatible": "b(install_candidate(Artifact{version:1,deployed:true,platforms:set![26int]},26))",
    "platform-incompatible-visible": "b(catalog_visible(Artifact{version:1,deployed:true,platforms:set![9999int]},26,false))",
    "platform-incompatible-install": "b(install_candidate(Artifact{version:1,deployed:true,platforms:set![9999int]},26))",
    "wheel-load": "b(wheel(2,Phase::Initialize,true,true,true,false).ok)",
    "wheel-version": "b(wheel(2,Phase::Initialize,true,true,true,false).installed==Some(true))",
    "wheel-kept": "b(wheel(2,Phase::Clean,false,true,true,true).installed==Some(true))",
    "wheel-missing-other": "b(wheel(2,Phase::Initialize,false,false,false,false).ok)",
    "wheel-missing-other-handled": "b(wheel(2,Phase::Initialize,false,false,false,false).handled)",
    "wheel-missing-ipm": "b(wheel(1,Phase::Initialize,false,false,false,false).ok)",
    "wheel-missing-ipm-handled": "b(wheel(1,Phase::Initialize,false,false,false,false).handled)",
    "external-manifest-internal": "b(archive_manifest_name(1,2,true)==1)",
    "external-manifest-external": "b(archive_manifest_name(1,2,true)==2)",
    "gen-copied-bytes": "b(copy_one(Map::empty(),map![5int=>77int],5,Some(PathExpr::Csp(seq![3int])),seq![1int,2])[seq![1int,2,3,5]]==77)"
  },
  "replay_preludes": {
    "catalog-count": "sort_three();sort_two();filter_three();\n",
    "catalog-selected": "sort_three();sort_two();filter_three();\n",
    "catalog-all": "sort_three();sort_two();filter_three();\n",
    "catalog-limited-count": "sort_three();sort_two();filter_three();\n",
    "catalog-limited-selected": "sort_three();sort_two();filter_three();\n",
    "catalog-limited-all": "sort_three();sort_two();filter_three();\n",
    "gen-path": "assert(evaluate_path(manifest_path(seq![1int,2,3],seq![1int,2]),seq![1int,2]) =~= seq![1int,2,3]);\n",
    "web-path-same": "assert(package_roundtrip(map![7int=>seq![1int,2,3]],7,PathExpr::Csp(seq![3int]),seq![1int,2])[7] =~= seq![1int,2,3]);\n",
    "gen-copied-bytes": "assert(evaluate_path(PathExpr::Csp(seq![3int]),seq![1int,2])+seq![5int] =~= seq![1int,2,3,5]);\n"
  },
  "native_expected": {
    "gen-load": 1,
    "web-load": 1,
    "repo-oras": 1,
    "web-publish": 1,
    "web-uninstall": 1,
    "web-install": 1,
    "catalog-repo": 1,
    "platform-load": 1,
    "platform-package": 1,
    "platform-publish-compatible": 1,
    "platform-remove-local": 1,
    "platform-install-compatible": 1,
    "platform-code-version": 1,
    "platform-remove-again": 1,
    "platform-unpublish": 1,
    "platform-reload": 1,
    "platform-repackage": 1,
    "platform-publish-incompatible": 1,
    "platform-remove-bad-local": 1,
    "wheel-load": 1,
    "wheel-uninstall": 1,
    "external-load": 1,
    "external-publish": 1,
    "external-uninstall": 1,
    "external-install": 1
  }
}
