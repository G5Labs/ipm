{
  "models": {
    "ownership.rs": {
      "children-before-unique": [
        "match find_unique(w,n,0){Some(i)=>Some(i),None=>find_child(w,n,0)}",
        "match find_child(w,n,0){Some(i)=>Some(i),None=>find_unique(w,n,0)}"
      ],
      "null-owner-unique-row-filtered": [
        "if lookup_key(w.refs[i as int].unique_name)==lookup_key(n)",
        "if lookup_key(w.refs[i as int].unique_name)==lookup_key(n) && owner_object(w,i).is_some()"
      ],
      "reference-existence-creates-owner": [
        "Some(n)=>if w.modules.contains(n){Some(n)}else{None},None=>None",
        "Some(n)=>if w.modules.contains(n){Some(n)}else{None},None=>Some(exact_module())"
      ],
      "dangling-owner-treated-as-object": [
        "if w.modules.contains(n){Some(n)}else{None}",
        "Some(n)"
      ],
      "naming-fallback-disabled": [
        "if first.module.is_some(){first}else{naming_pass(w,module_candidates(c),candidates(c,e),0,first.ref_id)}",
        "first"
      ],
      "naming-precedes-explicit-reference": [
        "if first.module.is_some(){first}else{naming_pass(w,module_candidates(c),candidates(c,e),0,first.ref_id)}",
        "{let named=naming_pass(w,module_candidates(c),candidates(c,e),0,first.ref_id);if named.module.is_some(){named}else{first}}"
      ],
      "shortest-naming-prefix-first": [
        "Class::Named=>seq![named_full_module(),naming_module()]",
        "Class::Named=>seq![naming_module(),named_full_module()]"
      ],
      "package-before-exact-class": [
        "seq![identifier(c,e),package(c)]",
        "seq![package(c),identifier(c,e)]"
      ],
      "lower-extension-takes-CLS-package-branch": [
        "if e==Extension::Upper{seq![identifier(c,e),package(c)]}",
        "if true{seq![identifier(c,e),package(c)]}"
      ],
      "upper-extension-loses-package-branch": [
        "if e==Extension::Upper{seq![identifier(c,e),package(c)]}",
        "if false{seq![identifier(c,e),package(c)]}"
      ],
      "lower-identifier-silently-uppercased": [
        "else{seq![identifier(c,e),identifier(c,e)]}",
        "else{seq![identifier(c,Extension::Upper),identifier(c,Extension::Upper)]}"
      ],
      "lower-SQL-lookup-does-not-match-declaration": [
        "if n==loose_lower(){loose_upper()}else if n==named_lower(){named_upper()}else{n}",
        "n"
      ],
      "naming-clears-prior-reference": [
        "naming_pass(w,module_candidates(c),candidates(c,e),0,first.ref_id)",
        "naming_pass(w,module_candidates(c),candidates(c,e),0,None)"
      ],
      "missing-candidate-clears-prior-reference": [
        "None=>ref_pass(w,cs,i+1,last)",
        "None=>ref_pass(w,cs,i+1,None)"
      ],
      "imported-reference-has-wrong-owner": [
        "owner:Some(m.name),children:seq![]",
        "owner:Some(naming_module()),children:seq![]"
      ],
      "empty-module-invents-reference": [
        "import_refs(World{modules:w.modules.insert(m.name),..w},m,0)",
        "{let imported=import_refs(World{modules:w.modules.insert(m.name),..w},m,0);if m.resources.len()==0{World{refs:imported.refs+seq![Reference{unique_name:named_upper(),owner:Some(m.name),children:seq![]}],..imported}}else{imported}}"
      ],
      "children-appended-instead-of-replaced": [
        "Reference{children:names,..w.refs[id as int]}",
        "Reference{children:w.refs[id as int].children+names,..w.refs[id as int]}"
      ],
      "compiled-source-has-wrong-payload": [
        "code:w.code.insert(s.class_id,s.returns)",
        "code:w.code.insert(s.class_id,2)"
      ],
      "empty-module-removes-physical-code": [
        "World{modules:w.modules.insert(m.name),..w}",
        "World{modules:w.modules.insert(m.name),code:Map::empty(),..w}"
      ],
      "orphans-predicate-inverted": [
        "if home(w,c,Extension::Lower).module.is_none()",
        "if home(w,c,Extension::Lower).module.is_some()"
      ],
      "fetch-does-not-advance": [
        "cursor:q.cursor+1,..q",
        "cursor:q.cursor,..q"
      ],
      "fetch-does-not-report-end": [
        "Fetch{row:None,next:q,at_end:true}",
        "Fetch{row:None,next:q,at_end:false}"
      ],
      "close-keeps-query-rows": [
        "Query{rows:seq![],cursor:0,closed:true}",
        "Query{rows:q.rows,cursor:0,closed:true}"
      ],
      "consumer-reverses-row-order": [
        "names:seq![n]+rest.names",
