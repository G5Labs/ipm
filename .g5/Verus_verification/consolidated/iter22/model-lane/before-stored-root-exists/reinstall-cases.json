      "caller-chooses-latest-v2": [
        "Some(m.version)",
        "Some(two())"
      ],
      "caller-uses-stored-supplier": [
        "match search(entered,a.name,v){",
        "match (if eligible(entered,Entry{repository:p::supplier(w.base),place:Place::BetaOne},a.name,v){Some(choice(entered,Entry{repository:p::supplier(w.base),place:Place::BetaOne}))}else{None}){"
      ],
      "catalog-ignores-enabled": [
        "w.base.repos[e.repository].enabled && w.files.contains_key(e.place)",
        "true && w.files.contains_key(e.place)"
      ],
      "catalog-reverses-repository-age": [
        "repository_id:c.age,local:false",
        "repository_id:if c.entry.repository==alpha(){2}else{0},local:false"
      ],
      "catalog-first-visited-wins": [
        "if inherited_search::select(rank(a),rank(b))==rank(a){a}else{b}",
        "a"
