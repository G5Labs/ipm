        "w.files[e.place].name==name && w.files[e.place].version==v",
        "w.files[e.place].name==name"
      ],
      "deletion-keeps-live-definition": [
        "base:p::delete_repo(w.base,n),created:w.created.remove(n)",
        "base:w.base,created:w.created.remove(n)"
      ],
