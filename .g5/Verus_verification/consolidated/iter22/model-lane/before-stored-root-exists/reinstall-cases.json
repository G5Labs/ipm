        "None=>Outcome{world:World{base:p::World{module:None,code:None,..entered.base},..entered},requested:Some(v),selected:None,delegated:true"
      ],
      "delegated-failure-drops-record-effect": [
        "None=>Outcome{world:entered,requested:Some(v),selected:None,delegated:true",
