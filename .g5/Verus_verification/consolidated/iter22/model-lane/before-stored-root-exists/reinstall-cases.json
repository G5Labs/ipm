      ],
      "no-repository-becomes-success": [
        "history:HistoryEffect::FailedInstallFieldsUnknown,ok:false,assessed:true",
        "history:HistoryEffect::FailedInstallFieldsUnknown,ok:true,assessed:true"
      ],
      "dev-uses-stored-root-without-repository": [
        "history:HistoryEffect::FailedInstallFieldsUnknown,ok:false,assessed:true",
        "history:HistoryEffect::FailedInstallFieldsUnknown,ok:a.dev && root_exists(w),assessed:true"
      ],
      "no-repository-clears-current-module": [
