    "retry-shell": "b(retry().state.active.contains(1))",
    "retry-exception": "b(!retry().state.active.contains(1))",
    "pending-other-pkg": "b(late().state.cfg.contains(1))",
    "pending-other-rtn": "b(late().state.cfg.contains(1))",
    "pending-other-active": "b(late().state.active.contains(1))",
    "pending-other-callable": "b(late().state.active.contains(1))",
    "pending-other-shell": "b(late().state.active.contains(1))",
    "pending-other-exception": "b(!late().state.active.contains(1))",
    "valid-pkg": "b(other().state.cfg.contains(4))",
