{
  "models": {
    "batch.rs": {
      "rollback-failed-prefix": [
        "Scan{state:s,ok:false,marked:Set::empty()}",
        "Scan{state:empty(),ok:false,marked:Set::empty()}"
      ],
      "accept-missing-target": [
        "else if !existing.contains(targets[0])",
        "else if false"
      ],
      "preview-writes": [
        "let next=if preview{s}else{S{cfg:s.cfg.insert(targets[0]),..s}};",
        "let next=S{cfg:s.cfg.insert(targets[0]),..s};"
      ],
      "activate-on-failure": [
        "let activate=scan.ok && !preview",
        "let activate=!preview"
      ],
      "retry-needs-new-rows": [
        "rest.marked.insert(targets[0])",
        "if s.cfg.contains(targets[0]){rest.marked}else{rest.marked.insert(targets[0])}"
      ],
      "publish-every-saved-target": [
        "S{active:s.active.union(marked),..s}",
        "S{active:s.cfg,..s}"
      ]
    }
  },
  "session": [
    "do $system.OBJ.Load(\"/tmp/iter13/Batch.cls\",\"ck\")",
    "do ##class(Iter13.Batch).Run()"
  ],
  "replay_model": "batch.rs",
  "replay": {
    "late-bad": "b(late().ok)",
    "retry": "b(retry().ok)",
    "valid": "b(other().ok)",
    "preview-pkg": "b(preview_bad().state.cfg.contains(3))",
    "preview-rtn": "b(preview_bad().state.cfg.contains(3))",
    "preview-active": "b(preview_bad().state.active.contains(3))",
    "preview-callable": "b(preview_bad().state.active.contains(3))",
    "preview-shell": "b(preview_bad().state.active.contains(3))",
    "preview-exception": "b(!preview_bad().state.active.contains(3))",
    "first-bad-pkg": "b(first_bad().state.cfg.contains(2))",
    "first-bad-rtn": "b(first_bad().state.cfg.contains(2))",
    "first-bad-active": "b(first_bad().state.active.contains(2))",
    "first-bad-callable": "b(first_bad().state.active.contains(2))",
    "first-bad-shell": "b(first_bad().state.active.contains(2))",
    "first-bad-exception": "b(!first_bad().state.active.contains(2))",
    "stranded-pkg": "b(late().state.cfg.contains(1))",
    "stranded-rtn": "b(late().state.cfg.contains(1))",
    "stranded-active": "b(late().state.active.contains(1))",
    "stranded-callable": "b(late().state.active.contains(1))",
    "stranded-shell": "b(late().state.active.contains(1))",
    "stranded-exception": "b(!late().state.active.contains(1))",
    "retry-pkg": "b(retry().state.cfg.contains(1))",
